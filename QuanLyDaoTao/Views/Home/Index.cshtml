@model QuanLyDaoTao.ViewModels.ThongKe.BaoCaoDiagramViewModel
@using QuanLyDaoTao.Models
@{
    ViewData["Title"] = "Bảng điều khiển & Thống kê Biểu đồ";
    Layout = "_Layout";
    var hoatDongGanDay = ViewBag.HoatDongGanDay as List<NhatKyHeThong> ?? new List<NhatKyHeThong>();
}

<div class="container-fluid px-4 py-3" id="pnlDashboard">
    <!-- Thanh Tiêu Đề Không Gian Làm Việc Cá Nhân Hóa (Đã bỏ khối Banner to đầu trang) -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white border rounded-3 px-4 py-3 mb-4 shadow-sm" id="pnlCaNhanHoaWorkspace">
        <div>
            <h4 class="mb-0 fw-bold text-primary" id="lblTieuDeDashboard">
                Bảng Điều Khiển Quản Lý Đào Tạo
            </h4>
        </div>
        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <a asp-controller="CayToChuc" asp-action="Index" class="btn btn-sm btn-outline-primary" id="btnXemCayToChuc">
                <i class="bi bi-diagram-3 me-1"></i>Sơ Đồ Cây Tổ Chức
            </a>
            @if (User.IsInRole(VaiTroMacDinh.SuperAdmin))
            {
                <a asp-controller="QuanTriDuLieu" asp-action="Index" class="btn btn-sm btn-primary" id="btnXemStudio">
                    <i class="bi bi-database-fill-gear me-1"></i>Live CRUD Studio
                </a>
            }
        </div>
    </div>
    <!-- Hàng thống kê tổng số lượng (KPI Metric Cards) -->
    <div class="row g-3 mb-4">
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-bold text-uppercase">Khoa Đào Tạo</span>
                    <i class="bi bi-bank text-primary fs-5"></i>
                </div>
                <h3 class="fw-bold mb-0 text-primary" id="lblTongSoKhoa">@Model.TongSoKhoa</h3>
                <a asp-controller="Khoa" asp-action="Index" class="text-decoration-none small text-muted">Chi tiết &rarr;</a>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-bold text-uppercase">Bộ Môn</span>
                    <i class="bi bi-diagram-2 text-success fs-5"></i>
                </div>
                <h3 class="fw-bold mb-0 text-success" id="lblTongSoBoMon">@Model.TongSoBoMon</h3>
                <a asp-controller="BoMon" asp-action="Index" class="text-decoration-none small text-muted">Chi tiết &rarr;</a>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-kpi-card stat-kpi-gold h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-bold text-uppercase">Lớp Học</span>
                    <i class="bi bi-people text-warning fs-5"></i>
                </div>
                <h3 class="fw-bold mb-0 text-dark" id="lblTongSoLop">@Model.TongSoLop</h3>
                <a asp-controller="LopHoc" asp-action="Index" class="text-decoration-none small text-muted">Chi tiết &rarr;</a>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-kpi-card stat-kpi-red h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-bold text-uppercase">Học Viên</span>
                    <i class="bi bi-person-badge text-danger fs-5"></i>
                </div>
                <h3 class="fw-bold mb-0 text-danger" id="lblTongSoHocVien">@Model.TongSoHocVien</h3>
                <a asp-controller="HocVien" asp-action="Index" class="text-decoration-none small text-muted">Chi tiết &rarr;</a>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-bold text-uppercase">Cán Bộ / GV</span>
                    <i class="bi bi-person-lines-fill text-primary fs-5"></i>
                </div>
                <h3 class="fw-bold mb-0 text-primary" id="lblTongSoNhanSu">@Model.TongSoNhanSu</h3>
                <a asp-controller="NhanSu" asp-action="Index" class="text-decoration-none small text-muted">Chi tiết &rarr;</a>
            </div>
        </div>
        <div class="col-xl-2 col-md-4 col-sm-6">
            <div class="stat-kpi-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="text-muted small fw-bold text-uppercase">Môn Học</span>
                    <i class="bi bi-journal-bookmark text-secondary fs-5"></i>
                </div>
                <h3 class="fw-bold mb-0 text-secondary" id="lblTongSoMonHoc">@Model.TongSoMonHoc</h3>
                <a asp-controller="MonHoc" asp-action="Index" class="text-decoration-none small text-muted">Chi tiết &rarr;</a>
            </div>
        </div>
    </div>

    <!-- ==========================================================================
         PANEL BIỂU ĐỒ THỐNG KÊ TRỰC QUAN (DIAGRAMS PANEL)
         ========================================================================== -->
    <div class="card shadow-sm border-0 mb-4" id="pnlBieuDoThongKe">
        <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="badge badge-cand-gold px-2 py-1"><i class="bi bi-pie-chart-fill me-1"></i>DIAGRAMS</span>
                <h5 class="mb-0 text-primary fw-bold">
                    <i class="bi bi-bar-chart-line-fill me-2"></i>Bảng Biểu Đồ Thống Kê &amp; Phân Tích Dữ Liệu
                </h5>
            </div>
            <span class="text-muted small">Cập nhật trực tiếp theo thời gian thực từ cơ sở dữ liệu</span>
        </div>
        <div class="card-body p-4 bg-light">
            <div class="row g-4">
                <!-- Biểu đồ 1: Phân bố Học viên theo Khoa Đào tạo -->
                <div class="col-lg-6">
                    <div class="diagram-panel-card h-100">
                        <div class="diagram-header">
                            <span class="diagram-header-title">
                                <i class="bi bi-bar-chart-fill text-success"></i>Quy Mô Học Viên &amp; Lớp Theo Khoa
                            </span>
                            <span class="badge bg-success">Cột (Bar)</span>
                        </div>
                        <div class="diagram-canvas-wrapper">
                            <canvas id="chartHocVienTheoKhoa"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Biểu đồ 2: Cơ cấu Trình độ chuyên môn Cán bộ / Giảng viên -->
                <div class="col-lg-6">
                    <div class="diagram-panel-card h-100">
                        <div class="diagram-header">
                            <span class="diagram-header-title">
                                <i class="bi bi-pie-chart-fill text-primary"></i>Cơ Cấu Trình Độ &amp; Học Vị Cán Bộ
                            </span>
                            <span class="badge bg-primary">Tròn (Doughnut)</span>
                        </div>
                        <div class="diagram-canvas-wrapper d-flex align-items-center justify-content-center">
                            <canvas id="chartTrinhDoChuyenMon" style="max-height: 250px;"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Biểu đồ 3: Phân bổ Nhân sự theo Chức vụ công tác -->
                <div class="col-lg-6">
                    <div class="diagram-panel-card h-100">
                        <div class="diagram-header">
                            <span class="diagram-header-title">
                                <i class="bi bi-award-fill text-warning"></i>Phân Bổ Nhân Sự Theo Chức Vụ
                            </span>
                            <span class="badge bg-warning text-dark">Ngang (Bar)</span>
                        </div>
                        <div class="diagram-canvas-wrapper">
                            <canvas id="chartChucVuNhanSu"></canvas>
                        </div>
                    </div>
                </div>

                <!-- Biểu đồ 4: Tỷ lệ Lấp đầy Sĩ số tại các Lớp học -->
                <div class="col-lg-6">
                    <div class="diagram-panel-card h-100">
                        <div class="diagram-header">
                            <span class="diagram-header-title">
                                <i class="bi bi-people-fill text-info"></i>Tỷ Lệ Sĩ Số / Chỉ Tiêu Các Lớp
                            </span>
                            <span class="badge bg-info text-dark">So sánh (Grouped)</span>
                        </div>
                        <div class="diagram-canvas-wrapper">
                            <canvas id="chartSiSoLopHoc"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hàng dưới: Lối tắt thao tác nhanh & Hoạt động kiểm toán gần đây -->
    <div class="row g-4">
        <!-- Bảng hoạt động gần đây (Đã bỏ panel tiện ích nhân sự thừa) -->
        <div class="col-12">
            <div class="card shadow-sm border-0 h-100" id="pnlHoatDongGanDay">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-clock-history me-2"></i>Nhật Ký Kiểm Toán Gần Đây</h5>
                    <a asp-controller="NhatKy" asp-action="Index" class="btn btn-sm btn-outline-primary" id="btnXemTatCaNhatKy">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0" id="dgvHoatDongGanDay">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Thời điểm</th>
                                    <th>Người thực hiện</th>
                                    <th>Hành động</th>
                                    <th>Bảng dữ liệu</th>
                                    <th>Khóa bản ghi</th>
                                    <th>Kết quả</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (hoatDongGanDay.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Chưa có hoạt động nào được ghi nhận</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in hoatDongGanDay)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small">@item.ThoiDiem.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td class="fw-semibold">@item.NguoiThucHien</td>
                                            <td>
                                                <span class="badge bg-primary">@item.HanhDong</span>
                                            </td>
                                            <td><code>@item.BangDuLieu</code></td>
                                            <td><span class="badge bg-light text-dark border">@(item.KhoaBanGhi ?? "-")</span></td>
                                            <td>
                                                @if (item.KetQua == "Thành công")
                                                {
                                                    <span class="badge bg-success">Thành công</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@item.KetQua</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Thư viện Chart.js vẽ biểu đồ thống kê chuyên nghiệp -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.6/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Dữ liệu từ ViewModel
            const dsKhoa = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachKhoa));
            const dsTrinhDo = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachTrinhDo));
            const dsChucVu = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachChucVu));
            const dsLop = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachLop));

            // Bảng màu CAND chuẩn
            const candColors = {
                green: '#047920',
                greenDark: '#025917',
                gold: '#FFD700',
                red: '#D91E18',
                blue: '#0d6efd',
                cyan: '#0dcaf0',
                gray: '#6c757d'
            };

            // 1. Biểu đồ: Học viên & Lớp theo Khoa (Bar Chart)
            const ctxKhoa = document.getElementById('chartHocVienTheoKhoa');
            if (ctxKhoa) {
                new Chart(ctxKhoa, {
                    type: 'bar',
                    data: {
                        labels: dsKhoa.map(k => k.TenKhoa),
                        datasets: [
                            {
                                label: 'Học viên',
                                data: dsKhoa.map(k => k.SoHocVien),
                                backgroundColor: 'rgba(4, 121, 32, 0.85)',
                                borderColor: candColors.green,
                                borderWidth: 1,
                                borderRadius: 5
                            },
                            {
                                label: 'Lớp học',
                                data: dsKhoa.map(k => k.SoLop),
                                backgroundColor: 'rgba(255, 215, 0, 0.85)',
                                borderColor: '#c59b08',
                                borderWidth: 1,
                                borderRadius: 5
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }

            // 2. Biểu đồ: Cơ cấu Trình độ chuyên môn (Doughnut Chart)
            const ctxTrinhDo = document.getElementById('chartTrinhDoChuyenMon');
            if (ctxTrinhDo) {
                new Chart(ctxTrinhDo, {
                    type: 'doughnut',
                    data: {
                        labels: dsTrinhDo.map(t => t.TenTrinhDo),
                        datasets: [{
                            data: dsTrinhDo.map(t => t.SoLuong),
                            backgroundColor: [
                                '#047920',
                                '#0b8a28',
                                '#FFD700',
                                '#0dcaf0',
                                '#D91E18',
                                '#6c757d'
                            ],
                            borderWidth: 2,
                            borderColor: '#ffffff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'right' }
                        }
                    }
                });
            }

            // 3. Biểu đồ: Phân bổ chức vụ (Horizontal Bar Chart)
            const ctxChucVu = document.getElementById('chartChucVuNhanSu');
            if (ctxChucVu) {
                new Chart(ctxChucVu, {
                    type: 'bar',
                    data: {
                        labels: dsChucVu.map(c => c.TenChucVu),
                        datasets: [{
                            axis: 'y',
                            label: 'Số lượng cán bộ',
                            data: dsChucVu.map(c => c.SoLuong),
                            backgroundColor: 'rgba(255, 193, 7, 0.8)',
                            borderColor: '#ffc107',
                            borderWidth: 1,
                            borderRadius: 4
                        }]
                    },
                    options: {
                        indexAxis: 'y',
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            x: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }

            // 4. Biểu đồ: Sĩ số lớp học (Grouped Bar Chart)
            const ctxLop = document.getElementById('chartSiSoLopHoc');
            if (ctxLop) {
                new Chart(ctxLop, {
                    type: 'bar',
                    data: {
                        labels: dsLop.map(l => l.TenLop),
                        datasets: [
                            {
                                label: 'Sĩ số thực tế',
                                data: dsLop.map(l => l.SoHocVien),
                                backgroundColor: 'rgba(13, 202, 240, 0.85)',
                                borderColor: '#0dcaf0',
                                borderWidth: 1,
                                borderRadius: 4
                            },
                            {
                                label: 'Chỉ tiêu tối đa',
                                data: dsLop.map(l => l.SoLuongToiDa),
                                backgroundColor: 'rgba(108, 117, 125, 0.35)',
                                borderColor: '#6c757d',
                                borderWidth: 1,
                                borderRadius: 4
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { position: 'top' }
                        },
                        scales: {
                            y: { beginAtZero: true, ticks: { precision: 0 } }
                        }
                    }
                });
            }
        });
    </script>
}
