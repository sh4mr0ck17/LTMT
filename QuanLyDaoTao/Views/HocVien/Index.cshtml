@model List<QuanLyDaoTao.Models.HocVien>
@using QuanLyDaoTao.Models
@{
    ViewData["Title"] = "Quản lý Học viên";
    Layout = "_Layout";
    bool laQuanTri = User.IsInRole(VaiTroMacDinh.QuanTriVien) || User.IsInRole(VaiTroMacDinh.QuanLyDaoTao);
    var danhSachLop = ViewBag.DanhSachLop as List<LopHoc> ?? new List<LopHoc>();
}

<div class="container-fluid px-4 py-3" id="pnlDanhSachHocVien">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-person-badge me-2"></i>Quản Lý Học Viên Đào Tạo
            </h4>
            <span class="text-muted small">Danh sách học viên theo lớp, thông tin liên hệ và tình trạng theo học</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Excel" asp-action="TaiTepMau" asp-route-module="HocVien" class="btn btn-outline-secondary" id="btnTaiMauExcel">
                <i class="bi bi-download me-1"></i>Tải Mẫu Excel
            </a>
            <a asp-controller="Excel" asp-action="XuatDuLieu" asp-route-module="HocVien" class="btn btn-outline-success" id="btnXuatExcel">
                <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
            </a>
            @if (laQuanTri)
            {
                <a asp-controller="Excel" asp-action="NhapExcel" asp-route-module="HocVien" class="btn btn-success" id="btnNhapExcel">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i>Nhập Excel
                </a>
                <a asp-action="ThemMoi" class="btn btn-primary" id="btnThemHocVien">
                    <i class="bi bi-person-plus-fill me-1"></i>Thêm Mới Học Viên
                </a>
            }
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4" id="pnlBoLoc">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center" id="frmTimKiem">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="tuKhoa" class="form-control" id="txtTimKiem" 
                               placeholder="Tìm mã, họ tên, email, sđt..." value="@ViewBag.TuKhoa" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="lopHocId" class="form-select" id="cboChonLop">
                        <option value="">-- Tất cả Lớp học --</option>
                        @foreach (var l in danhSachLop)
                        {
                            <option value="@l.LopHocId" selected="@(ViewBag.LopHocId == l.LopHocId ? "selected" : null)">@l.TenLop (@l.MaLop)</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="coHoatDong" class="form-select" id="cboLocTrangThai">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true" selected="@(ViewBag.CoHoatDong == true ? "selected" : null)">Đang theo học</option>
                        <option value="false" selected="@(ViewBag.CoHoatDong == false ? "selected" : null)">Đã thôi học / Khóa</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-primary" id="btnTimKiem">
                        <i class="bi bi-funnel me-1"></i>Lọc Dữ Liệu
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" id="btnLamMoi">
                        <i class="bi bi-arrow-clockwise me-1"></i>Làm Mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách Học viên -->
    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="dgvDanhSachHocVien">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th style="width: 130px;">Mã Học Viên</th>
                            <th>Họ và Tên</th>
                            <th>Ngày Sinh</th>
                            <th>Giới Tính</th>
                            <th>Lớp Đào Tạo</th>
                            <th>Khoa Chủ Quản</th>
                            <th>Email</th>
                            <th>Số Điện Thoại</th>
                            <th class="text-center" style="width: 120px;">Trạng Thái</th>
                            <th class="text-center" style="width: 160px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="11" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy học viên nào trong hệ thống
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var hv in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold font-monospace fs-6">@hv.MaHocVien</span>
                                    </td>
                                    <td>
                                        <a asp-action="ChiTiet" asp-route-id="@hv.HocVienId" class="fw-semibold text-decoration-none text-dark">
                                            @hv.HoVaTen
                                        </a>
                                    </td>
                                    <td>@hv.NgaySinh.ToString("dd/MM/yyyy")</td>
                                    <td>@hv.GioiTinh</td>
                                    <td>
                                        <a asp-controller="LopHoc" asp-action="ChiTiet" asp-route-id="@hv.LopHocId" class="badge bg-light text-dark border text-decoration-none">
                                            @(hv.LopHoc?.TenLop ?? "-")
                                        </a>
                                    </td>
                                    <td>@(hv.LopHoc?.Khoa?.TenKhoa ?? "-")</td>
                                    <td>@(hv.Email ?? "-")</td>
                                    <td>@(hv.SoDienThoai ?? "-")</td>
                                    <td class="text-center">
                                        @if (hv.CoHoatDong)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đang học</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-lock me-1"></i>Đã khóa</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="ChiTiet" asp-route-id="@hv.HocVienId" class="btn btn-outline-info" title="Xem chi tiết" id="btnXem_@hv.HocVienId">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (laQuanTri)
                                            {
                                                <a asp-action="ChinhSua" asp-route-id="@hv.HocVienId" class="btn btn-outline-primary" title="Chỉnh sửa" id="btnSua_@hv.HocVienId">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="Xoa" asp-route-id="@hv.HocVienId" method="post" class="d-inline" id="frmXoa_@hv.HocVienId">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Xóa học viên" id="btnXoa_@hv.HocVienId"
                                                            onclick="return confirm('Bạn có chắc chắn muốn xóa học viên \'@hv.HoVaTen\'?');">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
