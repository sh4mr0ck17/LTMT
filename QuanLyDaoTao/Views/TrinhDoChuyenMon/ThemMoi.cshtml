@model QuanLyDaoTao.Models.TrinhDoChuyenMon
@{
    ViewData["Title"] = "Thêm mới Trình độ chuyên môn";
    Layout = "_Layout";
}

<div class="container py-3" id="pnlThemTrinhDo">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-primary fw-bold" id="lblTieuDe">
                        <i class="bi bi-plus-circle me-2"></i>Thêm Mới Trình Độ Chuyên Môn
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ThemMoi" method="post" id="frmThemTrinhDo">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" id="lblThongBaoLoi" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="MaTrinhDo" class="form-label fw-bold">Mã Trình Độ <span class="text-danger">*</span></label>
                            <input asp-for="MaTrinhDo" class="form-control" id="txtMaTrinhDo" placeholder="Ví dụ: TD_TS, TD_ThS, TD_KS..." autofocus />
                            <span asp-validation-for="MaTrinhDo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TenTrinhDo" class="form-label fw-bold">Tên Trình Độ <span class="text-danger">*</span></label>
                            <input asp-for="TenTrinhDo" class="form-control" id="txtTenTrinhDo" placeholder="Tiến sĩ, Thạc sĩ, Kỹ sư..." />
                            <span asp-validation-for="TenTrinhDo" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MoTa" class="form-label fw-bold">Mô Tả Tiêu Chuẩn</label>
                            <textarea asp-for="MoTa" class="form-control" id="txtMoTa" rows="3" placeholder="Nhập mô tả về tiêu chuẩn văn bằng..."></textarea>
                            <span asp-validation-for="MoTa" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 form-check form-switch">
                            <input asp-for="CoHoatDong" class="form-check-input" id="chkCoHoatDong" checked />
                            <label asp-for="CoHoatDong" class="form-check-label fw-semibold">Đang hoạt động</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary" id="btnHuyThaoTac">Hủy Bỏ</a>
                            <button type="submit" class="btn btn-primary" id="btnLuuTrinhDo">Lưu Dữ Liệu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
