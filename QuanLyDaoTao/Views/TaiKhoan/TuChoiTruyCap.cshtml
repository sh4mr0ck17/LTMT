@{
    ViewData["Title"] = "Từ chối truy cập";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5" id="pnlTuChoiTruyCap">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0 border-top border-danger border-4">
            <div class="card-body p-5">
                <div class="text-danger mb-4">
                    <i class="bi bi-shield-x fs-1" style="font-size: 4rem;"></i>
                </div>
                <h2 class="text-danger mb-3" id="lblTieuDe">Truy Cập Bị Từ Chối</h2>
                <p class="text-muted mb-4 lead" id="lblThongBaoLoi">
                    Bạn không có đủ quyền hạn để truy cập vào tài nguyên hoặc thực hiện hành động này trong hệ thống.
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary" id="btnVeTrangChu">
                        <i class="bi bi-house me-2"></i>Về Trang Chủ
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary" id="btnQuayLai">
                        <i class="bi bi-arrow-left me-2"></i>Quay Lại
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
