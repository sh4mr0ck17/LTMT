@model QuanLyDaoTao.ViewModels.TaiKhoan.QuanLyTaiKhoanViewModel
@using QuanLyDaoTao.Models
@{
    ViewData["Title"] = "Tài khoản và phân quyền";
    Layout = "_Layout";
    var laSuperAdmin = User.IsInRole(VaiTroMacDinh.SuperAdmin);
}

<div class="container-fluid px-4 py-3" id="pnlDanhSachTaiKhoan">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <span class="text-uppercase small fw-bold text-muted">Quản trị hệ thống</span>
            <h5 class="mb-1 text-primary fw-bold" id="lblTieuDe"><i class="bi bi-people-fill me-2"></i>Tài khoản và phân quyền</h5>
            <small class="text-muted">4 vai trò: Superadmin · Quản trị viên · Quản lý (theo vùng và khoa) · Người xem. Đổi quyền làm phiên cũ hết hiệu lực trong vòng 1 phút.</small>
        </div>
        <a asp-action="TaoMoi" class="btn btn-primary btn-sm px-3" id="btnThemTaiKhoan">
            <i class="bi bi-person-plus-fill me-1"></i>Tạo tài khoản
        </a>
    </div>

    @if (TempData["ThongBaoThanhCong"] is string thanhCong)
    {
        <div class="alert alert-success py-2" id="lblThongBaoThanhCong">@thanhCong</div>
    }
    @if (TempData["ThongBaoLoi"] is string loi)
    {
        <div class="alert alert-danger py-2" id="lblThongBaoLoi">@loi</div>
    }

    <div class="card shadow-sm border-0 mb-3" id="pnlBoLoc">
        <div class="card-body py-2 px-3">
            <form method="get" asp-action="DanhSach" class="row g-2 align-items-center" id="frmTimKiem">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" name="tuKhoa" class="form-control" id="txtTimKiem"
                               placeholder="Tìm theo email, họ tên, mã nhân sự..." value="@Model.TuKhoa" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="vaiTro" class="form-select form-select-sm" id="cboLocVaiTro">
                        <option value="">-- Tất cả vai trò --</option>
                        @foreach (var vt in VaiTroMacDinh.TatCa)
                        {
                            <option value="@vt" selected="@(Model.LocTheoVaiTro == vt ? "selected" : null)">@VaiTroMacDinh.LayNhan(vt)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary" id="btnTimKiem"><i class="bi bi-funnel me-1"></i>Lọc</button>
                    <a asp-action="DanhSach" class="btn btn-sm btn-outline-secondary" id="btnLamMoi"><i class="bi bi-arrow-clockwise me-1"></i>Bỏ lọc</a>
                </div>
            </form>
        </div>
    </div>

    <p class="small text-muted mb-2" id="lblTongSoTaiKhoan">Kết quả: <strong>@Model.DanhSachTaiKhoan.Count</strong> tài khoản</p>

    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dgvDanhSachTaiKhoan">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 44px;">#</th>
                            <th>Tài khoản</th>
                            <th style="min-width: 420px;">Phân quyền (vai trò · vùng · khoa)</th>
                            <th>Trạng thái</th>
                            <th>Đăng nhập cuối</th>
                            <th class="text-center" style="width: 170px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachTaiKhoan.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy tài khoản phù hợp
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var item in Model.DanhSachTaiKhoan)
                            {
                                var vaiTroHienTai = item.DanhSachVaiTro.FirstOrDefault(VaiTroMacDinh.TatCa.Contains) ?? VaiTroMacDinh.NguoiXem;
                                var khoaSua = vaiTroHienTai == VaiTroMacDinh.SuperAdmin && !laSuperAdmin;
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td>
                                        <div class="fw-semibold">@item.HoVaTen</div>
                                        <div class="small text-primary">@item.Email</div>
                                        @if (!string.IsNullOrEmpty(item.MaNhanSuLienKet))
                                        {
                                            <span class="badge bg-light text-primary border font-monospace">@item.MaNhanSuLienKet</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="CapNhatPhanQuyen" method="post" class="d-flex flex-wrap gap-1 align-items-center frm-phan-quyen" id="frmPhanQuyen_@item.Id">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <select name="vaiTro" class="form-select form-select-sm w-auto cbo-vai-tro" id="cboVaiTro_@item.Id" disabled="@(khoaSua ? "disabled" : null)">
                                                @foreach (var vt in VaiTroMacDinh.TatCa)
                                                {
                                                    if (vt == VaiTroMacDinh.SuperAdmin && !laSuperAdmin && vaiTroHienTai != vt)
                                                    {
                                                        continue;
                                                    }
                                                    <option value="@vt" selected="@(vt == vaiTroHienTai ? "selected" : null)">@VaiTroMacDinh.LayNhan(vt)</option>
                                                }
                                            </select>
                                            <select name="vungQuanLy" class="form-select form-select-sm w-auto cbo-vung" id="cboVung_@item.Id" disabled="@(khoaSua ? "disabled" : null)">
                                                <option value="">-- Vùng --</option>
                                                <option value="@VungQuanLy.ToChuc" selected="@(item.VungQuanLy == VungQuanLy.ToChuc ? "selected" : null)">Tổ chức - Cán bộ</option>
                                                <option value="@VungQuanLy.DaoTao" selected="@(item.VungQuanLy == VungQuanLy.DaoTao ? "selected" : null)">Đào tạo</option>
                                            </select>
                                            <select name="khoaPhuTrachId" class="form-select form-select-sm w-auto cbo-khoa" id="cboKhoa_@item.Id" disabled="@(khoaSua ? "disabled" : null)">
                                                <option value="">Mọi khoa</option>
                                                @foreach (var khoa in Model.DanhSachKhoa)
                                                {
                                                    <option value="@khoa.KhoaId" selected="@(item.KhoaPhuTrachId == khoa.KhoaId ? "selected" : null)">@khoa.TenKhoa</option>
                                                }
                                            </select>
                                            @if (!khoaSua)
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-primary" id="btnLuuPhanQuyen_@item.Id" title="Lưu phân quyền">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            }
                                        </form>
                                    </td>
                                    <td>
                                        @if (!item.CoHoatDong)
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-lock me-1"></i>Đã khóa</span>
                                        }
                                        else if (item.DangBiKhoaTam)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Khóa tạm (sai MK)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                        }
                                    </td>
                                    <td class="text-muted small">
                                        @(item.LanDangNhapCuoi.HasValue ? item.LanDangNhapCuoi.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm") : "Chưa đăng nhập")
                                    </td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            @if (item.DangBiKhoaTam)
                                            {
                                                <form asp-action="MoKhoaTam" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@item.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Mở khóa tạm" id="btnMoKhoaTam_@item.Id"><i class="bi bi-unlock"></i></button>
                                                </form>
                                            }
                                            <form asp-action="KhoaMoKhoa" method="post" class="d-inline" id="frmKhoa_@item.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                @if (item.CoHoatDong)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Khóa tài khoản" id="btnKhoa_@item.Id"
                                                            onclick="return confirm('Khóa tài khoản @item.Email? Phiên đang mở sẽ hết hiệu lực.');">
                                                        <i class="bi bi-lock"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa tài khoản" id="btnMoKhoa_@item.Id">
                                                        <i class="bi bi-unlock"></i>
                                                    </button>
                                                }
                                            </form>
                                            <form asp-action="XoaTaiKhoan" method="post" class="d-inline" id="frmXoa_@item.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa tài khoản" id="btnXoaTaiKhoan_@item.Id"
                                                        onclick="return confirm('Xóa vĩnh viễn tài khoản @item.Email?');">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    // Ẩn chọn vùng/khoa khi vai trò không phải Quản lý để tránh nhập dư thừa.
    document.querySelectorAll('.frm-phan-quyen').forEach(function (frm) {
        var cboVaiTro = frm.querySelector('.cbo-vai-tro');
        var capNhat = function () {
            var laQuanLy = cboVaiTro.value === '@VaiTroMacDinh.QuanLy';
            frm.querySelector('.cbo-vung').classList.toggle('d-none', !laQuanLy);
            frm.querySelector('.cbo-khoa').classList.toggle('d-none', !laQuanLy);
        };
        cboVaiTro.addEventListener('change', capNhat);
        capNhat();
    });
</script>
