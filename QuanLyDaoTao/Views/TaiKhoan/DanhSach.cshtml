@model QuanLyDaoTao.ViewModels.TaiKhoan.QuanLyTaiKhoanViewModel
@using QuanLyDaoTao.Models
@{
    ViewData["Title"] = "Quản lý tài khoản hệ thống";
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-3" id="pnlDanhSachTaiKhoan">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h5 class="mb-1 text-primary fw-bold" id="lblTieuDe"><i class="bi bi-people-fill me-2"></i>Quản Lý Tài Khoản &amp; Phân Quyền Workspace</h5>
            <small class="text-muted">Quản trị danh sách tài khoản Giáo viên, Cán bộ, User, khóa/mở khóa và xóa vĩnh viễn tài khoản</small>
        </div>
        <div>
            <a asp-action="TaoMoi" class="btn btn-primary btn-sm px-3" id="btnThemTaiKhoan">
                <i class="bi bi-person-plus-fill me-1"></i>+ Tạo TK Giáo Viên / Cán Bộ
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3" id="pnlBoLoc">
        <div class="card-body py-2 px-3">
            <form method="get" asp-action="DanhSach" class="row g-2 align-items-center" id="frmTimKiem">
                <div class="col-md-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-primary"></i></span>
                        <input type="text" name="tuKhoa" class="form-control" id="txtTimKiem" 
                               placeholder="Tìm theo email, họ tên, mã nhân sự..." value="@Model.TuKhoa" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="vaiTro" class="form-select form-select-sm" id="cboLocVaiTro">
                        <option value="">-- Tất cả vai trò Workspace --</option>
                        <option value="@VaiTroMacDinh.SuperAdmin" selected="@(Model.LocTheoVaiTro == VaiTroMacDinh.SuperAdmin ? "selected" : null)">Superadmin (Live CRUD Studio)</option>
                        <option value="@VaiTroMacDinh.QuanTriVien" selected="@(Model.LocTheoVaiTro == VaiTroMacDinh.QuanTriVien ? "selected" : null)">Quản trị viên (Admin)</option>
                        <option value="@VaiTroMacDinh.GiaoVien" selected="@(Model.LocTheoVaiTro == VaiTroMacDinh.GiaoVien ? "selected" : null)">Giáo viên / Giảng viên (GiaoVien)</option>
                        <option value="@VaiTroMacDinh.CanBo" selected="@(Model.LocTheoVaiTro == VaiTroMacDinh.CanBo ? "selected" : null)">Cán bộ Khoa / Phòng (CanBo)</option>
                        <option value="@VaiTroMacDinh.NguoiDung" selected="@(Model.LocTheoVaiTro == VaiTroMacDinh.NguoiDung ? "selected" : null)">Người dùng thường (User - Chỉ xem)</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary" id="btnTimKiem">
                        <i class="bi bi-funnel me-1"></i>Lọc Dữ Liệu
                    </button>
                    <a asp-action="DanhSach" class="btn btn-sm btn-outline-secondary" id="btnLamMoi">
                        <i class="bi bi-arrow-clockwise me-1"></i>Làm Mới
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="dgvDanhSachTaiKhoan">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th>Email Đăng Nhập</th>
                            <th>Họ và Tên</th>
                            <th>Mã Nhân Sự</th>
                            <th>Vai Trò Workspace</th>
                            <th>Trạng Thái</th>
                            <th>Ngày Tạo</th>
                            <th class="text-center" style="width: 210px;">Thao Tác Quản Trị</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DanhSachTaiKhoan.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy tài khoản nào phù hợp
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var item in Model.DanhSachTaiKhoan)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td>
                                        <span class="fw-semibold text-primary">@item.Email</span>
                                    </td>
                                    <td class="fw-medium">@item.HoVaTen</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(item.MaNhanSuLienKet))
                                        {
                                            <span class="badge bg-light text-primary border font-monospace">@item.MaNhanSuLienKet</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">-</span>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var role in item.DanhSachVaiTro)
                                        {
                                            var badgeClass = role switch
                                            {
                                                VaiTroMacDinh.SuperAdmin => "bg-dark",
                                                VaiTroMacDinh.QuanTriVien => "bg-primary",
                                                VaiTroMacDinh.GiaoVien => "bg-success",
                                                VaiTroMacDinh.CanBo => "bg-info text-dark",
                                                _ => "bg-secondary"
                                            };
                                            <span class="badge @badgeClass me-1">@role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.CoHoatDong)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-lock me-1"></i>Đã khóa</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="text-center">
                                        <div class="d-inline-flex gap-1">
                                            <form asp-action="KhoaMoKhoa" method="post" class="d-inline" id="frmKhoa_@item.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                @if (item.CoHoatDong)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="Khóa tài khoản" id="btnKhoa_@item.Id"
                                                            onclick="return confirm('Bạn có chắc chắn muốn khóa tài khoản @item.Email?');">
                                                        <i class="bi bi-lock"></i> Khóa
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-success" title="Mở khóa tài khoản" id="btnMoKhoa_@item.Id">
                                                        <i class="bi bi-unlock"></i> Mở
                                                    </button>
                                                }
                                            </form>

                                            <form asp-action="XoaTaiKhoan" method="post" class="d-inline" id="frmXoa_@item.Id">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa vĩnh viễn tài khoản" id="btnXoaTaiKhoan_@item.Id"
                                                        onclick="return confirm('CẢNH BÁO: Bạn có chắc chắn muốn XÓA VĨNH VIỄN tài khoản @item.Email khỏi hệ thống?');">
                                                    <i class="bi bi-trash"></i> Xóa
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
