@using QuanLyDaoTao.Models
@using QuanLyDaoTao.Services
@{
    var tenController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var tenAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    string? bangUngDung = tenController.ToLowerInvariant() switch
    {
        "khoa" => "Khoa",
        "bomon" => "BoMon",
        "lophoc" => "LopHoc",
        "hocvien" => "HocVien",
        "nhansu" => "NhanSu",
        "monhoc" => "MonHoc",
        "phanconggiangday" => "PhanCongGiangDay",
        "chucvu" => "ChucVu",
        "trinhdochuyenmon" => "TrinhDoChuyenMon",
        "taikhoan" when tenAction.Equals("DanhSach", StringComparison.OrdinalIgnoreCase) => "TaiKhoan",
        "nhatky" => "NhatKyHeThong",
        "caytochuc" => "Khoa",
        _ => null
    };
}

@if (User.IsInRole(VaiTroMacDinh.QuanTriVien) && !string.IsNullOrEmpty(bangUngDung) && !tenController.Equals("QuanTriDuLieu", StringComparison.OrdinalIgnoreCase))
{
    <div class="container-fluid px-4 mt-2 mb-1" id="pnlAdminLiveCrudWidget">
        <div class="card border-0 shadow-sm" style="border-left: 5px solid #FFD700 !important; background: linear-gradient(90deg, #013E10 0%, #047920 100%);">
            <div class="card-body py-2 px-3 d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-2 text-white">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge badge-cand-gold"><i class="bi bi-sliders me-1"></i>ADMIN MANUAL CRUD (+/- &amp; UNDO/REDO)</span>
                    <span class="fw-bold small">
                        Tùy biến &amp; Sửa trực tiếp DB nhóm <u style="color: #FFD700;">@bangUngDung</u> (Thêm/Bớt [+]/[-], Delete, Undo/Redo trực tiếp lên DB)
                    </span>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (tenController.Equals("CayToChuc", StringComparison.OrdinalIgnoreCase))
                    {
                        <select id="cboChonBangLiveWidget" class="form-select form-select-sm fw-bold" style="width: auto; background-color: #fff; color: #013E10;" onchange="doiBangLiveWidget(this.value)">
                            <option value="Khoa">Nhóm: Khoa Đào Tạo</option>
                            <option value="BoMon">Nhóm: Bộ Môn</option>
                            <option value="LopHoc">Nhóm: Lớp Học</option>
                            <option value="HocVien">Nhóm: Học Viên</option>
                            <option value="NhanSu">Nhóm: Nhân Sự</option>
                            <option value="MonHoc">Nhóm: Môn Học</option>
                            <option value="PhanCongGiangDay">Nhóm: Phân Công</option>
                        </select>
                    }
                    <button type="button" class="btn btn-sm fw-bold" style="background-color: #FFD700; color: #013E10;"
                            id="btnBatBangSuaNhanhTaiCho" onclick="batTatKhungLiveCrudTaiCho()">
                        <i class="bi bi-pencil-square me-1"></i>Bật Bảng Sửa Trực Tiếp [+]/[-] &amp; Delete Tại Đây
                    </button>
                    <a asp-controller="QuanTriDuLieu" asp-action="Index" asp-route-bang="@bangUngDung"
                       class="btn btn-sm btn-outline-light fw-semibold" id="btnMoStudioToanManHinh">
                        <i class="bi bi-arrows-fullscreen me-1"></i>Mở DB Studio Toàn Màn Hình
                    </a>
                </div>
            </div>

            <!-- Khung Sửa Trực Tiếp Nhúng Ngay Tại Trang -->
            <div id="pnlKhungLiveCrudNoiBo" class="card-footer bg-white text-dark p-3 d-none border-top">
                <form id="frmTokenLiveWidget" class="d-none">@Html.AntiForgeryToken()</form>

                <div class="d-flex flex-wrap justify-content-between align-items-center mb-2 gap-2">
                    <div class="d-flex align-items-center gap-2">
                        <h6 class="mb-0 fw-bold text-primary" id="lblTieuDeKhungLive">
                            <i class="bi bi-table me-1"></i>Bảng Sửa Trực Tiếp DB (<span id="lblTenBangLive">@bangUngDung</span>)
                        </h6>
                        <span id="lblThongBaoLiveWidget" class="badge bg-success">Sẵn sàng đồng bộ DB</span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-dark fw-bold" id="btnWidgetUndo" onclick="thucHienWidgetUndo()" disabled title="Hoàn tác (Undo)">
                                <i class="bi bi-arrow-counterclockwise"></i> Undo (<span id="lblWidgetUndoCount">0</span>)
                            </button>
                            <button type="button" class="btn btn-outline-dark fw-bold" id="btnWidgetRedo" onclick="thucHienWidgetRedo()" disabled title="Làm lại (Redo)">
                                <i class="bi bi-arrow-clockwise"></i> Redo (<span id="lblWidgetRedoCount">0</span>)
                            </button>
                        </div>

                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-warning fw-bold text-dark" id="btnThemCotTuyChinhNhanh" onclick="batTatFormThemCotNhanh()">
                                <i class="bi bi-plus-lg"></i> Cột Mới
                            </button>
                            <button type="button" class="btn btn-danger fw-bold" id="btnWidgetXoaCuoi" onclick="xoaDongCuoiWidget()" title="Bớt / Xóa dòng cuối cùng [-]">
                                <i class="bi bi-dash-lg"></i> Xóa / Bớt Dòng [-]
                            </button>
                        </div>

                        <button type="button" class="btn btn-sm btn-success fw-bold" id="btnLuuTatCaLiveWidget" onclick="luuTatCaLiveWidget()">
                            <i class="bi bi-floppy-fill me-1"></i>Lưu Tất Cả &amp; Đồng Bộ Trang
                        </button>
                    </div>
                </div>

                <!-- Khung nhỏ thêm nhanh Trường (Cột) tùy chỉnh mới -->
                <div id="pnlFormThemCotNhanh" class="bg-light p-2 rounded border mb-2 d-none">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1">Mã trường (không dấu) *</label>
                            <input type="text" id="txtWidgetMaTruong" class="form-control form-control-sm" placeholder="VD: GhiChuNoiBo" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold mb-1">Tên hiển thị cột *</label>
                            <input type="text" id="txtWidgetTenTruong" class="form-control form-control-sm" placeholder="VD: Ghi Chú Nội Bộ" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">Kiểu dữ liệu</label>
                            <select id="cboWidgetKieuTruong" class="form-select form-select-sm">
                                <option value="VanBan">Văn bản</option>
                                <option value="SoNguyen">Số nguyên</option>
                                <option value="NgayThang">Ngày tháng</option>
                                <option value="Logic">Có / Không</option>
                                <option value="DanhSach">Danh sách chọn</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small fw-bold mb-1">Giá trị mặc định / DS</label>
                            <input type="text" id="txtWidgetMacDinh" class="form-control form-control-sm" placeholder="Tùy chọn..." />
                        </div>
                        <div class="col-md-2">
                            <button type="button" class="btn btn-sm btn-primary w-100 fw-bold" id="btnXacNhanThemCotWidget" onclick="luuCotTuyChinhMoiWidget()">
                                <i class="bi bi-check2-circle me-1"></i>[+] Tạo Cột
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Vùng chứa bảng Live Editable -->
                <div class="table-responsive" style="max-height: 440px;" id="pnlBangLiveWidgetContainer">
                    <div class="text-center py-3 text-muted small">Đang tải cấu trúc trường dữ liệu...</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        let bangLiveWidgetHienTai = '@bangUngDung';
        let duLieuBangLiveCache = null;
        let widgetUndoStack = [];
        let widgetRedoStack = [];

        function capNhatWidgetUndoRedoUi() {
            const u = document.getElementById('btnWidgetUndo');
            const r = document.getElementById('btnWidgetRedo');
            document.getElementById('lblWidgetUndoCount').innerText = widgetUndoStack.length;
            document.getElementById('lblWidgetRedoCount').innerText = widgetRedoStack.length;
            if (u) u.disabled = widgetUndoStack.length === 0;
            if (r) r.disabled = widgetRedoStack.length === 0;
        }

        function layTokenWidget() {
            const inp = document.querySelector('#frmTokenLiveWidget input[name="__RequestVerificationToken"]');
            return inp ? inp.value : '';
        }

        function doiBangLiveWidget(tenBangMoi) {
            bangLiveWidgetHienTai = tenBangMoi;
            document.getElementById('lblTenBangLive').innerText = tenBangMoi;
            const pnl = document.getElementById('pnlKhungLiveCrudNoiBo');
            if (!pnl.classList.contains('d-none')) {
                taiBangLiveCrudTaiCho();
            }
        }

        function batTatKhungLiveCrudTaiCho() {
            const pnl = document.getElementById('pnlKhungLiveCrudNoiBo');
            pnl.classList.toggle('d-none');
            if (!pnl.classList.contains('d-none')) {
                taiBangLiveCrudTaiCho();
            }
        }

        function batTatFormThemCotNhanh() {
            document.getElementById('pnlFormThemCotNhanh').classList.toggle('d-none');
        }

        async function taiBangLiveCrudTaiCho() {
            const container = document.getElementById('pnlBangLiveWidgetContainer');
            container.innerHTML = '<div class="text-center py-3 text-muted"><div class="spinner-border spinner-border-sm text-primary me-2"></div>Đang kết nối dữ liệu trực tiếp...</div>';

            const res = await fetch(`/QuanTriDuLieu/LayDuLieuBangJson?bang=${encodeURIComponent(bangLiveWidgetHienTai)}`);
            if (!res.ok) {
                container.innerHTML = '<div class="alert alert-danger m-2">Không thể tải dữ liệu bảng.</div>';
                return;
            }

            const data = await res.json();
            duLieuBangLiveCache = data;
            renderBangLiveWidget(data);
        }

        function renderControlInput(cot, val, pk, isNewRow) {
            const cls = isNewRow ? 'widget-new-input' : 'widget-edit-input';
            const attrPk = isNewRow ? '' : `data-pk="${pk}"`;
            const safeVal = (val ?? '').toString().replace(/"/g, '&quot;');

            if (cot.laKhoaChinh) {
                return isNewRow
                    ? '<span class="badge bg-success">+ Mới</span>'
                    : `<span class="badge bg-light text-dark border font-monospace">${safeVal}</span>`;
            }

            if (cot.kieuDuLieu === 'Logic') {
                const checked = safeVal.toLowerCase() === 'true' || safeVal === '1' || (isNewRow && safeVal === '') ? 'checked' : '';
                return `<div class="form-check form-switch d-flex justify-content-center"><input type="checkbox" class="form-check-input ${cls}" ${attrPk} data-field="${cot.maCot}" ${checked} /></div>`;
            }

            if (cot.kieuDuLieu === 'KhoaNgoai' || cot.kieuDuLieu === 'DanhSach') {
                let opts = '<option value="">-- Chọn --</option>';
                (cot.danhSachLuaChon || []).forEach(o => {
                    const sel = o.giaTri === safeVal ? 'selected' : '';
                    opts += `<option value="${o.giaTri}" ${sel}>${o.nhanHienThi}</option>`;
                });
                return `<select class="form-select form-select-sm ${cls}" ${attrPk} data-field="${cot.maCot}">${opts}</select>`;
            }

            const type = cot.kieuDuLieu === 'NgayThang' ? 'date' : (cot.kieuDuLieu === 'SoNguyen' ? 'number' : 'text');
            return `<input type="${type}" class="form-control form-control-sm ${cls}" ${attrPk} data-field="${cot.maCot}" value="${safeVal}" />`;
        }

        function renderBangLiveWidget(data) {
            const cots = data.danhSachCot || [];
            const dongs = data.danhSachDong || [];
            const pkName = data.tenKhoaChinh;

            let html = '<table class="table table-sm table-bordered table-hover align-middle mb-0" id="dgvLiveWidgetTable">';
            html += '<thead class="table-light sticky-top"><tr><th class="text-center" style="width:140px;">Thao Tác [+]/[-]</th>';

            cots.forEach(c => {
                const btnXoaCot = c.laTruongTuyChinh
                    ? `<button type="button" class="btn btn-outline-danger btn-sm py-0 px-1 ms-1 fw-bold" onclick="xoaCotTuyChinhWidget(${c.truongTuyChinhId})" title="Xóa cột tùy chỉnh này [-]">&minus;</button>`
                    : '';
                html += `<th style="min-width:${c.laKhoaChinh ? '65px' : '145px'};"><div class="d-flex justify-content-between align-items-center"><span>${c.tenHienThi}${c.laBatBuoc && !c.laKhoaChinh ? ' <span class="text-danger">*</span>' : ''}</span>${btnXoaCot}</div></th>`;
            });
            html += '</tr>';

            // Dòng thêm mới luôn hiển thị sẵn ở đầu bảng
            html += '<tr id="rowWidgetThemMoi" class="table-warning">';
            html += '<td class="text-center"><button type="button" class="btn btn-success btn-sm fw-bold px-2" onclick="thucHienThemMoiWidget()" title="Thêm dòng mới vào DB [+]"><i class="bi bi-plus-lg"></i> Thêm [+]</button></td>';
            cots.forEach(c => {
                html += `<td>${renderControlInput(c, '', '', true)}</td>`;
            });
            html += '</tr></thead><tbody>';

            if (dongs.length === 0) {
                html += `<tr><td colspan="${cots.length + 1}" class="text-center py-3 text-muted">Điền vào dòng màu vàng phía trên rồi bấm <strong>"Thêm [+]"</strong> để tạo bản ghi!</td></tr>`;
            } else {
                dongs.forEach(d => {
                    const pk = d[pkName] || '';
                    html += `<tr id="wrow_${pk}" data-pk="${pk}">`;
                    html += `<td class="text-center"><div class="btn-group btn-group-sm">
                        <button type="button" class="btn btn-outline-success px-2" onclick="luuDongWidget('${pk}')" title="Lưu dòng này"><i class="bi bi-floppy-fill"></i></button>
                        <button type="button" class="btn btn-danger px-2 fw-bold" onclick="xoaDongWidget('${pk}')" title="Xóa / Bớt dòng này [-] (Delete)">&minus; / <i class="bi bi-trash-fill"></i></button>
                    </div></td>`;
                    cots.forEach(c => {
                        html += `<td>${renderControlInput(c, d[c.maCot], pk, false)}</td>`;
                    });
                    html += '</tr>';
                });
            }

            html += '</tbody></table>';
            document.getElementById('pnlBangLiveWidgetContainer').innerHTML = html;
        }

        function layDuLieuMotDongWidget(pk) {
            const inputs = document.querySelectorAll(`.widget-edit-input[data-pk="${pk}"]`);
            const duLieu = {};
            inputs.forEach(inp => {
                const f = inp.getAttribute('data-field');
                duLieu[f] = inp.type === 'checkbox' ? (inp.checked ? 'true' : 'false') : inp.value;
            });
            return duLieu;
        }

        async function luuDongWidget(pk) {
            const duLieu = layDuLieuMotDongWidget(pk);
            const badge = document.getElementById('lblThongBaoLiveWidget');
            badge.className = 'badge bg-warning text-dark';
            badge.innerText = `Đang lưu #${pk}...`;

            const res = await fetch('/QuanTriDuLieu/CapNhatNhanh', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': layTokenWidget()
                },
                body: JSON.stringify({
                    tenBang: bangLiveWidgetHienTai,
                    khoaBanGhi: pk,
                    duLieu: duLieu
                })
            });

            const kq = await res.json();
            if (res.ok && kq.thanhCong) {
                badge.className = 'badge bg-success';
                badge.innerText = kq.thongDiep;
            } else {
                badge.className = 'badge bg-danger';
                badge.innerText = kq.thongDiep || 'Lỗi lưu DB!';
                alert(kq.thongDiep || 'Lỗi lưu DB!');
            }
        }

        async function luuTatCaLiveWidget() {
            if (!duLieuBangLiveCache || !duLieuBangLiveCache.danhSachDong) return;
            const pkName = duLieuBangLiveCache.tenKhoaChinh;
            const ds = [];
            duLieuBangLiveCache.danhSachDong.forEach(d => {
                const pk = d[pkName];
                if (pk && document.getElementById('wrow_' + pk)) {
                    ds.push({
                        tenBang: bangLiveWidgetHienTai,
                        khoaBanGhi: pk,
                        duLieu: layDuLieuMotDongWidget(pk)
                    });
                }
            });

            const res = await fetch('/QuanTriDuLieu/CapNhatHangLoat', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': layTokenWidget()
                },
                body: JSON.stringify({
                    tenBang: bangLiveWidgetHienTai,
                    danhSachCapNhat: ds
                })
            });

            const kq = await res.json();
            if (res.ok && kq.thanhCong) {
                window.location.reload();
            } else {
                alert(kq.thongDiep || 'Lỗi khi lưu hàng loạt!');
            }
        }

        async function thucHienThemMoiWidget() {
            const inputs = document.querySelectorAll('.widget-new-input');
            const duLieu = {};
            inputs.forEach(inp => {
                const f = inp.getAttribute('data-field');
                duLieu[f] = inp.type === 'checkbox' ? (inp.checked ? 'true' : 'false') : inp.value;
            });

            const res = await fetch('/QuanTriDuLieu/ThemNhanh', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': layTokenWidget()
                },
                body: JSON.stringify({
                    tenBang: bangLiveWidgetHienTai,
                    duLieu: duLieu
                })
            });

            const kq = await res.json();
            if (res.ok && kq.thanhCong) {
                widgetUndoStack.push({ loai: 'ADD', pk: kq.khoaBanGhi, duLieu: duLieu });
                widgetRedoStack = [];
                capNhatWidgetUndoRedoUi();
                taiBangLiveCrudTaiCho();
            } else {
                alert(kq.thongDiep || 'Lỗi thêm mới bản ghi!');
            }
        }

        async function xoaDongWidget(pk) {
            if (!confirm(`Xác nhận xóa (Delete) bản ghi #${pk} khỏi cơ sở dữ liệu?`)) return;

            const duLieuCu = layDuLieuMotDongWidget(pk);
            const res = await fetch('/QuanTriDuLieu/XoaNhanh', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': layTokenWidget()
                },
                body: JSON.stringify({
                    tenBang: bangLiveWidgetHienTai,
                    khoaBanGhi: pk
                })
            });

            const kq = await res.json();
            if (res.ok && kq.thanhCong) {
                widgetUndoStack.push({ loai: 'DELETE', pk: pk, duLieu: duLieuCu });
                widgetRedoStack = [];
                capNhatWidgetUndoRedoUi();
                taiBangLiveCrudTaiCho();
            } else {
                alert(kq.thongDiep || 'Không thể xóa bản ghi!');
            }
        }

        async function xoaDongCuoiWidget() {
            const rows = document.querySelectorAll('#dgvLiveWidgetTable tbody tr[data-pk]');
            if (rows.length === 0) {
                alert('Không có dòng nào để xóa!');
                return;
            }
            const lastPk = rows[rows.length - 1].getAttribute('data-pk');
            await xoaDongWidget(lastPk);
        }

        async function thucHienWidgetUndo() {
            if (widgetUndoStack.length === 0) return;
            const act = widgetUndoStack.pop();
            widgetRedoStack.push(act);
            capNhatWidgetUndoRedoUi();

            if (act.loai === 'DELETE') {
                const res = await fetch('/QuanTriDuLieu/ThemNhanh', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': layTokenWidget() },
                    body: JSON.stringify({ tenBang: bangLiveWidgetHienTai, duLieu: act.duLieu })
                });
                const kq = await res.json();
                if (res.ok && kq.thanhCong) {
                    act.pk = kq.khoaBanGhi;
                    taiBangLiveCrudTaiCho();
                }
            } else if (act.loai === 'ADD') {
                await fetch('/QuanTriDuLieu/XoaNhanh', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': layTokenWidget() },
                    body: JSON.stringify({ tenBang: bangLiveWidgetHienTai, khoaBanGhi: act.pk })
                });
                taiBangLiveCrudTaiCho();
            }
        }

        async function thucHienWidgetRedo() {
            if (widgetRedoStack.length === 0) return;
            const act = widgetRedoStack.pop();
            widgetUndoStack.push(act);
            capNhatWidgetUndoRedoUi();

            if (act.loai === 'DELETE') {
                await fetch('/QuanTriDuLieu/XoaNhanh', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': layTokenWidget() },
                    body: JSON.stringify({ tenBang: bangLiveWidgetHienTai, khoaBanGhi: act.pk })
                });
                taiBangLiveCrudTaiCho();
            } else if (act.loai === 'ADD') {
                const res = await fetch('/QuanTriDuLieu/ThemNhanh', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': layTokenWidget() },
                    body: JSON.stringify({ tenBang: bangLiveWidgetHienTai, duLieu: act.duLieu })
                });
                const kq = await res.json();
                if (res.ok && kq.thanhCong) {
                    act.pk = kq.khoaBanGhi;
                    taiBangLiveCrudTaiCho();
                }
            }
        }

        async function luuCotTuyChinhMoiWidget() {
            const ma = document.getElementById('txtWidgetMaTruong').value.trim();
            const ten = document.getElementById('txtWidgetTenTruong').value.trim();
            const kieu = document.getElementById('cboWidgetKieuTruong').value;
            const macDinh = document.getElementById('txtWidgetMacDinh').value.trim();

            if (!ma || !ten) {
                alert('Vui lòng nhập Mã trường và Tên hiển thị!');
                return;
            }

            const res = await fetch('/QuanTriDuLieu/ThemTruongTuyChinh', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': layTokenWidget()
                },
                body: JSON.stringify({
                    tenBang: bangLiveWidgetHienTai,
                    maTruong: ma,
                    tenHienThi: ten,
                    kieuDuLieu: kieu,
                    tuyChonDanhSach: kieu === 'DanhSach' ? macDinh : null,
                    giaTriMacDinh: kieu !== 'DanhSach' ? macDinh : null,
                    coHoatDong: true
                })
            });

            const kq = await res.json();
            if (res.ok && kq.thanhCong) {
                taiBangLiveCrudTaiCho();
                hienThiCotTuyChinhTrenBangChinh();
            } else {
                alert(kq.thongDiep || 'Lỗi khi thêm trường!');
            }
        }

        async function xoaCotTuyChinhWidget(id) {
            if (!confirm('Xóa cột tùy chỉnh này khỏi bảng?')) return;
            const res = await fetch('/QuanTriDuLieu/XoaTruongTuyChinh', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': layTokenWidget()
                },
                body: JSON.stringify(id)
            });
            if (res.ok) {
                taiBangLiveCrudTaiCho();
                window.location.reload();
            }
        }

        async function hienThiCotTuyChinhTrenBangChinh() {
            const mainTable = document.querySelector('table[id^="dgvDanhSach"]');
            if (!mainTable) return;

            const res = await fetch(`/QuanTriDuLieu/LayDuLieuBangJson?bang=${encodeURIComponent(bangLiveWidgetHienTai)}`);
            if (!res.ok) return;
            const data = await res.json();
            const customCols = (data.danhSachCot || []).filter(c => c.laTruongTuyChinh);
            if (customCols.length === 0) return;

            const pkName = data.tenKhoaChinh;
            const mapRowByPk = {};
            (data.danhSachDong || []).forEach(d => {
                mapRowByPk[d[pkName]] = d;
            });

            const headerRow = mainTable.querySelector('thead tr');
            if (!headerRow || headerRow.querySelector('.th-custom-col')) return;
            const lastTh = headerRow.lastElementChild;

            customCols.forEach(c => {
                const th = document.createElement('th');
                th.className = 'th-custom-col text-primary';
                th.innerHTML = `<i class="bi bi-stars me-1 text-warning"></i>${c.tenHienThi}`;
                headerRow.insertBefore(th, lastTh);
            });

            const bodyRows = mainTable.querySelectorAll('tbody tr');
            bodyRows.forEach((tr, idx) => {
                if (tr.children.length <= 2) return;
                let pk = null;
                const btnAny = tr.querySelector('[id^="btnSua_"], [id^="btnXem_"], [id^="btnXoa_"], [id^="btnKhoa_"], [id^="btnMoKhoa_"]');
                if (btnAny && btnAny.id.includes('_')) {
                    pk = btnAny.id.split('_')[1];
                } else if (data.danhSachDong && data.danhSachDong[idx]) {
                    pk = data.danhSachDong[idx][pkName];
                }

                const rowData = pk ? mapRowByPk[pk] : null;
                const lastTd = tr.lastElementChild;

                customCols.forEach(c => {
                    const td = document.createElement('td');
                    const val = rowData ? (rowData[c.maCot] ?? '-') : '-';
                    td.innerHTML = `<span class="badge bg-light text-dark border">${val || '-'}</span>`;
                    tr.insertBefore(td, lastTd);
                });
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            hienThiCotTuyChinhTrenBangChinh();
        });
    </script>
}
