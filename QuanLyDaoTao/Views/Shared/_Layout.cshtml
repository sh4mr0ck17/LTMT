@using Microsoft.AspNetCore.Identity
@using QuanLyDaoTao.Models
@inject SignInManager<TaiKhoan> SignInManager
@inject UserManager<TaiKhoan> UserManager

@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    bool isDaoTaoGroup = currentCtrl == "LopHoc" || currentCtrl == "HocVien" || currentCtrl == "MonHoc" || currentCtrl == "PhanCongGiangDay";
    bool isToChucGroup = currentCtrl == "Khoa" || currentCtrl == "BoMon";
    bool isNhanSuGroup = currentCtrl == "NhanSu" || currentCtrl == "ChucVu" || currentCtrl == "TrinhDoChuyenMon";
    bool isHeThongGroup = currentCtrl == "TaiKhoan" || currentCtrl == "NhatKy" || currentCtrl == "QuanTriDuLieu";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học Viện An Ninh Nhân Dân (C500)</title>
    <link rel="icon" type="image/png" href="~/images/logo_badge.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">
        <!-- Backdrop cho mobile khi mở sidebar -->
        <div class="app-sidebar-backdrop" id="appSidebarBackdrop" onclick="toggleSidebarMobile()"></div>

        <!-- ==========================================================================
             SIDEBAR MENU (CÂY PHÂN CẤP ĐIỀU HƯỚNG)
             ========================================================================== -->
        <aside class="app-sidebar navbar-cand" id="appSidebar">
            <!-- Phần đầu Sidebar: Logo C500 & Tiêu đề Học viện -->
            <div class="app-sidebar-header">
                <a class="d-flex align-items-center text-decoration-none text-white" asp-controller="Home" asp-action="Index" id="lblLogo">
                    <img src="~/images/logo_badge.png" alt="Logo Học viện An ninh Nhân dân" class="logo-cand-nav me-2 shadow-sm" />
                    <div class="lh-sm">
                        <span class="d-block fw-bold text-white" style="font-size: 0.95rem; letter-spacing: 0.4px;">HỌC VIỆN AN NINH</span>
                        <span class="brand-subtitle" style="color: #FFD700; font-size: 0.7rem; font-weight: 700;">NHÂN DÂN • C500</span>
                    </div>
                </a>
            </div>

            <!-- Thân Sidebar: Cây Thư Mục Phân Cấp (Tree Navigation) -->
            <div class="app-sidebar-body">
                <ul class="sidebar-tree">
                    <!-- NHÓM 1: TỔNG QUAN & SƠ ĐỒ -->
                    <li class="tree-category">
                        <i class="bi bi-compass"></i><span>Tổng Quan &amp; Sơ Đồ</span>
                    </li>
                    <li>
                        <a asp-controller="Home" asp-action="Index" class="tree-link @(currentCtrl == "Home" ? "active" : "")">
                            <span><i class="bi bi-speedometer2 me-2"></i>Bảng Điều Khiển</span>
                            <span class="badge bg-light text-dark small py-1">Dashboard</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="CayToChuc" asp-action="Index" class="tree-link @(currentCtrl == "CayToChuc" ? "active" : "")">
                            <span><i class="bi bi-diagram-3-fill me-2" style="color: #FFD700;"></i>Cây Tổ Chức C500</span>
                            <span class="badge badge-cand-gold small py-1">Tree</span>
                        </a>
                    </li>

                    <!-- NHÓM 2: CƠ CẤU TỔ CHỨC (Khoa & Bộ môn) -->
                    <li class="tree-category mt-2">
                        <i class="bi bi-building"></i><span>Cơ Cấu Đơn Vị</span>
                    </li>
                    <li>
                        <button type="button" class="tree-branch-header" data-bs-toggle="collapse" data-bs-target="#treeBranchToChuc" aria-expanded="@(isToChucGroup ? "true" : "false")">
                            <span><i class="bi bi-bank me-2 text-warning"></i>Khoa &amp; Bộ Môn</span>
                            <i class="bi bi-chevron-right branch-chevron"></i>
                        </button>
                        <ul class="tree-subnodes collapse @(isToChucGroup ? "show" : "")" id="treeBranchToChuc">
                            <li>
                                <a asp-controller="Khoa" asp-action="Index" class="tree-sublink @(currentCtrl == "Khoa" ? "active" : "")">
                                    <span>Danh sách Khoa</span>
                                </a>
                            </li>
                            <li>
                                <a asp-controller="BoMon" asp-action="Index" class="tree-sublink @(currentCtrl == "BoMon" ? "active" : "")">
                                    <span>Danh sách Bộ môn</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- NHÓM 3: QUẢN LÝ ĐÀO TẠO -->
                    <li class="tree-category mt-2">
                        <i class="bi bi-mortarboard-fill"></i><span>Quản Lý Đào Tạo</span>
                    </li>
                    <li>
                        <button type="button" class="tree-branch-header" data-bs-toggle="collapse" data-bs-target="#treeBranchDaoTao" aria-expanded="@(isDaoTaoGroup ? "true" : "false")">
                            <span><i class="bi bi-people-fill me-2 text-info"></i>Lớp &amp; Học Viên</span>
                            <i class="bi bi-chevron-right branch-chevron"></i>
                        </button>
                        <ul class="tree-subnodes collapse @(isDaoTaoGroup ? "show" : "")" id="treeBranchDaoTao">
                            <li>
                                <a asp-controller="LopHoc" asp-action="Index" class="tree-sublink @(currentCtrl == "LopHoc" ? "active" : "")">
                                    <span>Quản lý Lớp học</span>
                                </a>
                            </li>
                            <li>
                                <a asp-controller="HocVien" asp-action="Index" class="tree-sublink @(currentCtrl == "HocVien" ? "active" : "")">
                                    <span>Quản lý Học viên</span>
                                </a>
                            </li>
                            <li>
                                <a asp-controller="MonHoc" asp-action="Index" class="tree-sublink @(currentCtrl == "MonHoc" ? "active" : "")">
                                    <span>Môn học &amp; Tín chỉ</span>
                                </a>
                            </li>
                            <li>
                                <a asp-controller="PhanCongGiangDay" asp-action="Index" class="tree-sublink @(currentCtrl == "PhanCongGiangDay" ? "active" : "")">
                                    <span>Phân công giảng dạy</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- NHÓM 4: HỒ SƠ NHÂN SỰ -->
                    <li class="tree-category mt-2">
                        <i class="bi bi-person-workspace"></i><span>Hồ Sơ Cán Bộ &amp; GV</span>
                    </li>
                    <li>
                        <button type="button" class="tree-branch-header" data-bs-toggle="collapse" data-bs-target="#treeBranchNhanSu" aria-expanded="@(isNhanSuGroup ? "true" : "false")">
                            <span><i class="bi bi-person-lines-fill me-2" style="color: #F2F0A5;"></i>Hồ Sơ &amp; Chuyên Môn</span>
                            <i class="bi bi-chevron-right branch-chevron"></i>
                        </button>
                        <ul class="tree-subnodes collapse @(isNhanSuGroup ? "show" : "")" id="treeBranchNhanSu">
                            <li>
                                <a asp-controller="NhanSu" asp-action="Index" class="tree-sublink @(currentCtrl == "NhanSu" ? "active" : "")">
                                    <span>Hồ sơ Cán bộ / GV</span>
                                </a>
                            </li>
                            <li>
                                <a asp-controller="ChucVu" asp-action="Index" class="tree-sublink @(currentCtrl == "ChucVu" ? "active" : "")">
                                    <span>Danh mục Chức vụ</span>
                                </a>
                            </li>
                            <li>
                                <a asp-controller="TrinhDoChuyenMon" asp-action="Index" class="tree-sublink @(currentCtrl == "TrinhDoChuyenMon" ? "active" : "")">
                                    <span>Trình độ chuyên môn</span>
                                </a>
                            </li>
                        </ul>
                    </li>

                    <!-- NHÓM 5: TIỆN ÍCH EXCEL -->
                    <li class="tree-category mt-2">
                        <i class="bi bi-file-earmark-excel-fill"></i><span>Tiện Ích Excel</span>
                    </li>
                    <li>
                        <a asp-controller="Excel" asp-action="NhapExcel" asp-route-module="NhanSu" class="tree-link">
                            <span><i class="bi bi-file-earmark-arrow-up me-2 text-success"></i>Nhập Excel Nhân Sự</span>
                        </a>
                    </li>
                    <li>
                        <a asp-controller="Excel" asp-action="NhapExcel" asp-route-module="Khoa" class="tree-link">
                            <span><i class="bi bi-file-earmark-arrow-up me-2 text-success"></i>Nhập Excel Khoa</span>
                        </a>
                    </li>

                    <!-- NHÓM 6: HỆ THỐNG & TÙY BIẾN DB (ADMINISTRATOR) -->
                    @if (User.IsInRole(VaiTroMacDinh.QuanTriVien) || User.IsInRole(VaiTroMacDinh.QuanLyDaoTao))
                    {
                        <li class="tree-category mt-2">
                            <i class="bi bi-shield-lock-fill"></i><span>Hệ Thống &amp; DB Live</span>
                        </li>

                        @if (User.IsInRole(VaiTroMacDinh.QuanTriVien))
                        {
                            <li>
                                <a asp-controller="QuanTriDuLieu" asp-action="Index" class="tree-link fw-bold @(currentCtrl == "QuanTriDuLieu" ? "active" : "")" style="color: #FFD700 !important;" id="btnMenuQuanTriDb">
                                    <span><i class="bi bi-database-fill-gear me-2"></i>Tùy Biến DB (Live CRUD)</span>
                                    <span class="badge bg-danger">Studio</span>
                                </a>
                            </li>
                            <li>
                                <a asp-controller="TaiKhoan" asp-action="DanhSach" class="tree-link @(currentCtrl == "TaiKhoan" ? "active" : "")">
                                    <span><i class="bi bi-people-fill me-2"></i>Quản lý Tài khoản</span>
                                </a>
                            </li>
                        }

                        <li>
                            <a asp-controller="NhatKy" asp-action="Index" class="tree-link @(currentCtrl == "NhatKy" ? "active" : "")">
                                <span><i class="bi bi-clock-history me-2"></i>Nhật ký kiểm toán</span>
                            </a>
                        </li>
                    }
                </ul>
            </div>

            <!-- Chân Sidebar -->
            <div class="app-sidebar-footer d-flex align-items-center justify-content-between">
                <div>
                    <span class="d-block fw-bold text-white">HỌC VIỆN AN NINH</span>
                    <small>Bản quyền &copy; 2026</small>
                </div>
                <span class="badge badge-cand-gold">v2.0</span>
            </div>
        </aside>

        <!-- ==========================================================================
             VÙNG NỘI DUNG CHÍNH (TOPBAR + CONTENT + FOOTER)
             ========================================================================== -->
        <div class="app-main">
            <!-- Thanh Topbar trên cùng -->
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-3">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnToggleNav" onclick="toggleSidebarMobile()" title="Ẩn / Hiện Menu Cây Bên Cạnh">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-none d-md-flex align-items-center gap-2">
                        <span class="badge badge-cand-gold px-2 py-1">C500</span>
                        <span class="fw-bold text-primary" style="letter-spacing: 0.3px;">HỌC VIỆN AN NINH NHÂN DÂN — HỆ THỐNG QUẢN LÝ ĐÀO TẠO</span>
                    </div>
                </div>

                <!-- Khu vực tài khoản người dùng góc phải -->
                <div class="d-flex align-items-center gap-2">
                    @if (User.IsInRole(VaiTroMacDinh.QuanTriVien))
                    {
                        <a asp-controller="QuanTriDuLieu" asp-action="Index" class="btn btn-sm btn-outline-success fw-bold d-none d-sm-inline-flex align-items-center gap-1 shadow-sm">
                            <i class="bi bi-database-fill-gear"></i><span>Studio DB</span>
                        </a>
                    }

                    @if (SignInManager.IsSignedIn(User))
                    {
                        var user = await UserManager.GetUserAsync(User);
                        <div class="dropdown">
                            <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2 border shadow-sm" type="button" id="cboMenuUser" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-badge-fill text-success fs-6"></i>
                                <span class="fw-semibold text-dark">@(user?.HoVaTen ?? User.Identity?.Name)</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="cboMenuUser">
                                <li class="dropdown-header">
                                    <small class="text-muted d-block">Tài khoản đăng nhập</small>
                                    <strong>@(user?.Email)</strong>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DoiMatKhau">
                                        <i class="bi bi-key me-2 text-primary"></i>Đổi mật khẩu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" id="frmDangXuat">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item text-danger" id="btnDangXuat">
                                            <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-primary fw-bold px-3 shadow-sm" asp-controller="TaiKhoan" asp-action="DangNhap" id="btnDangNhapNav">
                            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                        </a>
                    }
                </div>
            </header>

            <!-- Thông báo nhanh Flash Messages -->
            <div class="container-fluid px-4 mt-3" id="pnlThongBao">
                @if (TempData["ThongBaoThanhCong"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-4" role="alert" id="lblThongBaoThanhCong">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBaoThanhCong"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ThongBaoLoi"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-4" role="alert" id="lblThongBaoLoi">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ThongBaoLoi"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>

            <!-- Khung Quản Trị & Tùy Biến Trực Tiếp Các Trường DB (Dành cho Administrator trên tất cả các nhóm) -->
            <partial name="_AdminLiveCrudPanel" />

            <!-- Nội dung chính của từng trang -->
            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <!-- Chân trang Footer -->
            <footer class="footer-cand py-3 text-center small mt-auto">
                <div class="container-fluid px-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
                    <div class="d-flex align-items-center mb-2 mb-md-0">
                        <img src="~/images/logo_badge.png" alt="Logo C500" style="width: 24px; height: 24px;" class="me-2" />
                        <span><strong>HỌC VIỆN AN NINH NHÂN DÂN (C500)</strong> — Hệ Thống Quản Lý Đào Tạo &amp; Hồ Sơ Cán Bộ</span>
                    </div>
                    <div>
                        <span class="text-success fw-semibold">Vì nước quên thân, vì dân phục vụ</span> • &copy; 2026
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebarMobile() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('appSidebarBackdrop');
            sidebar.classList.toggle('show');
            backdrop.classList.toggle('show');
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
