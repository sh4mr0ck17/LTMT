@using Microsoft.AspNetCore.Identity
@using QuanLyDaoTao.Models
@inject SignInManager<TaiKhoan> SignInManager
@inject UserManager<TaiKhoan> UserManager

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Đào Tạo & Nhân Sự</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-brand { font-weight: 700; letter-spacing: 0.5px; }
        .nav-link { font-weight: 500; }
        .dropdown-item { font-size: 0.95rem; }
        .table th { font-weight: 600; text-transform: uppercase; font-size: 0.8rem; letter-spacing: 0.5px; }
    </style>
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index" id="lblLogo">
                    <i class="bi bi-mortarboard-fill fs-3 me-2"></i>QUẢN LÝ ĐÀO TẠO
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMainContent"
                        aria-controls="navMainContent" aria-expanded="false" aria-label="Toggle navigation" id="btnToggleNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navMainContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i>Tổng Quan
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="CayToChuc" asp-action="Index">
                                <i class="bi bi-diagram-3-fill me-1"></i>Cây Tổ Chức
                            </a>
                        </li>

                        <!-- Nhóm Tổ chức -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="cboMenuToChuc" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-building me-1"></i>Khoa & Bộ Môn
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="cboMenuToChuc">
                                <li><a class="dropdown-item" asp-controller="Khoa" asp-action="Index"><i class="bi bi-bank me-2 text-primary"></i>Danh sách Khoa</a></li>
                                <li><a class="dropdown-item" asp-controller="BoMon" asp-action="Index"><i class="bi bi-diagram-2 me-2 text-primary"></i>Danh sách Bộ môn</a></li>
                            </ul>
                        </li>

                        <!-- Nhóm Đào tạo -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="cboMenuDaoTao" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-book-half me-1"></i>Đào Tạo
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="cboMenuDaoTao">
                                <li><a class="dropdown-item" asp-controller="LopHoc" asp-action="Index"><i class="bi bi-people me-2 text-primary"></i>Quản lý Lớp học</a></li>
                                <li><a class="dropdown-item" asp-controller="HocVien" asp-action="Index"><i class="bi bi-person-badge me-2 text-primary"></i>Quản lý Học viên</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="MonHoc" asp-action="Index"><i class="bi bi-journal-bookmark me-2 text-primary"></i>Quản lý Môn học</a></li>
                                <li><a class="dropdown-item" asp-controller="PhanCongGiangDay" asp-action="Index"><i class="bi bi-calendar-check me-2 text-primary"></i>Phân công giảng dạy</a></li>
                            </ul>
                        </li>

                        <!-- Nhóm Nhân sự -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" id="cboMenuNhanSu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-person-workspace me-1"></i>Nhân Sự
                            </a>
                            <ul class="dropdown-menu shadow border-0" aria-labelledby="cboMenuNhanSu">
                                <li><a class="dropdown-item" asp-controller="NhanSu" asp-action="Index"><i class="bi bi-person-lines-fill me-2 text-primary"></i>Hồ sơ Nhân sự</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-controller="ChucVu" asp-action="Index"><i class="bi bi-award me-2 text-primary"></i>Danh mục Chức vụ</a></li>
                                <li><a class="dropdown-item" asp-controller="TrinhDoChuyenMon" asp-action="Index"><i class="bi bi-mortarboard me-2 text-primary"></i>Trình độ chuyên môn</a></li>
                            </ul>
                        </li>

                        <!-- Quản trị hệ thống & Nhật ký -->
                        @if (User.IsInRole(VaiTroMacDinh.QuanTriVien) || User.IsInRole(VaiTroMacDinh.QuanLyDaoTao))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white" href="#" id="cboMenuQuanTri" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill me-1"></i>Hệ Thống
                                </a>
                                <ul class="dropdown-menu shadow border-0" aria-labelledby="cboMenuQuanTri">
                                    @if (User.IsInRole(VaiTroMacDinh.QuanTriVien))
                                    {
                                        <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DanhSach"><i class="bi bi-people-fill me-2 text-primary"></i>Quản lý Tài khoản</a></li>
                                    }
                                    <li><a class="dropdown-item" asp-controller="NhatKy" asp-action="Index"><i class="bi bi-clock-history me-2 text-primary"></i>Nhật ký kiểm toán</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <!-- Khu vực người dùng / Xác thực -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            var user = await UserManager.GetUserAsync(User);
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" id="cboMenuUser" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle fs-5 me-2"></i>
                                    <span>@(user?.HoVaTen ?? User.Identity?.Name)</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="cboMenuUser">
                                    <li>
                                        <div class="dropdown-header">
                                            <strong>@(user?.Email)</strong>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="TaiKhoan" asp-action="DoiMatKhau"><i class="bi bi-key me-2 text-muted"></i>Đổi mật khẩu</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="TaiKhoan" asp-action="DangXuat" method="post" id="frmDangXuat">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger" id="btnDangXuat">
                                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm px-3" asp-controller="TaiKhoan" asp-action="DangNhap" id="btnDangNhapNav">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Đăng Nhập
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Thông báo nhanh Flash Messages -->
    <div class="container-fluid px-4 mt-3" id="pnlThongBao">
        @if (TempData["ThongBaoThanhCong"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert" id="lblThongBaoThanhCong">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBaoThanhCong"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ThongBaoLoi"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert" id="lblThongBaoLoi">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ThongBaoLoi"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Nội dung chính của từng trang -->
    <main role="main" class="flex-grow-1 pb-4">
        @RenderBody()
    </main>

    <!-- Chân trang Footer -->
    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container">
            <span>&copy; 2026 - <strong>Hệ Thống Quản Lý Đào Tạo & Nhân Sự</strong> (.NET 8 MVC)</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
