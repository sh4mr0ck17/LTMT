@using Microsoft.AspNetCore.Identity
@using QuanLyDaoTao.Models
@inject SignInManager<TaiKhoan> SignInManager
@inject UserManager<TaiKhoan> UserManager

@{
    var currentCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAct = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var defaultAvatar = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='60' fill='%230b4627'/><circle cx='60' cy='44' r='22' fill='%23f1c27d'/><path d='M38 38c0-14 10-22 22-22s22 8 22 22c-6-6-14-8-22-8s-16 2-22 8z' fill='%231e293b'/><path d='M24 108c4-24 20-36 36-36s32 12 36 36' fill='%23052614'/><path d='M52 72l8 16 8-16' fill='%23ffffff'/></svg>";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Học Viện An Ninh Nhân Dân (C500)</title>
    <link rel="icon" type="image/png" href="~/images/logo_badge.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/_content/Radzen.Blazor/css/standard-base.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (SignInManager.IsSignedIn(User))
{
    var user = await UserManager.GetUserAsync(User);
    var userClaims = user != null ? await UserManager.GetClaimsAsync(user) : new List<System.Security.Claims.Claim>();
    var avatarUrl = userClaims.FirstOrDefault(c => c.Type == "Avatar")?.Value ?? defaultAvatar;
    var laSuperAdmin = User.IsInRole(VaiTroMacDinh.SuperAdmin);
    var laAdmin = laSuperAdmin || User.IsInRole(VaiTroMacDinh.QuanTriVien);
    var roleLabel = laSuperAdmin ? "Superadmin" : (laAdmin ? "Quản trị viên" : (User.IsInRole(VaiTroMacDinh.QuanLy) ? "Quản lý" : "Người xem"));

    <div class="app-layout">
        <!-- Backdrop cho mobile -->
        <div class="app-sidebar-backdrop" id="appSidebarBackdrop" onclick="toggleSidebarMobile()"></div>

        <!-- SIDEBAR MENU XANH LÁ ĐẬM & TRẮNG -->
        <aside class="app-sidebar navbar-cand" id="appSidebar">
            <!-- Đầu Sidebar -->
            <div class="app-sidebar-header">
                <a class="d-flex align-items-center text-decoration-none text-white overflow-hidden" href="/" id="lblLogo">
                    <img src="~/images/logo_badge.png" alt="Logo Học viện An ninh Nhân dân" class="logo-cand-nav flex-shrink-0 shadow-sm" />
                    <div class="lh-sm ms-2 sidebar-brand-text">
                        <span class="d-block fw-bold text-white" style="font-size: 0.88rem; letter-spacing: 0.3px;">HỌC VIỆN AN NINH</span>
                        <span class="text-white-50" style="font-size: 0.68rem; font-weight: 600;">NHÂN DÂN • C500</span>
                    </div>
                </a>
                <button type="button" class="sidebar-collapse-btn d-none d-lg-flex" id="btnToggleNav" onclick="toggleSidebarCollapse()" title="Thu gọn về Icon / Mở rộng Side Panel">
                    <i class="bi bi-chevron-left" id="iconToggleSidebar"></i>
                </button>
                <button type="button" class="btn btn-sm text-white-50 d-lg-none p-1 border-0" onclick="toggleSidebarMobile()" title="Đóng menu">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <!-- Thân Sidebar -->
            <div class="app-sidebar-body">
                <ul class="sidebar-tree">
                    <li class="nav-item-Flyout">
                        <a href="/" class="tree-link @(currentCtrl == "Home" ? "active" : "")" title="Không Gian Làm Việc">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-grid-1x2-fill nav-icon"></i>
                                <span class="nav-label-text">Không Gian Làm Việc</span>
                            </div>
                        </a>
                    </li>
                    <li class="nav-item-Flyout">
                        <a href="/CayToChuc" class="tree-link @(currentCtrl == "CayToChuc" ? "active" : "")" title="Cây Tổ Chức">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-diagram-3-fill nav-icon"></i>
                                <span class="nav-label-text">Cây Tổ Chức</span>
                            </div>
                        </a>
                    </li>
                    <li class="nav-item-Flyout">
                        <button type="button" class="tree-branch-header" onclick="this.parentElement.classList.toggle('mobile-open')" title="Cơ Cấu Đơn Vị">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-building-fill nav-icon"></i>
                                <span class="nav-label-text">Cơ Cấu Đơn Vị</span>
                            </div>
                            <i class="bi bi-chevron-right branch-chevron small"></i>
                        </button>
                        <ul class="flyout-submenu">
                            <li class="flyout-header">Cơ Cấu Đơn Vị</li>
                            <li><a href="/Khoa" class="tree-sublink"><i class="bi bi-bank"></i><span>Danh sách Khoa</span></a></li>
                            <li><a href="/BoMon" class="tree-sublink"><i class="bi bi-diagram-2"></i><span>Danh sách Bộ môn</span></a></li>
                        </ul>
                    </li>
                    <li class="nav-item-Flyout">
                        <button type="button" class="tree-branch-header" onclick="this.parentElement.classList.toggle('mobile-open')" title="Quản Lý Đào Tạo">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-mortarboard-fill nav-icon"></i>
                                <span class="nav-label-text">Quản Lý Đào Tạo</span>
                            </div>
                            <i class="bi bi-chevron-right branch-chevron small"></i>
                        </button>
                        <ul class="flyout-submenu">
                            <li class="flyout-header">Quản Lý Đào Tạo</li>
                            <li><a href="/LopHoc" class="tree-sublink"><i class="bi bi-people"></i><span>Quản lý Lớp học</span></a></li>
                            <li><a href="/HocVien" class="tree-sublink"><i class="bi bi-person-badge"></i><span>Quản lý Học viên</span></a></li>
                            <li><a href="/MonHoc" class="tree-sublink"><i class="bi bi-journal-bookmark"></i><span>Môn học &amp; Tín chỉ</span></a></li>
                            <li><a href="/PhanCongGiangDay" class="tree-sublink"><i class="bi bi-calendar-check"></i><span>Phân công giảng dạy</span></a></li>
                        </ul>
                    </li>
                    <li class="nav-item-Flyout">
                        <button type="button" class="tree-branch-header" onclick="this.parentElement.classList.toggle('mobile-open')" title="Hồ Sơ Cán Bộ & GV">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-vcard-fill nav-icon"></i>
                                <span class="nav-label-text">Hồ Sơ Cán Bộ &amp; GV</span>
                            </div>
                            <i class="bi bi-chevron-right branch-chevron small"></i>
                        </button>
                        <ul class="flyout-submenu">
                            <li class="flyout-header">Hồ Sơ &amp; Danh Mục</li>
                            <li><a href="/NhanSu" class="tree-sublink"><i class="bi bi-person-lines-fill"></i><span>Danh sách Cán bộ / GV</span></a></li>
                            <li><a href="/ChucVu" class="tree-sublink"><i class="bi bi-award"></i><span>Danh mục Chức vụ</span></a></li>
                            <li><a href="/TrinhDoChuyenMon" class="tree-sublink"><i class="bi bi-patch-check"></i><span>Trình độ chuyên môn</span></a></li>
                        </ul>
                    </li>
                    @if (laAdmin)
                    {
                        <li class="nav-item-Flyout">
                            <button type="button" class="tree-branch-header" onclick="this.parentElement.classList.toggle('mobile-open')" title="Quản Trị Hệ Thống">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-shield-lock-fill nav-icon"></i>
                                    <span class="nav-label-text">Quản Trị Hệ Thống</span>
                                </div>
                                <i class="bi bi-chevron-right branch-chevron small"></i>
                            </button>
                            <ul class="flyout-submenu">
                                <li class="flyout-header">Quản Trị &amp; Tài Khoản</li>
                                <li><a asp-controller="TaiKhoan" asp-action="TaoMoi" class="tree-sublink"><i class="bi bi-person-plus-fill"></i><span>Tạo TK Giáo viên / Cán bộ</span></a></li>
                                <li><a asp-controller="TaiKhoan" asp-action="DanhSach" class="tree-sublink"><i class="bi bi-people-fill"></i><span>Quản lý &amp; Xóa Tài khoản</span></a></li>
                                <li><a href="/NhatKy" class="tree-sublink"><i class="bi bi-clock-history"></i><span>Nhật ký kiểm toán</span></a></li>
                            </ul>
                        </li>
                    }
                    @if (laSuperAdmin)
                    {
                        <li class="nav-item-Flyout">
                            <a href="/QuanTriDuLieu" class="tree-link @(currentCtrl == "QuanTriDuLieu" ? "active" : "")" id="btnMenuQuanTriDb" title="Live CRUD Studio (Superadmin)">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-database-fill-gear nav-icon"></i>
                                    <span class="nav-label-text">Live CRUD Studio</span>
                                </div>
                            </a>
                        </li>
                    }
                    <li class="nav-item-Flyout">
                        <a href="/HoSoCaNhan" class="tree-link" id="btnMenuProfile" title="Hồ Sơ Cá Nhân (Profile)">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-circle nav-icon"></i>
                                <span class="nav-label-text">Hồ Sơ Cá Nhân</span>
                            </div>
                        </a>
                    </li>
                    <li class="nav-item-Flyout mt-2 pt-2 border-top" style="border-color: rgba(255,255,255,0.12) !important;">
                        <button type="button" class="tree-link text-start w-100" id="btnMenuHuongDanTour" onclick="window.batDauTourHuongDan('@roleLabel')" title="Hướng dẫn làm quen từng nút trên màn hình">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-magic nav-icon" style="color: #34d399;"></i>
                                <span class="nav-label-text">Hướng Dẫn Tương Tác</span>
                            </div>
                        </button>
                    </li>
                </ul>
            </div>

            <!-- Góc Dưới Bên Trái: Thông Tin Tài Khoản + Avatar Mặt Người + Hồ Sơ & Đăng Xuất -->
            <div class="app-sidebar-footer" id="pnlTaiKhoanGocTrai">
                <div class="sidebar-user-card">
                    <div class="user-avatar-wrapper">
                        <img src="@avatarUrl" alt="Avatar" class="user-avatar-img" id="imgUserAvatar" />
                    </div>
                    <div class="user-profile-details">
                        <span class="user-profile-name" id="lblUserDisplayName">@(user?.HoVaTen ?? User.Identity?.Name)</span>
                        <span class="user-profile-role" id="lblUserRoleBadge">@roleLabel • @(user?.Email ?? User.Identity?.Name)</span>
                        <div class="d-flex align-items-center gap-1 mt-2">
                            <a href="/HoSoCaNhan" class="btn btn-sm btn-outline-light py-1 px-2" style="font-size: 0.72rem; border-color: rgba(255,255,255,0.28);" title="Hồ sơ cá nhân">
                                <i class="bi bi-person-vcard me-1"></i>Hồ sơ
                            </a>
                            <a href="/TaiKhoan/DangXuat" class="btn-sidebar-logout flex-grow-1" id="btnDangXuat">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Đăng xuất</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- VÙNG NỘI DUNG CHÍNH -->
        <div class="app-main">
            <!-- Thanh Topbar đồng bộ riêng cho người dùng truy cập qua Điện thoại -->
            <div class="d-flex d-lg-none align-items-center justify-content-between bg-white border-bottom px-3 py-2 sticky-top shadow-sm">
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnMobileMenuToggle" onclick="toggleSidebarMobile()">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="d-flex align-items-center gap-2">
                    <img src="~/images/logo_badge.png" alt="C500" style="width: 26px; height: 26px; border-radius: 50%;" />
                    <span class="fw-bold text-primary small">C500 • ĐÀO TẠO</span>
                </div>
                <div class="d-flex align-items-center gap-1">
                    <button type="button" class="btn btn-sm btn-outline-primary" id="btnTourMobile" onclick="window.batDauTourHuongDan('@roleLabel')" title="Hướng dẫn tương tác">
                        <i class="bi bi-magic"></i>
                    </button>
                    <a href="/HoSoCaNhan" class="btn btn-sm btn-outline-secondary" title="Hồ sơ cá nhân">
                        <i class="bi bi-person-circle"></i>
                    </a>
                    <a href="/TaiKhoan/DangXuat" class="btn btn-sm btn-outline-danger" title="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Thông báo nhanh Flash Messages -->
            <div class="container-fluid px-3 px-md-4 mt-3" id="pnlThongBao">
                @if (TempData["ThongBaoThanhCong"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm border-start border-success border-4" role="alert" id="lblThongBaoThanhCong">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["ThongBaoThanhCong"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["ThongBaoLoi"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm border-start border-danger border-4" role="alert" id="lblThongBaoLoi">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ThongBaoLoi"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>

            <main role="main" class="app-content">
                @RenderBody()
            </main>
        </div>
    </div>
}
else
{
    <!-- KHI CHƯA ĐĂNG NHẬP (KHÁCH / GUEST): ĐÃ XÓA FOOTER KHÔNG CẦN THIẾT -->
    <div class="min-vh-100 d-flex flex-column" style="background-color: #f8faf9;" id="pnlKhachDangNhap">
        <header class="navbar-cand py-3 px-3 px-md-4 bg-white border-bottom shadow-sm">
            <div class="container d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <img src="~/images/logo_badge.png" alt="Logo C500" class="logo-cand-nav me-2 shadow-sm" />
                    <div class="lh-sm">
                        <span class="d-block fw-bold text-primary" style="font-size: 0.95rem; letter-spacing: 0.4px;">HỌC VIỆN AN NINH NHÂN DÂN — C500</span>
                        <small class="text-muted">CỔNG XÁC THỰC QUẢN LÝ ĐÀO TẠO &amp; NHÂN SỰ</small>
                    </div>
                </div>
                <span class="badge bg-primary px-3 py-2 fw-semibold d-none d-sm-inline-block">
                    <i class="bi bi-shield-lock-fill me-1"></i>HỆ THỐNG NỘI BỘ
                </span>
            </div>
        </header>

        <div class="container my-auto py-4">
            @if (currentCtrl == "TaiKhoan" && (currentAct == "DangNhap" || currentAct == "DangKy" || currentAct == "TuChoiTruyCap"))
            {
                @RenderBody()
            }
            else
            {
                <div class="row justify-content-center" id="pnlDangNhap">
                    <div class="col-11 col-sm-9 col-md-5 col-lg-4">
                        <div class="card shadow-sm border overflow-hidden" style="border-radius: 12px;">
                            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #052614 0%, #0b4627 100%);">
                                <img src="~/images/logo_badge.png" alt="Logo Học viện An ninh Nhân dân" class="logo-cand-lg mb-3" />
                                <h5 class="mb-1 fw-bold text-uppercase" id="lblTieuDe" style="letter-spacing: 0.5px; color: #FFFFFF;">
                                    Học Viện An Ninh Nhân Dân
                                </h5>
                                <div class="small text-white-50">
                                    CỔNG THÔNG TIN QUẢN LÝ ĐÀO TẠO &amp; NHÂN SỰ (C500)
                                </div>
                            </div>
                            <div class="card-body p-4 bg-white">
                                <form asp-controller="TaiKhoan" asp-action="DangNhap" method="post" id="frmDangNhap">
                                    @Html.AntiForgeryToken()
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Địa chỉ Email công vụ</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-primary"><i class="bi bi-envelope-fill"></i></span>
                                            <input type="email" name="Email" class="form-control" id="txtEmail" placeholder="superadmin@quanlydaotao.local" required autofocus />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Mật khẩu xác thực</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-primary"><i class="bi bi-key-fill"></i></span>
                                            <input type="password" name="MatKhau" class="form-control" id="txtMatKhau" placeholder="••••••••" required />
                                        </div>
                                    </div>
                                    <div class="d-grid gap-2 mt-4">
                                        <button type="submit" class="btn btn-primary btn-lg fw-semibold" id="btnDangNhap">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>ĐĂNG NHẬP HỆ THỐNG
                                        </button>
                                    </div>
                                    <div class="alert alert-light py-2 px-3 small mt-3 mb-0 border text-muted text-center" id="lblThongBaoCapQuyen">
                                        <i class="bi bi-shield-lock-fill text-primary me-1"></i>
                                        Hệ thống nội bộ Học viện ANND C500. Vui lòng sử dụng tài khoản do Quản trị viên cấp để đăng nhập.
                                    </div>
                                </form>
                            </div>
                            <environment include="Development">
                            <div class="card-footer bg-light text-center py-3 text-muted small border-top">
                                <div>Superadmin: <code>superadmin@quanlydaotao.local</code> · Admin: <code>admin@quanlydaotao.local</code></div>
                                <div>Quản lý: <code>quanly.tochuc@quanlydaotao.local</code> · <code>quanly.daotao@quanlydaotao.local</code></div>
                                <div>Người xem: <code>nguoixem@quanlydaotao.local</code> (MK mẫu: <code>Admin@123456</code>, chỉ hiện ở môi trường phát triển)</div>
                            </div>
                            </environment>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        function toggleSidebarMobile() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('appSidebarBackdrop');
            if (sidebar) sidebar.classList.toggle('show');
            if (backdrop) backdrop.classList.toggle('show');
        }
        function toggleSidebarCollapse() {
            const sidebar = document.getElementById('appSidebar');
            const icon = document.getElementById('iconToggleSidebar');
            if (sidebar) {
                sidebar.classList.toggle('sidebar-collapsed');
                if (icon) {
                    icon.className = sidebar.classList.contains('sidebar-collapsed') ? 'bi bi-chevron-right' : 'bi bi-chevron-left';
                }
            }
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
