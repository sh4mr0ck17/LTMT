@model QuanLyDaoTao.Models.LopHoc
@using QuanLyDaoTao.Models
@{
    ViewData["Title"] = $"Chi tiết Lớp: {Model.TenLop}";
    Layout = "_Layout";
    bool laQuanTri = User.IsInRole(VaiTroMacDinh.QuanTriVien) || User.IsInRole(VaiTroMacDinh.QuanLyDaoTao);
}

<div class="container-fluid px-4 py-3" id="pnlChiTietLopHoc">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Danh sách Lớp học</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.TenLop</li>
                </ol>
            </nav>
            <h4 class="mb-0 text-primary fw-bold" id="lblTenLop">
                <i class="bi bi-people me-2"></i>@Model.TenLop
            </h4>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary" id="btnQuayLai">
                <i class="bi bi-arrow-left me-1"></i>Quay Lại
            </a>
            @if (laQuanTri)
            {
                <a asp-action="ChinhSua" asp-route-id="@Model.LopHocId" class="btn btn-primary" id="btnChinhSua">
                    <i class="bi bi-pencil-square me-1"></i>Chỉnh Sửa
                </a>
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Thông tin lớp học -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-primary fw-bold"><i class="bi bi-info-circle me-2"></i>Thông Tin Lớp Học</h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-muted">Mã Lớp:</dt>
                        <dd class="col-sm-7"><span class="badge bg-primary fs-6 font-monospace">@Model.MaLop</span></dd>

                        <dt class="col-sm-5 text-muted">Tên Lớp:</dt>
                        <dd class="col-sm-7 fw-bold">@Model.TenLop</dd>

                        <dt class="col-sm-5 text-muted">Niên Khóa:</dt>
                        <dd class="col-sm-7"><span class="badge bg-light text-dark border">@Model.NienKhoa</span></dd>

                        <dt class="col-sm-5 text-muted">Khoa Quản Lý:</dt>
                        <dd class="col-sm-7">
                            <a asp-controller="Khoa" asp-action="ChiTiet" asp-route-id="@Model.KhoaId">
                                @(Model.Khoa?.TenKhoa ?? "-")
                            </a>
                        </dd>

                        <dt class="col-sm-5 text-muted">Sĩ Số:</dt>
                        <dd class="col-sm-7">
                            <strong>@Model.HocViens.Count</strong> / @Model.SoLuongToiDa học viên
                            <div class="progress mt-1" style="height: 6px;">
                                @{
                                    var phanTram = Model.SoLuongToiDa > 0 ? (Model.HocViens.Count * 100 / Model.SoLuongToiDa) : 0;
                                    var bgBar = phanTram >= 100 ? "bg-danger" : phanTram > 80 ? "bg-warning" : "bg-success";
                                }
                                <div class="progress-bar @bgBar" role="progressbar" style="width: @(Math.Min(phanTram, 100))%;"></div>
                            </div>
                        </dd>

                        <dt class="col-sm-5 text-muted mt-2">Trạng Thái:</dt>
                        <dd class="col-sm-7 mt-2">
                            @if (Model.CoHoatDong)
                            {
                                <span class="badge bg-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã khóa</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Tabs Học viên & Phân công -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom p-0">
                    <ul class="nav nav-tabs card-header-tabs m-0 px-3" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active py-3" id="tab-hocvien" data-bs-toggle="tab" data-bs-target="#content-hocvien" type="button" role="tab">
                                <i class="bi bi-person-badge me-1"></i>Danh Sách Học Viên (@Model.HocViens.Count)
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link py-3" id="tab-phancong" data-bs-toggle="tab" data-bs-target="#content-phancong" type="button" role="tab">
                                <i class="bi bi-calendar-check me-1"></i>Phân Công Giảng Dạy (@Model.PhanCongGiangDays.Count)
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-0">
                    <div class="tab-content">
                        <!-- Tab Học viên -->
                        <div class="tab-pane fade show active" id="content-hocvien" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="dgvHocVienThuocLop">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Mã Học Viên</th>
                                            <th>Họ và Tên</th>
                                            <th>Ngày Sinh</th>
                                            <th>Giới Tính</th>
                                            <th>Số Điện Thoại</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.HocViens.Count == 0)
                                        {
                                            <tr><td colspan="5" class="text-center py-3 text-muted">Chưa có học viên nào trong lớp này</td></tr>
                                        }
                                        else
                                        {
                                            foreach (var hv in Model.HocViens)
                                            {
                                                <tr>
                                                    <td class="ps-3 font-monospace fw-bold">@hv.MaHocVien</td>
                                                    <td><a asp-controller="HocVien" asp-action="ChiTiet" asp-route-id="@hv.HocVienId">@hv.HoVaTen</a></td>
                                                    <td>@hv.NgaySinh.ToString("dd/MM/yyyy")</td>
                                                    <td>@hv.GioiTinh</td>
                                                    <td>@(hv.SoDienThoai ?? "-")</td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Tab Phân công -->
                        <div class="tab-pane fade" id="content-phancong" role="tabpanel">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="dgvPhanCongCuaLop">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Mã Phân Công</th>
                                            <th>Môn Học</th>
                                            <th>Giảng Viên</th>
                                            <th>Học Kỳ</th>
                                            <th class="text-center">Chủ Nhiệm</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (Model.PhanCongGiangDays.Count == 0)
                                        {
                                            <tr><td colspan="5" class="text-center py-3 text-muted">Chưa có phân công giảng dạy cho lớp này</td></tr>
                                        }
                                        else
                                        {
                                            foreach (var pc in Model.PhanCongGiangDays)
                                            {
                                                <tr>
                                                    <td class="ps-3 font-monospace fw-bold">@pc.MaPhanCong</td>
                                                    <td>@(pc.MonHoc?.TenMonHoc ?? "-")</td>
                                                    <td>@(pc.NhanSu?.HoVaTen ?? "-")</td>
                                                    <td>@pc.HocKy (@pc.NamHoc)</td>
                                                    <td class="text-center">
                                                        @if (pc.LaChuNhiem)
                                                        {
                                                            <span class="badge bg-primary">GVCN</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-muted">-</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
