@model List<QuanLyDaoTao.Models.LopHoc>
@using QuanLyDaoTao.Models
@{
    ViewData["Title"] = "Quản lý Lớp học";
    Layout = "_Layout";
    bool laQuanTri = User.IsInRole(VaiTroMacDinh.QuanTriVien) || User.IsInRole(VaiTroMacDinh.QuanLyDaoTao);
    var danhSachKhoa = ViewBag.DanhSachKhoa as List<Khoa> ?? new List<Khoa>();
    var danhSachNienKhoa = ViewBag.DanhSachNienKhoa as List<string> ?? new List<string>();
}

<div class="container-fluid px-4 py-3" id="pnlDanhSachLop">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-people me-2"></i>Quản Lý Lớp Học Đào Tạo
            </h4>
            <span class="text-muted small">Danh sách các lớp học, niên khóa và theo dõi sĩ số học viên</span>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Excel" asp-action="TaiTepMau" asp-route-module="LopHoc" class="btn btn-outline-secondary" id="btnTaiMauExcel">
                <i class="bi bi-download me-1"></i>Tải Mẫu Excel
            </a>
            <a asp-controller="Excel" asp-action="XuatDuLieu" asp-route-module="LopHoc" class="btn btn-outline-success" id="btnXuatExcel">
                <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
            </a>
            @if (laQuanTri)
            {
                <a asp-controller="Excel" asp-action="NhapExcel" asp-route-module="LopHoc" class="btn btn-success" id="btnNhapExcel">
                    <i class="bi bi-file-earmark-arrow-up me-1"></i>Nhập Excel
                </a>
                <a asp-action="ThemMoi" class="btn btn-primary" id="btnThemLop">
                    <i class="bi bi-plus-circle-fill me-1"></i>Thêm Mới Lớp Học
                </a>
            }
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4" id="pnlBoLoc">
        <div class="card-body">
            <form method="get" asp-action="Index" class="row g-3 align-items-center" id="frmTimKiem">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="tuKhoa" class="form-control" id="txtTimKiem" 
                               placeholder="Tìm mã hoặc tên lớp..." value="@ViewBag.TuKhoa" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="khoaId" class="form-select" id="cboChonKhoa">
                        <option value="">-- Tất cả Khoa --</option>
                        @foreach (var k in danhSachKhoa)
                        {
                            <option value="@k.KhoaId" selected="@(ViewBag.KhoaId == k.KhoaId ? "selected" : null)">@k.TenKhoa</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="nienKhoa" class="form-select" id="cboNienKhoa">
                        <option value="">-- Niên khóa --</option>
                        @foreach (var nk in danhSachNienKhoa)
                        {
                            <option value="@nk" selected="@(ViewBag.NienKhoa == nk ? "selected" : null)">@nk</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <select name="coHoatDong" class="form-select" id="cboLocTrangThai">
                        <option value="">-- Trạng thái --</option>
                        <option value="true" selected="@(ViewBag.CoHoatDong == true ? "selected" : null)">Đang hoạt động</option>
                        <option value="false" selected="@(ViewBag.CoHoatDong == false ? "selected" : null)">Đã khóa</option>
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100" id="btnTimKiem">
                        <i class="bi bi-funnel me-1"></i>Lọc
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary" id="btnLamMoi">
                        <i class="bi bi-arrow-clockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách Lớp học -->
    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="dgvDanhSachLop">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th style="width: 140px;">Mã Lớp</th>
                            <th>Tên Lớp</th>
                            <th>Niên Khóa</th>
                            <th>Khoa Quản Lý</th>
                            <th class="text-center" style="width: 100px;">Học Viên</th>
                            <th class="text-center" style="width: 110px;">Sĩ Số Tối Đa</th>
                            <th class="text-center" style="width: 120px;">Trạng Thái</th>
                            <th class="text-center" style="width: 160px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy lớp học nào trong hệ thống
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var lop in Model)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold font-monospace fs-6">@lop.MaLop</span>
                                    </td>
                                    <td>
                                        <a asp-action="ChiTiet" asp-route-id="@lop.LopHocId" class="fw-semibold text-decoration-none text-dark">
                                            @lop.TenLop
                                        </a>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@lop.NienKhoa</span></td>
                                    <td>
                                        <a asp-controller="Khoa" asp-action="ChiTiet" asp-route-id="@lop.KhoaId" class="badge bg-light text-dark border text-decoration-none">
                                            @(lop.Khoa?.TenKhoa ?? "-")
                                        </a>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(lop.HocViens.Count >= lop.SoLuongToiDa ? "bg-danger" : "bg-info text-dark")">
                                            @lop.HocViens.Count
                                        </span>
                                    </td>
                                    <td class="text-center">@lop.SoLuongToiDa</td>
                                    <td class="text-center">
                                        @if (lop.CoHoatDong)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-lock me-1"></i>Đã khóa</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a asp-action="ChiTiet" asp-route-id="@lop.LopHocId" class="btn btn-outline-info" title="Xem chi tiết" id="btnXem_@lop.LopHocId">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (laQuanTri)
                                            {
                                                <a asp-action="ChinhSua" asp-route-id="@lop.LopHocId" class="btn btn-outline-primary" title="Chỉnh sửa" id="btnSua_@lop.LopHocId">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form asp-action="Xoa" asp-route-id="@lop.LopHocId" method="post" class="d-inline" id="frmXoa_@lop.LopHocId">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-outline-danger" title="Xóa lớp học" id="btnXoa_@lop.LopHocId"
                                                            onclick="return confirm('Bạn có chắc chắn muốn xóa lớp \'@lop.TenLop\'? Hệ thống sẽ chặn nếu lớp còn học viên hoặc phân công.');">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
