@model QuanLyDaoTao.Models.Khoa
@{
    ViewData["Title"] = $"Chỉnh sửa Khoa: {Model.TenKhoa}";
    Layout = "_Layout";
}

<div class="container py-3" id="pnlChinhSuaKhoa">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 border-bottom">
                    <h5 class="mb-0 text-primary fw-bold" id="lblTieuDe">
                        <i class="bi bi-pencil-square me-2"></i>Chỉnh Sửa Thông Tin Khoa: @Model.TenKhoa
                    </h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChinhSua" asp-route-id="@Model.KhoaId" method="post" id="frmChinhSuaKhoa">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="KhoaId" />
                        <input type="hidden" asp-for="NgayTao" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" id="lblThongBaoLoi" role="alert"></div>

                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="MaKhoa" class="form-label fw-bold">Mã Khoa <span class="text-danger">*</span></label>
                                <input asp-for="MaKhoa" class="form-control" id="txtMaKhoa" />
                                <span asp-validation-for="MaKhoa" class="text-danger small"></span>
                            </div>

                            <div class="col-md-8">
                                <label asp-for="TenKhoa" class="form-label fw-bold">Tên Khoa <span class="text-danger">*</span></label>
                                <input asp-for="TenKhoa" class="form-control" id="txtTenKhoa" />
                                <span asp-validation-for="TenKhoa" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="SoDienThoai" class="form-label fw-bold">Số Điện Thoại Liên Hệ</label>
                                <input asp-for="SoDienThoai" class="form-control" id="txtSoDienThoai" />
                                <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label fw-bold">Địa Chỉ Email</label>
                                <input asp-for="Email" class="form-control" id="txtEmail" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DiaDiem" class="form-label fw-bold">Địa Điểm Văn Phòng</label>
                                <input asp-for="DiaDiem" class="form-control" id="txtDiaDiem" />
                                <span asp-validation-for="DiaDiem" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="MoTa" class="form-label fw-bold">Mô Tả Chức Năng Nhiệm Vụ</label>
                                <textarea asp-for="MoTa" class="form-control" id="txtMoTa" rows="3"></textarea>
                                <span asp-validation-for="MoTa" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input asp-for="CoHoatDong" class="form-check-input" id="chkCoHoatDong" />
                                    <label asp-for="CoHoatDong" class="form-check-label fw-semibold">Khoa đang hoạt động</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary" id="btnHuyThaoTac">
                                <i class="bi bi-x-circle me-1"></i>Hủy Bỏ
                            </a>
                            <button type="submit" class="btn btn-primary" id="btnCapNhatKhoa">
                                <i class="bi bi-check-circle me-1"></i>Cập Nhật Thay Đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
