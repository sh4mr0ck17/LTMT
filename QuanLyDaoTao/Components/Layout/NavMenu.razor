@using QuanLyDaoTao.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<ul class="sidebar-tree">
    <!-- 1. Không Gian Làm Việc -->
    <li class="nav-item-Flyout">
        <NavLink href="" Match="NavLinkMatch.All" class="tree-link" title="Không Gian Làm Việc" @onclick="OnItemClicked">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-grid-1x2-fill nav-icon"></i>
                <span class="nav-label-text">Không gian làm việc</span>
            </div>
        </NavLink>
    </li>

    <!-- Thông báo nội bộ (badge số chưa đọc) -->
    <li class="nav-item-Flyout">
        <NavLink href="ThongBao" class="tree-link" title="Thông báo" @onclick="OnItemClicked" id="btnMenuThongBao">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-megaphone-fill nav-icon"></i>
                <span class="nav-label-text">Thông báo</span>
                <DemThongBaoChuaDoc />
            </div>
        </NavLink>
    </li>

    <!-- 2. Tra cứu: một nơi duy nhất để xem cơ cấu và hồ sơ (danh sách chi tiết mở từ khung chi tiết) -->
    <li class="nav-item-Flyout">
        <NavLink href="CayToChuc" class="tree-link" title="Tra cứu cơ cấu: Khoa → Bộ môn → Cán bộ, Hệ → Khóa → Lớp → Học viên" @onclick="OnItemClicked">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3-fill nav-icon"></i>
                <span class="nav-label-text">Cây tổ chức &amp; tra cứu</span>
            </div>
        </NavLink>
    </li>

    <!-- 7. Dữ liệu & danh mục: nơi DUY NHẤT chỉnh sửa dữ liệu nền; Quản lý thấy bảng thuộc vùng của mình -->
    <AuthorizeView Roles="@VaiTroMacDinh.NhomCoQuyenGhi">
        <Authorized>
            <li class="nav-item-Flyout">
                <NavLink href="QuanTriDuLieu" class="tree-link" id="btnMenuQuanTriDb" title="Dữ liệu & danh mục: chỉnh sửa trực tiếp dạng bảng tính" @onclick="OnItemClicked">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-table nav-icon"></i>
                        <span class="nav-label-text">Dữ liệu &amp; danh mục</span>
                    </div>
                </NavLink>
            </li>
        </Authorized>
    </AuthorizeView>

    <!-- 6. Quản Trị Hệ Thống (Admin & Superadmin) -->
    <AuthorizeView Roles="@($"{VaiTroMacDinh.SuperAdmin},{VaiTroMacDinh.QuanTriVien}")">
        <Authorized>
            <li class="nav-item-Flyout @(mobileOpenGroup == "QuanTri" ? "mobile-open" : "")">
                <button type="button" class="tree-branch-header" title="Quản Trị Hệ Thống" @onclick='() => ToggleMobileGroup("QuanTri")'>
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill nav-icon"></i>
                        <span class="nav-label-text">Quản trị hệ thống</span>
                    </div>
                    <i class="bi bi-chevron-right branch-chevron small"></i>
                </button>
                <ul class="flyout-submenu">
                    <li class="flyout-header">Quản trị hệ thống</li>
                    <li>
                        <NavLink href="QuanTri/TaiKhoan" class="tree-sublink" @onclick="OnItemClicked">
                            <i class="bi bi-people-fill"></i>
                            <span>Tài khoản &amp; phân quyền</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="NhatKy" class="tree-sublink" @onclick="OnItemClicked">
                            <i class="bi bi-clock-history"></i>
                            <span>Nhật ký hệ thống</span>
                        </NavLink>
                    </li>
                </ul>
            </li>
        </Authorized>
    </AuthorizeView>

    <!-- 8. Hồ Sơ Cá Nhân (Profile Của Tôi) -->
    <li class="nav-item-Flyout">
        <NavLink href="HoSoCaNhan" class="tree-link" id="btnMenuProfile" title="Hồ Sơ Cá Nhân (Profile)" @onclick="OnItemClicked">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-circle nav-icon"></i>
                <span class="nav-label-text">Hồ sơ cá nhân</span>
            </div>
        </NavLink>
    </li>

    <!-- 9. Nút Bật Hướng Dẫn Tương Tác Từng Bước Qua Shadow Box (Interactive Spotlight Tour) -->
    <li class="nav-item-Flyout mt-2 pt-2 border-top" style="border-color: rgba(255,255,255,0.12) !important;">
        <button type="button" class="tree-link text-start w-100" id="btnMenuHuongDanTour" onclick="window.batDauTourHuongDan()" title="Hướng dẫn làm quen từng nút trên màn hình">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-magic nav-icon" style="color: #34d399;"></i>
                <span class="nav-label-text">Hướng dẫn tương tác</span>
            </div>
        </button>
    </li>
</ul>

@code {
    [Parameter]
    public EventCallback OnNavigateMobile { get; set; }

    private string? mobileOpenGroup;

    private void ToggleMobileGroup(string groupName)
    {
        if (mobileOpenGroup == groupName)
        {
            mobileOpenGroup = null;
        }
        else
        {
            mobileOpenGroup = groupName;
        }
    }

    private async Task OnItemClicked()
    {
        if (OnNavigateMobile.HasDelegate)
        {
            await OnNavigateMobile.InvokeAsync();
        }
    }

    private async Task BatDauTour()
    {
        if (OnNavigateMobile.HasDelegate)
        {
            await OnNavigateMobile.InvokeAsync();
        }
        try
        {
            await JSRuntime.InvokeVoidAsync("batDauTourHuongDan", "Workspace");
        }
        catch (JSException)
        {
            // Trang chưa nạp script hướng dẫn: bỏ qua, không ảnh hưởng điều hướng.
        }
    }
}
