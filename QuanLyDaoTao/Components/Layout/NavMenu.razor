@using QuanLyDaoTao.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<ul class="sidebar-tree">
    <!-- 1. Bảng Điều Khiển (Workspace Cá Nhân Hóa) -->
    <li class="nav-item-Flyout">
        <NavLink href="" Match="NavLinkMatch.All" class="tree-link" title="Không Gian Làm Việc">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-grid-1x2-fill nav-icon"></i>
                <span class="nav-label-text">Không Gian Làm Việc</span>
            </div>
        </NavLink>
    </li>

    <!-- 2. Sơ Đồ Cây Tổ Chức -->
    <li class="nav-item-Flyout">
        <NavLink href="CayToChuc" class="tree-link" title="Sơ Đồ Cây Tổ Chức">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-diagram-3-fill nav-icon"></i>
                <span class="nav-label-text">Cây Tổ Chức</span>
            </div>
        </NavLink>
    </li>

    <!-- 3. Cơ Cấu Đơn Vị (Hover mở cửa sổ nổi sang bên phải) -->
    <li class="nav-item-Flyout">
        <button type="button" class="tree-branch-header" title="Cơ Cấu Đơn Vị">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-building-fill nav-icon"></i>
                <span class="nav-label-text">Cơ Cấu Đơn Vị</span>
            </div>
            <i class="bi bi-chevron-right branch-chevron small"></i>
        </button>
        <ul class="flyout-submenu">
            <li class="flyout-header">Cơ Cấu Đơn Vị</li>
            <li>
                <NavLink href="Khoa" class="tree-sublink">
                    <i class="bi bi-bank"></i>
                    <span>Danh sách Khoa</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="BoMon" class="tree-sublink">
                    <i class="bi bi-diagram-2"></i>
                    <span>Danh sách Bộ môn</span>
                </NavLink>
            </li>
        </ul>
    </li>

    <!-- 4. Quản Lý Đào Tạo (Hover mở cửa sổ nổi sang bên phải) -->
    <li class="nav-item-Flyout">
        <button type="button" class="tree-branch-header" title="Quản Lý Đào Tạo">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-mortarboard-fill nav-icon"></i>
                <span class="nav-label-text">Quản Lý Đào Tạo</span>
            </div>
            <i class="bi bi-chevron-right branch-chevron small"></i>
        </button>
        <ul class="flyout-submenu">
            <li class="flyout-header">Quản Lý Đào Tạo</li>
            <li>
                <NavLink href="LopHoc" class="tree-sublink">
                    <i class="bi bi-people"></i>
                    <span>Quản lý Lớp học</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="HocVien" class="tree-sublink">
                    <i class="bi bi-person-badge"></i>
                    <span>Quản lý Học viên</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="MonHoc" class="tree-sublink">
                    <i class="bi bi-journal-bookmark"></i>
                    <span>Môn học &amp; Tín chỉ</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="PhanCongGiangDay" class="tree-sublink">
                    <i class="bi bi-calendar-check"></i>
                    <span>Phân công giảng dạy</span>
                </NavLink>
            </li>
        </ul>
    </li>

    <!-- 5. Hồ Sơ Cán Bộ & Giảng Viên (Hover mở cửa sổ nổi hoặc bấm trực tiếp) -->
    <li class="nav-item-Flyout">
        <NavLink href="NhanSu" class="tree-link" Match="NavLinkMatch.Prefix" title="Hồ Sơ Cán Bộ & Giảng Viên">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-vcard-fill nav-icon"></i>
                <span class="nav-label-text">Hồ Sơ Cán Bộ &amp; GV</span>
            </div>
            <i class="bi bi-chevron-right branch-chevron small"></i>
        </NavLink>
        <ul class="flyout-submenu">
            <li class="flyout-header">Hồ Sơ &amp; Danh Mục</li>
            <li>
                <NavLink href="NhanSu" class="tree-sublink" Match="NavLinkMatch.All">
                    <i class="bi bi-person-lines-fill"></i>
                    <span>Danh sách Cán bộ / GV</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="ChucVu" class="tree-sublink">
                    <i class="bi bi-award"></i>
                    <span>Danh mục Chức vụ</span>
                </NavLink>
            </li>
            <li>
                <NavLink href="TrinhDoChuyenMon" class="tree-sublink">
                    <i class="bi bi-patch-check"></i>
                    <span>Trình độ chuyên môn</span>
                </NavLink>
            </li>
        </ul>
    </li>

    <!-- 6. Quản Trị Hệ Thống (Admin & Superadmin) -->
    <AuthorizeView Roles="@($"{VaiTroMacDinh.SuperAdmin},{VaiTroMacDinh.QuanTriVien}")">
        <Authorized>
            <li class="nav-item-Flyout">
                <button type="button" class="tree-branch-header" title="Quản Trị Hệ Thống">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock-fill nav-icon"></i>
                        <span class="nav-label-text">Quản Trị Hệ Thống</span>
                    </div>
                    <i class="bi bi-chevron-right branch-chevron small"></i>
                </button>
                <ul class="flyout-submenu">
                    <li class="flyout-header">Quản Trị &amp; Tài Khoản</li>
                    <li>
                        <a href="TaiKhoan/TaoMoi" class="tree-sublink">
                            <i class="bi bi-person-plus-fill"></i>
                            <span>Tạo TK Giáo viên / Cán bộ</span>
                        </a>
                    </li>
                    <li>
                        <a href="TaiKhoan/DanhSach" class="tree-sublink">
                            <i class="bi bi-people-fill"></i>
                            <span>Quản lý &amp; Xóa Tài khoản</span>
                        </a>
                    </li>
                    <li>
                        <NavLink href="NhatKy" class="tree-sublink">
                            <i class="bi bi-clock-history"></i>
                            <span>Nhật ký kiểm toán</span>
                        </NavLink>
                    </li>
                </ul>
            </li>
        </Authorized>
    </AuthorizeView>

    <!-- 7. Tùy Biến DB Live CRUD (ĐỘC QUYỀN DUY NHẤT SUPERADMIN) -->
    <AuthorizeView Roles="@VaiTroMacDinh.SuperAdmin">
        <Authorized>
            <li class="nav-item-Flyout">
                <NavLink href="QuanTriDuLieu" class="tree-link" id="btnMenuQuanTriDb" title="Live CRUD Database Studio (Superadmin)">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-database-fill-gear nav-icon"></i>
                        <span class="nav-label-text">Live CRUD Studio</span>
                    </div>
                </NavLink>
            </li>
        </Authorized>
    </AuthorizeView>

    <!-- 8. Hồ Sơ Cá Nhân (Profile Của Tôi) -->
    <li class="nav-item-Flyout">
        <NavLink href="HoSoCaNhan" class="tree-link" id="btnMenuProfile" title="Hồ Sơ Cá Nhân (Profile)">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-person-circle nav-icon"></i>
                <span class="nav-label-text">Hồ Sơ Cá Nhân</span>
            </div>
        </NavLink>
    </li>

    <!-- 9. Hướng Dẫn Sử Dụng Chi Tiết -->
    <li class="nav-item-Flyout">
        <NavLink href="HuongDan" class="tree-link" id="btnMenuHuongDan" title="Hướng Dẫn Sử Dụng Hệ Thống">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-book-half nav-icon"></i>
                <span class="nav-label-text">Hướng Dẫn Sử Dụng</span>
            </div>
        </NavLink>
    </li>
</ul>
