@inherits LayoutComponentBase
@inject NavigationManager Navigation

<AuthorizeView>
    <Authorized Context="authCtx">
<div class="app-layout">
    <!-- Backdrop cho mobile khi mở sidebar -->
    <div class="app-sidebar-backdrop @(isSidebarOpen ? "show" : "")" id="appSidebarBackdrop" @onclick="ToggleSidebar"></div>

    <!-- SIDEBAR MENU C500 -->
    <aside class="app-sidebar navbar-cand @(isSidebarOpen ? "show" : "")" id="appSidebar">
        <NavMenu />
    </aside>

    <!-- MAIN CONTENT AREA -->
    <div class="app-main">
        <header class="app-topbar">
            <div class="d-flex align-items-center gap-3">
                <button type="button" class="btn btn-outline-secondary btn-sm" id="btnToggleNav" @onclick="ToggleSidebar" title="Ẩn / Hiện Menu Cây Bên Cạnh">
                    <i class="bi bi-list fs-5"></i>
                </button>
                <div class="d-none d-md-flex align-items-center gap-2">
                    <span class="badge badge-cand-gold px-2 py-1">C500</span>
                    <span class="fw-bold text-primary" style="letter-spacing: 0.3px;">HỌC VIỆN AN NINH NHÂN DÂN — HỆ THỐNG QUẢN LÝ ĐÀO TẠO</span>
                </div>
            </div>

            <!-- Profile & Quick links -->
            <div class="d-flex align-items-center gap-2">
                <AuthorizeView Roles="@VaiTroMacDinh.QuanTriVien">
                    <Authorized>
                        <span class="badge d-none d-lg-inline-flex align-items-center gap-1 shadow-sm" style="background-color: #0f172a; color: #f8fafc; border: 1px solid #334155;" id="lblAdminBadge">
                            <i class="bi bi-shield-lock-fill text-warning me-1"></i>ADMIN WORKSPACE
                        </span>
                        <a href="QuanTriDuLieu" class="btn btn-sm btn-outline-success fw-bold d-none d-sm-inline-flex align-items-center gap-1 shadow-sm">
                            <i class="bi bi-database-fill-gear"></i><span>Studio DB</span>
                        </a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="@VaiTroMacDinh.NguoiDung">
                    <Authorized>
                        <span class="badge d-none d-lg-inline-flex align-items-center gap-1 shadow-sm" style="background-color: #f0fdf4; color: #15803d; border: 1px solid #bbf7d0;" id="lblUserBadge">
                            <i class="bi bi-person-workspace text-success me-1"></i>USER WORKSPACE
                        </span>
                    </Authorized>
                </AuthorizeView>

                <div class="dropdown">
                    <button class="btn btn-light btn-sm dropdown-toggle d-flex align-items-center gap-2 border shadow-sm" type="button" id="cboMenuUser" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-person-badge-fill @(isUserAdmin ? "text-danger" : "text-success") fs-6"></i>
                        <span class="fw-semibold text-dark">@userDisplayName</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="cboMenuUser">
                        <li class="dropdown-header">
                            <small class="text-muted d-block">Tài khoản &amp; Vai trò</small>
                            <strong>@userEmail</strong>
                            <div>
                                <span class="badge @(isUserAdmin ? "bg-danger" : "bg-primary") mt-1">@(isUserAdmin ? "Quản trị viên (Admin)" : "Cán bộ nghiệp vụ (User)")</span>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a class="dropdown-item" href="TaiKhoan/DoiMatKhau">
                                <i class="bi bi-key me-2 text-primary"></i>Đổi mật khẩu
                            </a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <a href="TaiKhoan/DangXuat" class="dropdown-item text-danger" id="btnDangXuat">
                                <i class="bi bi-box-arrow-right me-2"></i>Đăng xuất
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <main role="main" class="app-content">
            @Body
        </main>

        <footer class="footer-cand py-3 text-center small mt-auto">
            <div class="container-fluid px-4 d-flex flex-column flex-md-row justify-content-between align-items-center">
                <div class="d-flex align-items-center mb-2 mb-md-0">
                    <img src="images/logo_badge.png" alt="Logo C500" style="width: 24px; height: 24px;" class="me-2" />
                    <span><strong>HỌC VIỆN AN NINH NHÂN DÂN (C500)</strong> — Nền tảng Blazor .NET 8</span>
                </div>
                <div>
                    <span class="text-success fw-semibold">Vì nước quên thân, vì dân phục vụ</span> • &copy; 2026
                </div>
            </div>
        </footer>
    </div>
</div>
    </Authorized>
    <NotAuthorized>
        <!-- KHI CHƯA ĐĂNG NHẬP: TUYỆT ĐỐI KHÔNG CÓ SIDEBAR, KHÔNG CÓ MENU, CHỈ HIỂN THỊ DUY NHẤT FORM ĐĂNG NHẬP C500 -->
        <div class="min-vh-100 d-flex flex-column justify-content-between" style="background-color: #f4f7f4;" id="pnlKhachDangNhapBlazor">
            <header class="navbar-cand py-3 px-4 bg-white border-bottom shadow-sm">
                <div class="container d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <img src="images/logo_badge.png" alt="Logo C500" class="logo-cand-nav me-2 shadow-sm" />
                        <div class="lh-sm">
                            <span class="d-block fw-bold text-primary" style="font-size: 0.95rem; letter-spacing: 0.4px;">HỌC VIỆN AN NINH NHÂN DÂN — C500</span>
                            <small class="text-muted">CỔNG XÁC THỰC QUẢN LÝ ĐÀO TẠO &amp; NHÂN SỰ</small>
                        </div>
                    </div>
                    <span class="badge bg-danger px-3 py-2 fw-semibold">
                        <i class="bi bi-shield-lock-fill me-1"></i>HỆ THỐNG NỘI BỘ
                    </span>
                </div>
            </header>

            <div class="container my-auto py-5">
                <div class="row justify-content-center" id="pnlDangNhap">
                    <div class="col-md-5 col-lg-4">
                        <div class="card shadow border-0 overflow-hidden" style="border-top: 4px solid #FFD700 !important;">
                            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #013E10 0%, #047920 60%, #025917 100%); border-bottom: 3px solid #FFD700;">
                                <img src="images/logo_badge.png" alt="Logo Học viện An ninh Nhân dân" class="logo-cand-lg mb-3" />
                                <h5 class="mb-1 fw-bold text-uppercase" id="lblTieuDe" style="letter-spacing: 0.6px; color: #FFFFFF;">
                                    Học Viện An Ninh Nhân Dân
                                </h5>
                                <div class="small fw-semibold" style="color: #F2F0A5;">
                                    CỔNG THÔNG TIN QUẢN LÝ ĐÀO TẠO &amp; NHÂN SỰ (C500)
                                </div>
                            </div>
                            <div class="card-body p-4 bg-white">
                                <form action="TaiKhoan/DangNhap" method="post" id="frmDangNhap">
                                    <AntiforgeryToken />
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-dark">Địa chỉ Email công vụ</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-primary"><i class="bi bi-envelope-fill"></i></span>
                                            <input type="email" name="Email" class="form-control" id="txtEmail" placeholder="admin@quanlydaotao.local" required autofocus />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-bold text-dark">Mật khẩu xác thực</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-primary"><i class="bi bi-key-fill"></i></span>
                                            <input type="password" name="MatKhau" class="form-control" id="txtMatKhau" placeholder="••••••••" required />
                                        </div>
                                    </div>
                                    <div class="d-grid gap-2 mt-4">
                                        <button type="submit" class="btn btn-primary btn-lg fw-bold" id="btnDangNhap">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>ĐĂNG NHẬP HỆ THỐNG
                                        </button>
                                    </div>
                                    <div class="alert alert-info py-2 px-3 small mt-3 mb-0 border-0 bg-light text-muted text-center" id="lblThongBaoCapQuyen">
                                        <i class="bi bi-shield-lock-fill text-primary me-1"></i>
                                        Hệ thống nội bộ Học viện ANND C500. Vui lòng sử dụng tài khoản do Quản trị viên cấp để đăng nhập.
                                    </div>
                                </form>
                            </div>
                            <div class="card-footer bg-light text-center py-3 text-muted small border-top">
                                <div>Tài khoản quản trị: <code>admin@quanlydaotao.local</code></div>
                                <div>Mật khẩu mặc định: <code>Admin@123456</code></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <footer class="py-3 text-center text-muted small bg-white border-top">
                <span>&copy; 2026 Học Viện An Ninh Nhân Dân (C500) — Bộ Công An. Bảo lưu mọi quyền.</span>
            </footer>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isSidebarOpen = false;
    private string userDisplayName = "Cán bộ C500";
    private string userEmail = "canbo@c500.edu.vn";
    private bool isUserAdmin = false;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                userEmail = user.Identity.Name ?? "canbo@c500.edu.vn";
                userDisplayName = user.FindFirst("HoVaTen")?.Value ?? userEmail;
                isUserAdmin = user.IsInRole(VaiTroMacDinh.QuanTriVien);
            }
        }
    }

    private void ToggleSidebar()
    {
        isSidebarOpen = !isSidebarOpen;
    }
}
