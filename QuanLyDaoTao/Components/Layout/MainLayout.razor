@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@inject NavigationManager Navigation
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JSRuntime

<RadzenComponents />

<AuthorizeView>
    <Authorized Context="authCtx">
        <div class="app-layout">
            <!-- Backdrop cho mobile khi mở sidebar -->
            <div class="app-sidebar-backdrop @(isMobileSidebarOpen ? "show" : "")" id="appSidebarBackdrop" @onclick="ToggleMobileSidebar"></div>

            <!-- SIDEBAR MENU XANH LÁ ĐẬM & TRẮNG (HỖ TRỢ HIDE VỀ ICON 74PX MƯỢT MÀ & HOVER MỞ SANG BÊN) -->
            <aside class="app-sidebar navbar-cand @(isSidebarCollapsed ? "sidebar-collapsed" : "") @(isMobileSidebarOpen ? "show" : "")" id="appSidebar">
                <!-- Đầu Sidebar: Logo C500 căn giữa khi thu gọn + Nút tròn gắn trên mép phải không trùng Logo -->
                <div class="app-sidebar-header">
                    <a class="d-flex align-items-center text-decoration-none text-white overflow-hidden" href="" id="lblLogo">
                        <img src="images/logo_badge.png" alt="Logo Học viện An ninh Nhân dân" class="logo-cand-nav flex-shrink-0 shadow-sm" />
                        <div class="lh-sm ms-2 sidebar-brand-text">
                            <span class="d-block fw-bold text-white" style="font-size: 0.88rem; letter-spacing: 0.3px;">HỌC VIỆN AN NINH</span>
                            <span class="text-white-50" style="font-size: 0.68rem; font-weight: 600;">NHÂN DÂN • C500</span>
                        </div>
                    </a>
                    <button type="button" class="sidebar-collapse-btn d-none d-lg-flex" id="btnToggleNav" @onclick="ToggleCollapse" title="Thu gọn về Icon / Mở rộng Side Panel">
                        <i class="bi @(isSidebarCollapsed ? "bi-chevron-right" : "bi-chevron-left")"></i>
                    </button>
                    <button type="button" class="btn btn-sm text-white-50 d-lg-none p-1 border-0" @onclick="ToggleMobileSidebar" title="Đóng menu">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>

                <!-- Thân Sidebar: Danh mục tối giản + Hover mở cửa sổ nổi / Mobile mở Accordion -->
                <div class="app-sidebar-body">
                    <NavMenu OnNavigateMobile="() => isMobileSidebarOpen = false" />
                </div>

                <!-- Góc Dưới Bên Trái: Thông Tin Tài Khoản + Avatar Mặt Người + Hồ Sơ & Đăng Xuất Rõ Ràng -->
                <div class="app-sidebar-footer" id="pnlTaiKhoanGocTrai">
                    <div class="sidebar-user-card">
                        <div class="user-avatar-wrapper" @onclick="() => showAvatarModal = true" title="Bấm để đổi ảnh đại diện (Avatar)">
                            <img src="@userAvatarUrl" alt="Avatar" class="user-avatar-img" id="imgUserAvatar" />
                            <span class="user-avatar-edit-badge"><i class="bi bi-camera-fill"></i></span>
                        </div>
                        <div class="user-profile-details">
                            <span class="user-profile-name" id="lblUserDisplayName" title="@userDisplayName">@userDisplayName</span>
                            <span class="user-profile-role" id="lblUserRoleBadge">@userRoleTitle • @userEmail</span>
                            <div class="d-flex align-items-center gap-1 mt-2">
                                <a href="HoSoCaNhan" class="btn btn-sm btn-outline-light py-1 px-2" style="font-size: 0.72rem; border-color: rgba(255,255,255,0.28);" title="Hồ sơ cá nhân (Profile)" @onclick="() => isMobileSidebarOpen = false">
                                    <i class="bi bi-person-vcard me-1"></i>Hồ sơ
                                </a>
                                <a href="TaiKhoan/DangXuat" class="btn-sidebar-logout flex-grow-1" id="btnDangXuat" title="Đăng xuất khỏi hệ thống">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Đăng xuất</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </aside>

            <!-- VÙNG NỘI DUNG CHÍNH (ĐỒNG BỘ DESKTOP & ĐIỆN THOẠI DI ĐỘNG) -->
            <div class="app-main">
                <!-- Thanh Topbar đồng bộ riêng cho người dùng truy cập qua Điện thoại -->
                <div class="d-flex d-lg-none align-items-center justify-content-between bg-white border-bottom px-3 py-2 sticky-top shadow-sm">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="btnMobileMenuToggle" @onclick="ToggleMobileSidebar" title="Mở danh mục điều hướng">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="d-flex align-items-center gap-2">
                        <img src="images/logo_badge.png" alt="C500" style="width: 26px; height: 26px; border-radius: 50%;" />
                        <span class="fw-bold text-primary small">C500 • ĐÀO TẠO</span>
                    </div>
                    <div class="d-flex align-items-center gap-1">
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnTourMobile" onclick="window.batDauTourHuongDan()" title="Hướng dẫn làm quen từng bước">
                            <i class="bi bi-magic"></i>
                        </button>
                        <a href="HoSoCaNhan" class="btn btn-sm btn-outline-secondary" title="Hồ sơ cá nhân">
                            <i class="bi bi-person-circle"></i>
                        </a>
                        <a href="TaiKhoan/DangXuat" class="btn btn-sm btn-outline-danger" title="Đăng xuất">
                            <i class="bi bi-box-arrow-right"></i>
                        </a>
                    </div>
                </div>

                <main role="main" class="app-content">
                    @Body
                </main>
            </div>
        </div>

        <!-- MODAL CHỌN / CẬP NHẬT AVATAR MẶT NGƯỜI -->
        @if (showAvatarModal)
        {
            <div class="modal fade show d-block" tabindex="-1" style="background: rgba(5, 38, 20, 0.55); z-index: 2100;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg">
                        <div class="modal-header bg-primary text-white py-3">
                            <h6 class="modal-title fw-bold mb-0">
                                <i class="bi bi-person-bounding-box me-2"></i>Cập Nhật Ảnh Đại Diện (Avatar Cá Nhân)
                            </h6>
                            <button type="button" class="btn-close btn-close-white" @onclick="() => showAvatarModal = false"></button>
                        </div>
                        <div class="modal-body p-4">
                            <label class="form-label fw-semibold small text-muted mb-2">Chọn mẫu chân dung đại diện:</label>
                            <div class="d-flex justify-content-around gap-2 mb-3 flex-wrap">
                                @foreach (var mau in danhSachAvatarMau)
                                {
                                    <div class="text-center cursor-pointer p-2 rounded border @(customAvatarInput == mau.Url ? "border-primary bg-light" : "")"
                                         style="cursor: pointer;"
                                         @onclick="() => customAvatarInput = mau.Url">
                                        <img src="@mau.Url" alt="@mau.Ten" style="width: 54px; height: 54px; border-radius: 50%; object-fit: cover;" class="mb-1 border" />
                                        <div class="small fw-medium" style="font-size: 0.72rem;">@mau.Ten</div>
                                    </div>
                                }
                            </div>
                            <div class="mb-2">
                                <label class="form-label fw-semibold small">Hoặc nhập đường dẫn ảnh chân dung (URL / Base64):</label>
                                <input type="text" class="form-control form-control-sm" @bind="customAvatarInput" placeholder="https://..." />
                            </div>
                        </div>
                        <div class="modal-footer bg-light py-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => showAvatarModal = false">Đóng</button>
                            <button type="button" class="btn btn-sm btn-primary" @onclick="LuuAvatarMoi">
                                <i class="bi bi-check2-circle me-1"></i>Lưu Ảnh Đại Diện
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <!-- KHI CHƯA ĐĂNG NHẬP: HIỂN THỊ MÀN HÌNH CỔNG ĐĂNG NHẬP TRỰC TIẾP TRÊN TRANG CHỦ / (ĐÃ XÓA FOOTER DƯ THỪA) -->
        <div class="min-vh-100 d-flex flex-column" style="background-color: #f8faf9;" id="pnlKhachDangNhap">
            <header class="navbar-cand py-3 px-3 px-md-4 bg-white border-bottom shadow-sm">
                <div class="container d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center">
                        <img src="images/logo_badge.png" alt="Logo C500" class="logo-cand-nav me-2 shadow-sm" />
                        <div class="lh-sm">
                            <span class="d-block fw-bold text-primary" style="font-size: 0.95rem; letter-spacing: 0.4px;">HỌC VIỆN AN NINH NHÂN DÂN — C500</span>
                            <small class="text-muted">CỔNG XÁC THỰC QUẢN LÝ ĐÀO TẠO &amp; NHÂN SỰ</small>
                        </div>
                    </div>
                    <span class="badge bg-primary px-3 py-2 fw-semibold d-none d-sm-inline-block">
                        <i class="bi bi-shield-lock-fill me-1"></i>HỆ THỐNG NỘI BỘ
                    </span>
                </div>
            </header>

            <div class="container my-auto py-4">
                <div class="row justify-content-center" id="pnlDangNhap">
                    <div class="col-11 col-sm-9 col-md-5 col-lg-4">
                        <div class="card shadow-sm border overflow-hidden" style="border-radius: 12px;">
                            <div class="card-header text-white text-center py-4" style="background: linear-gradient(135deg, #052614 0%, #0b4627 100%);">
                                <img src="images/logo_badge.png" alt="Logo Học viện An ninh Nhân dân" class="logo-cand-lg mb-3" />
                                <h5 class="mb-1 fw-bold text-uppercase" id="lblTieuDe" style="letter-spacing: 0.5px; color: #FFFFFF;">
                                    Học Viện An Ninh Nhân Dân
                                </h5>
                                <div class="small text-white-50">
                                    CỔNG THÔNG TIN QUẢN LÝ ĐÀO TẠO &amp; NHÂN SỰ (C500)
                                </div>
                            </div>
                            <div class="card-body p-4 bg-white">
                                <form action="/TaiKhoan/DangNhap" method="post" id="frmDangNhap">
                                    <AntiforgeryToken />
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Địa chỉ Email công vụ</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-primary"><i class="bi bi-envelope-fill"></i></span>
                                            <input type="email" name="Email" class="form-control" id="txtEmail" placeholder="superadmin@quanlydaotao.local" required autofocus />
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label fw-semibold text-dark">Mật khẩu xác thực</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-light text-primary"><i class="bi bi-key-fill"></i></span>
                                            <input type="password" name="MatKhau" class="form-control" id="txtMatKhau" placeholder="••••••••" required />
                                        </div>
                                    </div>
                                    <div class="d-grid gap-2 mt-4">
                                        <button type="submit" class="btn btn-primary btn-lg fw-semibold" id="btnDangNhap">
                                            <i class="bi bi-box-arrow-in-right me-2"></i>ĐĂNG NHẬP HỆ THỐNG
                                        </button>
                                    </div>
                                    <div class="alert alert-light py-2 px-3 small mt-3 mb-0 border text-muted text-center" id="lblThongBaoCapQuyen">
                                        <i class="bi bi-shield-lock-fill text-primary me-1"></i>
                                        Hệ thống nội bộ Học viện ANND C500. Vui lòng sử dụng tài khoản do Quản trị viên cấp để đăng nhập.
                                    </div>
                                </form>
                            </div>
                            <div class="card-footer bg-light text-center py-3 text-muted small border-top">
                                <div>Superadmin: <code>superadmin@quanlydaotao.local</code> | Admin: <code>admin@quanlydaotao.local</code></div>
                                <div>Giảng viên: <code>giaovien@quanlydaotao.local</code> | User: <code>user@quanlydaotao.local</code> (MK: <code>Admin@123456</code>)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool isSidebarCollapsed = false;
    private bool isMobileSidebarOpen = false;
    private bool showAvatarModal = false;

    private string userDisplayName = "Cán bộ C500";
    private string userEmail = "canbo@c500.edu.vn";
    private string userRoleTitle = "Cán bộ";
    private string userAvatarUrl = AvatarNamGiangVien;
    private string customAvatarInput = AvatarNamGiangVien;

    // 4 mẫu Avatar chân dung mặt người SVG sắc nét màu Xanh Lá Đậm
    public const string AvatarNamGiangVien = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='60' fill='%230b4627'/><circle cx='60' cy='44' r='22' fill='%23f1c27d'/><path d='M38 38c0-14 10-22 22-22s22 8 22 22c-6-6-14-8-22-8s-16 2-22 8z' fill='%231e293b'/><path d='M24 108c4-24 20-36 36-36s32 12 36 36' fill='%23052614'/><path d='M52 72l8 16 8-16' fill='%23ffffff'/><path d='M58 76l2 14 2-14' fill='%2315803d'/></svg>";
    public const string AvatarNuGiangVien = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='60' fill='%2315803d'/><path d='M32 48c0-18 12-30 28-30s28 12 28 30v24H32V48z' fill='%231e293b'/><circle cx='60' cy='46' r='20' fill='%23ffdbac'/><path d='M26 108c5-22 19-34 34-34s29 12 34 34' fill='%230b4627'/><path d='M50 74l10 14 10-14' fill='%23ffffff'/></svg>";
    public const string AvatarSuperAdmin = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='60' fill='%23052614'/><circle cx='60' cy='44' r='22' fill='%23f1c27d'/><path d='M36 36c2-14 12-20 24-20s22 6 24 20c-8-5-16-7-24-7s-16 2-24 7z' fill='%23334155'/><path d='M22 108c5-25 21-36 38-36s33 11 38 36' fill='%230b4627'/><polygon points='60,72 52,88 68,88' fill='%23ffffff'/></svg>";
    public const string AvatarCanBoTre = "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 120 120'><rect width='120' height='120' rx='60' fill='%2308351d'/><circle cx='60' cy='45' r='21' fill='%23ffdbac'/><path d='M39 40c0-13 9-21 21-21s21 8 21 21c-6-5-13-7-21-7s-15 2-21 7z' fill='%230f172a'/><path d='M25 108c4-23 19-34 35-34s31 11 35 34' fill='%230b4627'/></svg>";

    private readonly (string Ten, string Url)[] danhSachAvatarMau = new[]
    {
        ("Nam Giảng Viên", AvatarNamGiangVien),
        ("Nữ Giảng Viên", AvatarNuGiangVien),
        ("Lãnh Đạo / Admin", AvatarSuperAdmin),
        ("Cán Bộ / HV", AvatarCanBoTre)
    };

    protected override async Task OnParametersSetAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var principal = authState.User;
            if (principal.Identity?.IsAuthenticated == true)
            {
                userEmail = principal.Identity.Name ?? "canbo@c500.edu.vn";

                if (principal.IsInRole(VaiTroMacDinh.SuperAdmin))
                {
                    userRoleTitle = "Superadmin";
                    userAvatarUrl = AvatarSuperAdmin;
                }
                else if (principal.IsInRole(VaiTroMacDinh.QuanTriVien))
                {
                    userRoleTitle = "Quản trị viên";
                    userAvatarUrl = AvatarSuperAdmin;
                }
                else if (principal.IsInRole(VaiTroMacDinh.GiaoVien))
                {
                    userRoleTitle = "Giảng viên";
                    userAvatarUrl = AvatarNamGiangVien;
                }
                else if (principal.IsInRole(VaiTroMacDinh.CanBo) || principal.IsInRole(VaiTroMacDinh.QuanLyDaoTao))
                {
                    userRoleTitle = "Cán bộ";
                    userAvatarUrl = AvatarNuGiangVien;
                }
                else
                {
                    userRoleTitle = "Người dùng";
                    userAvatarUrl = AvatarCanBoTre;
                }

                try
                {
                    using var scope = ScopeFactory.CreateScope();
                    var userManager = scope.ServiceProvider.GetRequiredService<UserManager<TaiKhoan>>();
                    var dbUser = await userManager.FindByEmailAsync(userEmail);
                    if (dbUser != null)
                    {
                        userDisplayName = !string.IsNullOrWhiteSpace(dbUser.HoVaTen) ? dbUser.HoVaTen : userEmail;
                        var claims = await userManager.GetClaimsAsync(dbUser);
                        var avatarClaim = claims.FirstOrDefault(c => c.Type == "Avatar")?.Value;
                        if (!string.IsNullOrWhiteSpace(avatarClaim))
                        {
                            userAvatarUrl = avatarClaim;
                        }
                    }
                    else
                    {
                        userDisplayName = userEmail;
                    }
                }
                catch
                {
                    userDisplayName = userEmail;
                }

                customAvatarInput = userAvatarUrl;
            }
        }
    }

    private void ToggleCollapse()
    {
        isSidebarCollapsed = !isSidebarCollapsed;
    }

    private void ToggleMobileSidebar()
    {
        isMobileSidebarOpen = !isMobileSidebarOpen;
    }

    private async Task BatDauTourMobile()
    {
        isMobileSidebarOpen = false;
        try
        {
            await JSRuntime.InvokeVoidAsync("batDauTourHuongDan", userRoleTitle);
        }
        catch
        {
        }
    }

    private async Task LuuAvatarMoi()
    {
        if (string.IsNullOrWhiteSpace(customAvatarInput))
        {
            return;
        }

        userAvatarUrl = customAvatarInput.Trim();
        showAvatarModal = false;

        try
        {
            using var scope = ScopeFactory.CreateScope();
            var userManager = scope.ServiceProvider.GetRequiredService<UserManager<TaiKhoan>>();
            var dbUser = await userManager.FindByEmailAsync(userEmail);
            if (dbUser != null)
            {
                var claims = await userManager.GetClaimsAsync(dbUser);
                var oldAvatar = claims.FirstOrDefault(c => c.Type == "Avatar");
                if (oldAvatar != null)
                {
                    await userManager.RemoveClaimAsync(dbUser, oldAvatar);
                }
                await userManager.AddClaimAsync(dbUser, new Claim("Avatar", userAvatarUrl));
            }
        }
        catch
        {
        }
    }
}
