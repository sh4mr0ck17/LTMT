@page "/BoMon"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject IBoMonDichVu BoMonDichVu
@inject IKhoaDichVu KhoaDichVu
@inject INhanSuDichVu NhanSuDichVu
@inject NavigationManager DieuHuong

<PageTitle>Bộ môn | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachBoMon">
    <TieuDeTrang PhanHe="Tổ chức - Cán bộ" TieuDe="Bộ môn / Tổ chuyên môn" BieuTuong="bi-diagram-2"
                 MoTa="Đơn vị chuyên môn trực thuộc khoa, quản lý cán bộ giảng viên và môn học. Không chuyển khoa khi còn cán bộ trực thuộc.">
        <a href="Excel/XuatDuLieu?module=BoMon" class="btn btn-outline-primary btn-sm" id="btnXuatExcel"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        @if (_coQuyenGhiVung)
        {
            <a href="QuanTriDuLieu?bang=BoMon" class="btn btn-primary btn-sm" id="btnChinhSuaDuLieu" title="Thêm, sửa, xóa, nhập Excel tại trang Dữ liệu &amp; danh mục"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa dữ liệu</a>
        }
    </TieuDeTrang>

    <div class="khung-danh-sach">
        <div class="thanh-cong-cu" id="pnlBoLoc">
            <div class="o-tim-kiem">
                <i class="bi bi-search"></i>
                <input class="form-control" id="txtTimKiem" placeholder="Tìm mã, tên bộ môn, trưởng bộ môn..." value="@_tuKhoa" @oninput="@(e => _tuKhoa = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <RadzenDropDown TValue="int?" Data="@_danhSachKhoa" TextProperty="TenKhoa" ValueProperty="KhoaId" @bind-Value="_khoaLoc" AllowClear="true" AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" Placeholder="Tất cả khoa" class="bo-loc" id="cboChonKhoa" />
            <RadzenButton Text="Bỏ lọc" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => { _tuKhoa = string.Empty; _khoaLoc = null; })" id="btnBoLoc" />
        </div>

        <p class="dem-ket-qua" role="status" id="lblKetQua">Kết quả phù hợp: <strong>@DanhSachHienThi.Count() / @_tatCa.Count</strong></p>

        <RadzenDataGrid TItem="BoMon" Data="@DanhSachHienThi" IsLoading="@DangTai" AllowPaging="true" PageSize="20" AllowSorting="true" AllowColumnResize="true"
                        EmptyText="Không có bộ môn phù hợp." class="bang-du-lieu" id="dgvDanhSachBoMon">
            <Columns>
                <RadzenDataGridColumn TItem="BoMon" Property="MaBoMon" Title="Mã" Width="110px"><Template Context="b"><span class="ma-ban-ghi">@b.MaBoMon</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BoMon" Property="TenBoMon" Title="Tên bộ môn" Width="240px"><Template Context="b"><strong>@b.TenBoMon</strong> <NhanBanGhi NgayTao="b.NgayTao" /></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BoMon" Property="Khoa.TenKhoa" Title="Khoa" Width="220px" />
                <RadzenDataGridColumn TItem="BoMon" Title="Trưởng bộ môn" Width="180px" Sortable="false"><Template Context="b">@TenLanhDao(b.BoMonId, "CV_TBM")</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BoMon" Title="Cán bộ" Width="85px" SortProperty="NhanSus.Count" TextAlign="TextAlign.Center"><Template Context="b">@b.NhanSus.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BoMon" Title="Môn học" Width="90px" SortProperty="MonHocs.Count" TextAlign="TextAlign.Center"><Template Context="b">@b.MonHocs.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BoMon" Property="CoHoatDong" Title="Trạng thái" Width="105px">
                    <Template Context="b"><span class="chip-trang-thai @(b.CoHoatDong ? "tot" : "tat")">@(b.CoHoatDong ? "Hoạt động" : "Ngừng")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BoMon" Title="Thao tác" Width="125px" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="b">
                        <div class="o-thao-tac">
                            <RadzenButton Icon="badge" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => DieuHuong.NavigateTo($"NhanSu?bomon={b.BoMonId}"))" title="Cán bộ của bộ môn" id="@($"btnCanBo_{b.BoMonId}")" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private List<BoMon> _tatCa = [];
    private List<Khoa> _danhSachKhoa = [];
    private List<NhanSu> _canBo = [];
    private string _tuKhoa = string.Empty;
    private int? _khoaLoc;
    private bool _coQuyenGhiVung;

    /// <summary>Lọc sẵn theo khoa (?khoa=ID).</summary>
    [SupplyParameterFromQuery(Name = "khoa")]
    public int? KhoaTuDuongDan { get; set; }

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = ["BoMon", "NhanSu", "Khoa", "MonHoc"];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (KhoaTuDuongDan.HasValue)
        {
            _khoaLoc = KhoaTuDuongDan;
        }
    }

    private IEnumerable<BoMon> DanhSachHienThi => _tatCa.Where(b =>
        (_khoaLoc is null || b.KhoaId == _khoaLoc) &&
        (QuyTacNghiepVu.ChuaTuKhoa(b.MaBoMon, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(b.TenBoMon, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(TenLanhDao(b.BoMonId, "CV_TBM"), _tuKhoa)));

    private IReadOnlyList<Khoa> KhoaDuocGhi => _danhSachKhoa.Where(k => NguoiDung.CoQuyenGhi(VungQuanLy.ToChuc, k.KhoaId)).ToList();

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync()
    {
        _danhSachKhoa = await KhoaDichVu.LayDanhSachAsync();
        _tatCa = await BoMonDichVu.LayDanhSachAsync();
        _canBo = await NhanSuDichVu.LayDanhSachAsync(coHoatDong: true);
        _coQuyenGhiVung = NguoiDung.LaQuanTri || (NguoiDung.VaiTro == VaiTroMacDinh.QuanLy && NguoiDung.VungQuanLy == VungQuanLy.ToChuc);
    }

    private string TenLanhDao(int boMonId, string maChucVu)
    {
        var ten = _canBo.Where(ns => ns.BoMonId == boMonId && ns.ChucVu?.MaChucVu == maChucVu).Select(ns => ns.HoVaTen).ToList();
        return ten.Count == 0 ? "Chưa phân công" : string.Join(", ", ten);
    }



}
