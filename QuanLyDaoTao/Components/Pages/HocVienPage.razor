@page "/HocVien"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject IHocVienDichVu HocVienDichVu
@inject ILopHocDichVu LopHocDichVu
@inject ITruongTuyChinhDichVu TruongTuyChinhDichVu

<PageTitle>Học viên | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachHocVien">
    <TieuDeTrang PhanHe="Đào tạo" TieuDe="Học viên" BieuTuong="bi-person-badge"
                 MoTa="Hồ sơ học viên theo Hệ → Khóa → Lớp. Thông tin cá nhân chỉ hiển thị với người quản lý đúng phạm vi.">
        <a href="Excel/XuatDuLieu?module=HocVien" class="btn btn-outline-primary btn-sm" id="btnXuatExcel"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        @if (_coQuyenGhiVung)
        {
            <a href="QuanTriDuLieu?bang=HocVien" class="btn btn-primary btn-sm" id="btnChinhSuaDuLieu" title="Thêm, sửa, xóa, nhập Excel tại trang Dữ liệu &amp; danh mục"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa dữ liệu</a>
        }
    </TieuDeTrang>

    <div class="the-thong-ke-nho" id="pnlThongKeNhanh">
        <div><span>Tổng học viên</span><strong id="lblTongSoHocVien">@_tatCa.Count.ToString("N0")</strong></div>
        <div><span>Đang học</span><strong>@_tatCa.Count(h => h.TrangThai == "Đang học").ToString("N0")</strong></div>
        <div><span>Cán bộ lớp</span><strong>@_tatCa.Count(h => !string.IsNullOrEmpty(h.ChucVuLop)).ToString("N0")</strong></div>
        <div><span>Thiếu CCCD / SĐT</span><strong class="text-warning">@_tatCa.Count(h => string.IsNullOrEmpty(h.SoCCCD) || string.IsNullOrEmpty(h.SoDienThoai)).ToString("N0")</strong></div>
    </div>

    <div class="khung-danh-sach" id="pnlBangDuLieu">
        <div class="thanh-cong-cu" id="pnlBoLoc">
            <div class="o-tim-kiem">
                <i class="bi bi-search"></i>
                <input class="form-control" id="txtTimKiem" placeholder="Tìm mã, họ tên, chức vụ, SĐT, địa chỉ..." value="@_tuKhoa" @oninput="DoiTuKhoaAsync" aria-label="Tìm học viên" />
            </div>
            <RadzenDropDown TValue="string" Data="@DanhSachKhoaHoc" @bind-Value="_khoaHocLoc" Change="@(_ => DoiBoLocAsync(true))" AllowClear="true" AllowFiltering="true" Placeholder="Tất cả khóa" class="bo-loc bo-loc-hep" id="cboKhoaHoc" />
            <RadzenDropDown TValue="string" Data="@_danhSachHe" @bind-Value="_heLoc" Change="@(_ => DoiBoLocAsync(true))" AllowClear="true" Placeholder="Tất cả hệ" class="bo-loc bo-loc-hep" id="cboHeDaoTao" />
            <RadzenDropDown TValue="int?" Data="@LopTheoBoLoc" TextProperty="MaLop" ValueProperty="LopHocId" @bind-Value="_lopLoc" Change="@(_ => DoiBoLocAsync(false))"
                            AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains"
                            Placeholder="Tất cả lớp" class="bo-loc bo-loc-hep" id="cboChonLop" />
            <RadzenDropDown TValue="int?" Data="@_danhSachKhoa" TextProperty="TenKhoa" ValueProperty="KhoaId" @bind-Value="_khoaLoc" Change="@(_ => DoiBoLocAsync(true))"
                            AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains"
                            Placeholder="Tất cả khoa" class="bo-loc" id="cboChonKhoa" />
            <RadzenCheckBox @bind-Value="_chiCanBoLop" Name="chkCanBoLop" Change="@((bool _) => DoiBoLocAsync(false))" id="chkCanBoLop" />
            <label for="chkCanBoLop" class="small mb-0">Chỉ cán bộ lớp</label>
            <RadzenButton Text="Bỏ lọc" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="BoLocAsync" id="btnBoLoc" />
        </div>

        <p class="dem-ket-qua" role="status" id="lblKetQua">Kết quả phù hợp: <strong>@DanhSachHienThi.Count().ToString("N0") / @_tatCa.Count.ToString("N0")</strong></p>

        <RadzenDataGrid @ref="_bang" TItem="HocVien" Data="@DanhSachHienThi" IsLoading="@DangTai" AllowPaging="true" PageSize="20" PageSizeOptions="@(new[] { 20, 50, 100 })"
                        ShowPagingSummary="true" PagingSummaryFormat="Trang {0}/{1} · {2} bản ghi" AllowSorting="true" AllowColumnResize="true"
                        EmptyText="Không có học viên phù hợp. Thử bỏ bớt bộ lọc." class="bang-du-lieu" id="dgvDanhSachHocVien">
            <Columns>
                <RadzenDataGridColumn TItem="HocVien" Title="STT" Width="60px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="hv">@SoThuTu(hv)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="HocVien" Property="MaHocVien" Title="Mã HV" Width="110px">
                    <Template Context="hv"><span class="ma-ban-ghi">@hv.MaHocVien</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="HocVien" Property="HoVaTen" Title="Họ và tên" Width="210px">
                    <Template Context="hv"><strong>@hv.HoVaTen</strong> <NhanBanGhi NgayTao="hv.NgayTao" NgayCapNhat="hv.NgayCapNhat" /></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="HocVien" Property="ChucVuLop" Title="Chức vụ" Width="120px">
                    <Template Context="hv">
                        @foreach (var cv in QuyTacNghiepVu.TachChucVuLop(hv.ChucVuLop))
                        {
                            <span class="chip-chuc-vu" title="@QuyTacNghiepVu.TenDayDuChucVuLop.GetValueOrDefault(cv, cv)">@cv</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="HocVien" Property="NgaySinh" Title="Ngày sinh" FormatString="{0:dd/MM/yyyy}" Width="105px" />
                <RadzenDataGridColumn TItem="HocVien" Property="GioiTinh" Title="Giới tính" Width="85px" />
                <RadzenDataGridColumn TItem="HocVien" Property="LopHoc.MaLop" Title="Lớp" Width="90px" />
                <RadzenDataGridColumn TItem="HocVien" Property="SoDienThoai" Title="SĐT" Width="115px" />
                <RadzenDataGridColumn TItem="HocVien" Property="SoCCCD" Title="Số CCCD" Width="130px" />
                <RadzenDataGridColumn TItem="HocVien" Property="DiaChi" Title="Quê quán / địa chỉ" Width="200px" />
                @foreach (var truong in _truongTuyChinh)
                {
                    <RadzenDataGridColumn TItem="HocVien" Title="@truong.TenHienThi" Width="120px" Sortable="false">
                        <Template Context="hv">
                            @{ var giaTri = LayGiaTriTuyChinh(hv, truong.MaTruong); }
                            @(string.IsNullOrEmpty(giaTri) ? "—" : giaTri)
                        </Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn TItem="HocVien" Property="TrangThai" Title="Trạng thái" Width="105px">
                    <Template Context="hv"><span class="chip-trang-thai @(hv.TrangThai == "Đang học" ? "tot" : "canh-bao")">@hv.TrangThai</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="HocVien" Title="Thao tác" Width="125px" Sortable="false" Frozen="true" FrozenPosition="FrozenColumnPosition.Right" TextAlign="TextAlign.Center">
                    <Template Context="hv">
                        <div class="o-thao-tac">
                            <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => XemChiTietAsync(hv))" title="Xem chi tiết" id="@($"btnXem_{hv.HocVienId}")" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private const string TenBang = "HocVien";
    private RadzenDataGrid<HocVien>? _bang;
    private List<HocVien> _tatCa = [];
    private List<LopHoc> _danhSachLop = [];
    private List<Khoa> _danhSachKhoa = [];
    private List<string> _danhSachHe = [];
    private List<TruongTuyChinh> _truongTuyChinh = [];
    private Dictionary<string, Dictionary<string, string>> _giaTriTuyChinh = new();

    private string _tuKhoa = string.Empty;
    private int? _khoaLoc;
    private string? _heLoc;
    private string? _khoaHocLoc;
    private int? _lopLoc;
    private bool _chiCanBoLop;
    private bool _coQuyenGhiVung;

    /// <summary>Lọc sẵn theo lớp khi mở từ trang Lớp (?lop=ID).</summary>
    [SupplyParameterFromQuery(Name = "lop")]
    public int? LopTuDuongDan { get; set; }

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = [TenBang, "LopHoc", "Khoa"];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (LopTuDuongDan.HasValue)
        {
            _lopLoc = LopTuDuongDan;
        }
    }

    private IEnumerable<string> DanhSachKhoaHoc => _danhSachLop
        .Where(l => (_heLoc is null || l.HeDaoTao == _heLoc) && (_khoaLoc is null || l.KhoaId == _khoaLoc) && l.KhoaHoc != null)
        .Select(l => l.KhoaHoc!).Distinct().OrderByDescending(k => k);

    private IEnumerable<LopHoc> LopTheoBoLoc => _danhSachLop.Where(l =>
        (_khoaLoc is null || l.KhoaId == _khoaLoc) && (_heLoc is null || l.HeDaoTao == _heLoc) && (_khoaHocLoc is null || l.KhoaHoc == _khoaHocLoc));

    private IEnumerable<HocVien> DanhSachHienThi => _tatCa.Where(hv =>
        (_lopLoc is null || hv.LopHocId == _lopLoc) &&
        (_khoaLoc is null || hv.LopHoc?.KhoaId == _khoaLoc) &&
        (_heLoc is null || hv.LopHoc?.HeDaoTao == _heLoc) &&
        (_khoaHocLoc is null || hv.LopHoc?.KhoaHoc == _khoaHocLoc) &&
        (!_chiCanBoLop || !string.IsNullOrEmpty(hv.ChucVuLop)) &&
        KhopTuKhoa(hv));

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync()
    {
        _danhSachLop = await LopHocDichVu.LayDanhSachAsync();
        _danhSachKhoa = _danhSachLop.Where(l => l.Khoa != null).Select(l => l.Khoa!).DistinctBy(k => k.KhoaId).OrderBy(k => k.TenKhoa).ToList();
        _danhSachHe = _danhSachLop.Select(l => l.HeDaoTao).Distinct().Order().ToList();
        _truongTuyChinh = await TruongTuyChinhDichVu.LayDinhNghiaAsync(TenBang);
        _giaTriTuyChinh = await TruongTuyChinhDichVu.LayGiaTriAsync(TenBang);
        // Sắp từ ngoài vào trong: khóa mới nhất → hệ → lớp (B2 trước B10) → tên chính tiếng Việt.
        _tatCa = (await HocVienDichVu.LayDanhSachAsync())
            .OrderByDescending(hv => hv.LopHoc?.KhoaHoc ?? string.Empty, StringComparer.Ordinal)
            .ThenBy(hv => hv.LopHoc?.HeDaoTao ?? string.Empty, StringComparer.Ordinal)
            .ThenBy(hv => hv.LopHoc?.MaLop.Length ?? 0)
            .ThenBy(hv => hv.LopHoc?.MaLop ?? string.Empty, StringComparer.Ordinal)
            .ThenBy(hv => QuyTacNghiepVu.KhoaSapXepTen(hv.HoVaTen), StringComparer.Ordinal)
            .ToList();
        _coQuyenGhiVung = NguoiDung.LaQuanTri || (NguoiDung.VaiTro == VaiTroMacDinh.QuanLy && NguoiDung.VungQuanLy == VungQuanLy.DaoTao);
    }

    private bool CoQuyenGhi(HocVien hv) => NguoiDung.CoQuyenGhi(VungQuanLy.DaoTao, hv.LopHoc?.KhoaId);

    private bool KhopTuKhoa(HocVien hv)
    {
        if (string.IsNullOrWhiteSpace(_tuKhoa))
        {
            return true;
        }

        return QuyTacNghiepVu.ChuaTuKhoa(hv.MaHocVien, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(hv.HoVaTen, _tuKhoa) ||
               QuyTacNghiepVu.ChuaTuKhoa(hv.ChucVuLop, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(hv.SoDienThoai, _tuKhoa) ||
               QuyTacNghiepVu.ChuaTuKhoa(hv.DiaChi, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(hv.LopHoc?.MaLop, _tuKhoa) ||
               (_giaTriTuyChinh.TryGetValue(hv.HocVienId.ToString(), out var giaTri) && giaTri.Values.Any(v => QuyTacNghiepVu.ChuaTuKhoa(v, _tuKhoa)));
    }

    private int SoThuTu(HocVien hv) => (_bang?.View.ToList().IndexOf(hv) ?? -1) + 1;

    private string LayGiaTriTuyChinh(HocVien hv, string maTruong) =>
        _giaTriTuyChinh.TryGetValue(hv.HocVienId.ToString(), out var dong) && dong.TryGetValue(maTruong, out var giaTri) ? giaTri : string.Empty;

    private async Task DoiTuKhoaAsync(ChangeEventArgs e)
    {
        _tuKhoa = e.Value?.ToString() ?? string.Empty;
        await VeTrangDauAsync();
    }

    private async Task DoiBoLocAsync(bool datLaiLop)
    {
        if (datLaiLop && _lopLoc.HasValue && !LopTheoBoLoc.Any(l => l.LopHocId == _lopLoc))
        {
            _lopLoc = null;
        }

        await VeTrangDauAsync();
    }

    private async Task BoLocAsync()
    {
        _tuKhoa = string.Empty;
        _khoaLoc = null;
        _heLoc = null;
        _khoaHocLoc = null;
        _lopLoc = null;
        _chiCanBoLop = false;
        await VeTrangDauAsync();
    }

    private async Task VeTrangDauAsync()
    {
        if (_bang is not null)
        {
            await _bang.FirstPage(true);
        }
    }





    private Task XemChiTietAsync(HocVien hv)
    {
        var cacTruong = new List<(string, string?)>
        {
            ("Mã học viên", hv.MaHocVien), ("Họ và tên", hv.HoVaTen), ("Ngày sinh", hv.NgaySinh.ToString("dd/MM/yyyy")),
            ("Giới tính", hv.GioiTinh), ("Lớp", hv.LopHoc?.MaLop), ("Hệ · Khóa", $"{hv.LopHoc?.HeDaoTao} · {hv.LopHoc?.KhoaHoc}"),
            ("Chuyên ngành", hv.LopHoc?.ChuyenNganh), ("Khoa quản lý", hv.LopHoc?.Khoa?.TenKhoa),
            ("Chức vụ", string.Join(", ", QuyTacNghiepVu.TachChucVuLop(hv.ChucVuLop).Select(cv => QuyTacNghiepVu.TenDayDuChucVuLop.GetValueOrDefault(cv, cv)))),
            ("Số CCCD", hv.SoCCCD), ("Số điện thoại", hv.SoDienThoai), ("Email", hv.Email), ("Quê quán / địa chỉ", hv.DiaChi),
            ("Trạng thái", hv.TrangThai), ("Ngày tạo", hv.NgayTao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")),
            ("Cập nhật gần nhất", hv.NgayCapNhat?.ToLocalTime().ToString("dd/MM/yyyy HH:mm"))
        };
        cacTruong.AddRange(_truongTuyChinh.Select(t => (t.TenHienThi, (string?)LayGiaTriTuyChinh(hv, t.MaTruong))));

        return HopThoai.OpenAsync<ChiTietHoSo>($"Hồ sơ học viên {hv.MaHocVien}",
            new Dictionary<string, object?>
            {
                [nameof(ChiTietHoSo.CacTruong)] = cacTruong,
                [nameof(ChiTietHoSo.GhiChuQuyen)] = CoQuyenGhi(hv) ? null : "Thông tin cá nhân đã được che vì tài khoản không quản lý phạm vi của học viên này."
            },
            new DialogOptions { Width = "640px", CloseDialogOnOverlayClick = true });
    }
}
