@page "/HocVien"
@inject IHocVienDichVu HocVienDichVu
@inject ILopHocDichVu LopHocDichVu
@inject IQuanTriDuLieuDichVu QuanTriDuLieuDichVu
@inject NavigationManager Navigation
@inject IJSRuntime JSRuntime

<PageTitle>Quản lý Học viên - Học Viện An Ninh Nhân Dân</PageTitle>

<div class="container-fluid px-4 py-3" id="pnlDanhSachHocVien">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-person-badge me-2"></i>Quản Lý Học Viên Đào Tạo
            </h4>
            <span class="text-muted small">Danh sách học viên theo lớp chuyên ngành C500 • Đồng bộ trường tùy chỉnh thời gian thực</span>
        </div>
        <div class="d-flex gap-2">
            <a href="Excel/TaiTepMau?module=HocVien" class="btn btn-outline-secondary" id="btnTaiMauExcel">
                <i class="bi bi-download me-1"></i>Tải Mẫu Excel
            </a>
            <a href="Excel/XuatDuLieu?module=HocVien" class="btn btn-outline-success" id="btnXuatExcel">
                <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
            </a>
            <a href="Excel/NhapExcel?module=HocVien" class="btn btn-success" id="btnNhapExcel">
                <i class="bi bi-file-earmark-arrow-up me-1"></i>Nhập Excel
            </a>
            <a href="HocVien/ThemMoi" class="btn btn-primary" id="btnThemHocVien">
                <i class="bi bi-person-plus-fill me-1"></i>Thêm Mới Học Viên
            </a>
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4" id="pnlBoLoc">
        <div class="card-body">
            <div class="row g-3 align-items-center" id="frmTimKiem">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="txtTimKiem" 
                               placeholder="Tìm mã, họ tên, email, sđt, dân tộc..." 
                               @bind="tuKhoa" @bind:event="oninput" @onkeyup="LocDuLieu" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select class="form-select" id="cboChonLop" @onchange="OnLopChanged">
                        <option value="">-- Tất cả Lớp học --</option>
                        @if (danhSachLop != null)
                        {
                            @foreach (var l in danhSachLop)
                            {
                                <option value="@l.LopHocId">@l.TenLop (@l.MaLop)</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="button" class="btn btn-primary" id="btnTimKiem" @onclick="LocDuLieu">Lọc Dữ Liệu</button>
                    <button type="button" class="btn btn-outline-secondary" id="btnLamMoi" @onclick="LamMoi">Làm Mới</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách Học viên -->
    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="dgvDanhSachHocVien">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th style="width: 130px;">Mã Học Viên</th>
                            <th>Họ và Tên</th>
                            <th>Ngày Sinh</th>
                            <th>Giới Tính</th>
                            <th>Lớp Đào Tạo</th>
                            <th>Email</th>
                            <th>Số Điện Thoại</th>

                            <!-- CÁC CỘT TÙY CHỈNH ĐỘNG (NHƯ DÂN TỘC, ...) -->
                            @if (dsTruongTuyChinh != null)
                            {
                                @foreach (var cot in dsTruongTuyChinh)
                                {
                                    <th style="min-width: 120px;">
                                        <span class="text-primary fw-bold"><i class="bi bi-stars text-warning me-1"></i>@cot.TenHienThi</span>
                                    </th>
                                }
                            }

                            <th class="text-center" style="width: 120px;">Trạng Thái</th>
                            <th class="text-center" style="width: 160px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (danhSachHienThi == null || danhSachHienThi.Count == 0)
                        {
                            <tr>
                                <td colspan="@(10 + (dsTruongTuyChinh?.Count ?? 0))" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy học viên nào trong hệ thống
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var hv in danhSachHienThi)
                            {
                                string pk = hv.HocVienId.ToString();
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td><span class="badge bg-primary bg-opacity-10 text-primary fw-bold font-monospace fs-6">@hv.MaHocVien</span></td>
                                    <td>
                                        <a href="HocVien/ChiTiet/@hv.HocVienId" class="fw-semibold text-decoration-none text-dark">@hv.HoVaTen</a>
                                    </td>
                                    <td>@hv.NgaySinh.ToString("dd/MM/yyyy")</td>
                                    <td>@hv.GioiTinh</td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@(hv.LopHoc?.TenLop ?? "-")</span>
                                    </td>
                                    <td>@(hv.Email ?? "-")</td>
                                    <td>@(hv.SoDienThoai ?? "-")</td>

                                    <!-- HIỂN THỊ CỘT TÙY CHỈNH ĐỘNG (VÍ DỤ: DÂN TỘC) -->
                                    @if (dsTruongTuyChinh != null)
                                    {
                                        @foreach (var cot in dsTruongTuyChinh)
                                        {
                                            string val = LayGiaTriCustom(pk, cot.MaTruong);
                                            <td><span class="badge bg-light text-dark border p-1">@(string.IsNullOrEmpty(val) ? "-" : val)</span></td>
                                        }
                                    }

                                    <td class="text-center">
                                        <span class="badge bg-success">@hv.TrangThai</span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="HocVien/ChiTiet/@hv.HocVienId" class="btn btn-outline-info" title="Xem chi tiết" id="btnXem_@hv.HocVienId">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="HocVien/ChinhSua/@hv.HocVienId" class="btn btn-outline-primary" title="Chỉnh sửa" id="btnSua_@hv.HocVienId">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" title="Xóa học viên" id="btnXoa_@hv.HocVienId"
                                                    @onclick="() => XoaHocVien(hv.HocVienId)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<HocVien>? danhSachGoc;
    private List<HocVien>? danhSachHienThi;
    private List<LopHoc>? danhSachLop;
    private List<TruongTuyChinh>? dsTruongTuyChinh;
    private Dictionary<string, Dictionary<string, string>> mapCustomValues = new();

    private string tuKhoa = "";
    private int? lopIdLoc = null;

    protected override async Task OnInitializedAsync()
    {
        danhSachLop = await LopHocDichVu.LayDanhSachAsync();
        await LoadData();
    }

    private async Task LoadData()
    {
        danhSachGoc = await HocVienDichVu.LayDanhSachAsync();
        dsTruongTuyChinh = await QuanTriDuLieuDichVu.LayDanhSachTruongTuyChinhAsync("HocVien");
        var duLieuBang = await QuanTriDuLieuDichVu.LayDuLieuBangTrucTuyenAsync("HocVien");

        mapCustomValues.Clear();
        if (duLieuBang != null && duLieuBang.DanhSachDong != null)
        {
            foreach (var dong in duLieuBang.DanhSachDong)
            {
                var pk = dong.TryGetValue("HocVienId", out var pVal) ? pVal ?? "" : "";
                if (string.IsNullOrEmpty(pk)) continue;

                if (!mapCustomValues.ContainsKey(pk)) mapCustomValues[pk] = new(StringComparer.OrdinalIgnoreCase);

                if (dsTruongTuyChinh != null)
                {
                    foreach (var c in dsTruongTuyChinh)
                    {
                        var keyCustom = "Custom_" + c.MaTruong;
                        var val = dong.TryGetValue(keyCustom, out var v) ? v ?? "" : "";
                        mapCustomValues[pk][c.MaTruong] = val;
                    }
                }
            }
        }

        LocDuLieu();
    }

    private string LayGiaTriCustom(string pk, string maTruong)
    {
        if (mapCustomValues.TryGetValue(pk, out var dict) && dict.TryGetValue(maTruong, out var val))
        {
            return val ?? "";
        }
        return "";
    }

    private void LocDuLieu()
    {
        if (danhSachGoc == null) return;
        danhSachHienThi = danhSachGoc.Where(h =>
            (string.IsNullOrWhiteSpace(tuKhoa) ||
             h.MaHocVien.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ||
             h.HoVaTen.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ||
             (mapCustomValues.TryGetValue(h.HocVienId.ToString(), out var cDict) && cDict.Values.Any(v => v != null && v.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase)))) &&
            (!lopIdLoc.HasValue || h.LopHocId == lopIdLoc.Value)
        ).ToList();
    }

    private void OnLopChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (int.TryParse(val, out int lid) && lid > 0)
        {
            lopIdLoc = lid;
        }
        else
        {
            lopIdLoc = null;
        }
        LocDuLieu();
    }

    private async Task LamMoi()
    {
        tuKhoa = "";
        lopIdLoc = null;
        await LoadData();
    }

    private async Task XoaHocVien(int id)
    {
        try
        {
            await HocVienDichVu.XoaHocVienAsync(id);
            await LoadData();
        }
        catch
        {
        }
    }
}
