@page "/"
@page "/Home"
@page "/Home/Index"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@inject IKhoaDichVu KhoaDichVu
@inject IBoMonDichVu BoMonDichVu
@inject ILopHocDichVu LopHocDichVu
@inject IHocVienDichVu HocVienDichVu
@inject INhanSuDichVu NhanSuDichVu
@inject IMonHocDichVu MonHocDichVu
@inject IPhanCongGiangDayDichVu PhanCongDichVu
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JSRuntime

<PageTitle>Không gian làm việc | Quản lý đào tạo C500</PageTitle>

<div class="trang-chu" id="pnlDashboard">
    <header class="trang-chu-dau" id="pnlCaNhanHoaWorkspace">
        <div class="trang-chu-chao">
            <h1 id="lblTieuDeDashboard">Xin chào, @hoTenNguoiDung</h1>
            <span class="nhan-vung" id="lblWorkspaceRoleBadge">@tenWorkspace</span>
            <span class="trang-chu-ngay">@DateTime.Now.ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))</span>
        </div>
        <div class="trang-chu-nut">
            <a href="HoSoCaNhan" class="btn btn-sm btn-light" id="btnXemProfileNhanh"><i class="bi bi-person-vcard me-1"></i>Hồ sơ</a>
            <button type="button" class="btn btn-sm btn-light" id="btnBatDauTourWorkspace" onclick="window.batDauTourHuongDan()"><i class="bi bi-signpost-split me-1"></i>Hướng dẫn</button>
            @if (laSuperAdmin || laAdmin)
            {
                <a href="QuanTri/TaiKhoan" class="btn btn-sm btn-light" id="btnCapTaiKhoanGv"><i class="bi bi-person-plus me-1"></i>Tạo tài khoản</a>
                <a href="QuanTriDuLieu" class="btn btn-sm btn-primary" id="btnXemStudio"><i class="bi bi-table me-1"></i>Dữ liệu &amp; danh mục</a>
            }
        </div>
    </header>


    @if (hienThiWorkspaceGiangVienRieng && hoSoGiangVien != null)
    {
        <!-- ==========================================================================
             WORKSPACE TỐI ƯU RIÊNG CHO GIẢNG VIÊN CÓ HỒ SƠ KHỚP TRONG HỆ THỐNG
             (Chỉ hiển thị Thông tin Giảng viên, Lớp quản lý, Môn giảng dạy — Không hiện thống kê dư thừa)
             ========================================================================== -->
        <div id="pnlWorkspaceGiangVien">
            <!-- Hàng 1: 4 Thẻ Chỉ Số Thực Tế Của Giảng Viên -->
            <div class="row g-3 mb-4">
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Đơn Vị Công Tác</span>
                            <i class="bi bi-building text-primary fs-5"></i>
                        </div>
                        <h6 class="fw-bold mb-1 text-primary">@(hoSoGiangVien.Khoa?.TenKhoa ?? "Chưa phân khoa")</h6>
                        <span class="small text-muted">@(hoSoGiangVien.BoMon?.TenBoMon ?? "Bộ môn chuyên ngành")</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Môn Đang Giảng Dạy</span>
                            <i class="bi bi-journal-bookmark-fill text-primary fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-primary" id="lblSoMonGiangDay">@soMonGiangDayCaNhan</h3>
                        <span class="small text-muted">Tổng số tín chỉ: @tongTinChiCaNhan TC</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Lớp Học Quản Lý</span>
                            <i class="bi bi-people-fill text-primary fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-primary" id="lblSoLopQuanLy">@danhSachLopQuanLyCaNhan.Count</h3>
                        <span class="small text-muted">Chủ nhiệm: @soLopChuNhiemCaNhan lớp</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Học Vị &amp; Chức Vụ</span>
                            <i class="bi bi-award-fill text-primary fs-5"></i>
                        </div>
                        <h6 class="fw-bold mb-1 text-primary">@(hoSoGiangVien.TrinhDoChuyenMon?.TenTrinhDo ?? "Giảng viên")</h6>
                        <span class="small text-muted">@(hoSoGiangVien.ChucVu?.TenChucVu ?? "Cán bộ giảng dạy")</span>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Bảng 1: Các Lớp Học Đang Quản Lý & Chủ Nhiệm -->
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 h-100" id="pnlLopQuanLyCaNhan">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 text-primary fw-bold">
                                <i class="bi bi-people-fill me-2"></i>Lớp Học Quản Lý &amp; Phụ Trách (@danhSachLopQuanLyCaNhan.Count)
                            </h6>
                            <a href="LopHoc" class="btn btn-sm btn-outline-primary">Chi tiết lớp</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="dgvLopQuanLyCuaGiangVien">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Tên Lớp Đào Tạo</th>
                                            <th>Niên Khóa</th>
                                            <th class="text-center">Vai Trò</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (danhSachLopQuanLyCaNhan.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">Chưa có lớp học được phân công quản lý</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in danhSachLopQuanLyCaNhan)
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <div class="fw-semibold">@item.Lop.TenLop</div>
                                                        <small class="text-muted">Sĩ số tối đa: @item.Lop.SoLuongToiDa HV</small>
                                                    </td>
                                                    <td><span class="badge bg-light text-dark border">@item.Lop.NienKhoa</span></td>
                                                    <td class="text-center">
                                                        @if (item.LaChuNhiem)
                                                        {
                                                            <span class="badge bg-primary">Chủ nhiệm (GVCN)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-primary border">GV Bộ môn</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bảng 2: Môn Học Giảng Dạy & Lịch Phân Công Học Kỳ -->
                <div class="col-lg-7">
                    <div class="card shadow-sm border-0 h-100" id="pnlLichGiangDayCaNhan">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 text-primary fw-bold">
                                <i class="bi bi-journal-check me-2"></i>Môn Học Giảng Dạy &amp; Lịch Phân Công (@danhSachPhanCongCaNhan.Count)
                            </h6>
                            <a href="PhanCongGiangDay" class="btn btn-sm btn-outline-primary">Lịch toàn khoa</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="dgvMonGiangDayCuaGiangVien">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Môn Học Giảng Dạy</th>
                                            <th class="text-center">Tín Chỉ</th>
                                            <th>Lớp Học</th>
                                            <th>Học Kỳ</th>
                                            <th>Vai Trò</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (danhSachPhanCongCaNhan.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="5" class="text-center py-4 text-muted">Chưa có lịch phân công môn học trong học kỳ này</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var pc in danhSachPhanCongCaNhan)
                                            {
                                                <tr>
                                                    <td class="ps-3">
                                                        <div class="fw-semibold">@(pc.MonHoc?.TenMonHoc ?? "-")</div>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-primary">@(pc.MonHoc?.SoTinChi ?? 3) TC</span>
                                                    </td>
                                                    <td><span class="badge bg-light text-dark border">@(pc.LopHoc?.TenLop ?? "-")</span></td>
                                                    <td><small class="fw-medium">@pc.HocKyNamHoc</small></td>
                                                    <td><span class="badge bg-light text-primary border">@pc.VaiTroGiangDay</span></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="mt-4" id="pnlCayToChucToanBoGiangVien">
                <CayToChucPage />
            </div>
        </div>
    }
    else
    {
        <div class="luoi-chi-so" id="pnlChiSo" aria-label="Chỉ số tổng hợp">
            @foreach (var cs in danhSachChiSo)
            {
                <a class="the-chi-so @cs.Mau" href="@cs.DuongDan" aria-label="@($"{cs.Ten}: {cs.So}. {cs.Phu}")">
                    <span class="dt-o-bieu-tuong"><i class="bi @cs.BieuTuong" aria-hidden="true"></i></span>
                    <span class="the-chi-so-ten">@cs.Ten</span>
                    <strong class="the-chi-so-so" id="@cs.Id">@cs.So</strong>
                    <span class="the-chi-so-phu @LopTrangThai(cs.TrangThai)">@cs.Phu</span>
                </a>
            }
        </div>

        <!-- BÊ NGUYÊN CƠ CẤU CÂY TỔ CHỨC LÊN KHÔNG GIAN LÀM VIỆC (ĐẦY ĐỦ CỘT/SƠ ĐỒ/TRA CỨU) -->
        <div class="mt-3" id="pnlCayToChucToanBo">
            <CayToChucPage />
        </div>
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int tongSoKhoa;
    private int tongSoBoMon;
    private int tongSoLop;
    private int tongSoHocVien;
    private int tongSoNhanSu;
    private int tongSoMonHoc;

    private string hoTenNguoiDung = "Cán bộ / Học viên";
    private string tenWorkspace = "Người dùng";
    private string moTaWorkspace = "Tổng quan dữ liệu đào tạo Học viện An ninh Nhân dân (C500)";
    private string? maNhanSuLienKet;
    private string? emailDangNhap;
    private bool laSuperAdmin;
    private bool laAdmin;
    private bool laGiaoVien;
    private bool laCanBo;
    private bool hienThiWorkspaceGiangVienRieng;
    private string? vungQuanLy;
    /// <summary>Một thẻ chỉ số trên trang chủ.</summary>
    private sealed record ChiSo(string Id, string Ten, string So, string Phu, string BieuTuong, string Mau, string DuongDan, string? TrangThai = null);

    private List<ChiSo> danhSachChiSo = new();
    private int soCanBoDangLam;

    private static string? LopTrangThai(string? trangThai) => trangThai is null ? null : $"tt-{trangThai} dt-chu";


    private NhanSu? hoSoGiangVien;
    private int soMonGiangDayCaNhan;
    private int tongTinChiCaNhan;
    private int soLopChuNhiemCaNhan;
    private List<(LopHoc Lop, bool LaChuNhiem)> danhSachLopQuanLyCaNhan = new();

    private List<PhanCongGiangDay> danhSachPhanCongCaNhan = new();
    // Đã bỏ nhật ký hệ thống ở không gian làm việc

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                emailDangNhap = user.Identity.Name ?? "";
                laSuperAdmin = user.IsInRole(VaiTroMacDinh.SuperAdmin);
                laAdmin = user.IsInRole(VaiTroMacDinh.QuanTriVien);
                laCanBo = user.IsInRole(VaiTroMacDinh.QuanLy);
                vungQuanLy = user.FindFirst(LoaiClaimTuyChinh.VungQuanLy)?.Value;

                try
                {
                    using var scope = ScopeFactory.CreateScope();
                    var userManager = scope.ServiceProvider.GetRequiredService<UserManager<TaiKhoan>>();
                    var dbUser = await userManager.FindByEmailAsync(emailDangNhap);
                    if (dbUser != null)
                    {
                        hoTenNguoiDung = !string.IsNullOrWhiteSpace(dbUser.HoVaTen) ? dbUser.HoVaTen : emailDangNhap;
                        maNhanSuLienKet = dbUser.MaNhanSuLienKet;
                        // Tài khoản liên kết hồ sơ cán bộ (không phải quản trị) xem bảng phân công cá nhân.
                        laGiaoVien = !laSuperAdmin && !laAdmin && !string.IsNullOrWhiteSpace(maNhanSuLienKet);
                    }
                    else
                    {
                        hoTenNguoiDung = emailDangNhap;
                    }
                }
                catch
                {
                    hoTenNguoiDung = emailDangNhap;
                }
            }
        }

        var nhansus = await NhanSuDichVu.LayDanhSachAsync();
        var phancongs = await PhanCongDichVu.LayDanhSachAsync();

        // Tìm hồ sơ Nhân sự khớp theo MaNhanSuLienKet hoặc Email đăng nhập hoặc Họ tên
        if (!string.IsNullOrWhiteSpace(maNhanSuLienKet))
        {
            hoSoGiangVien = nhansus.FirstOrDefault(n => string.Equals(n.MaNhanSu, maNhanSuLienKet, StringComparison.OrdinalIgnoreCase));
        }
        if (hoSoGiangVien == null && !string.IsNullOrWhiteSpace(emailDangNhap))
        {
            hoSoGiangVien = nhansus.FirstOrDefault(n => string.Equals(n.Email, emailDangNhap, StringComparison.OrdinalIgnoreCase));
        }

        // Nếu là Giảng viên (hoặc tài khoản không phải Admin/Superadmin mà có hồ sơ Giảng viên khớp) -> Hiển thị Workspace Giảng viên gọn gàng
        if (!laSuperAdmin && !laAdmin && !laCanBo && hoSoGiangVien != null)
        {
            hienThiWorkspaceGiangVienRieng = true;

            if (hoSoGiangVien != null)
            {
                hoTenNguoiDung = hoSoGiangVien.HoVaTen;
                tenWorkspace = "Giảng viên";
                moTaWorkspace = $"Đơn vị: {hoSoGiangVien.Khoa?.TenKhoa ?? "Học viện C500"} • {hoSoGiangVien.BoMon?.TenBoMon ?? "Bộ môn chuyên ngành"} • Chức vụ: {hoSoGiangVien.ChucVu?.TenChucVu ?? "Giảng viên"}";

                danhSachPhanCongCaNhan = phancongs
                    .Where(p => p.NhanSuId == hoSoGiangVien.NhanSuId ||
                                (p.NhanSu != null && string.Equals(p.NhanSu.MaNhanSu, hoSoGiangVien.MaNhanSu, StringComparison.OrdinalIgnoreCase)))
                    .ToList();

                var cacMonUnique = danhSachPhanCongCaNhan
                    .Where(p => p.MonHoc != null)
                    .Select(p => p.MonHoc!)
                    .DistinctBy(m => m.MonHocId)
                    .ToList();

                soMonGiangDayCaNhan = cacMonUnique.Count;
                tongTinChiCaNhan = cacMonUnique.Sum(m => m.SoTinChi);

                danhSachLopQuanLyCaNhan = danhSachPhanCongCaNhan
                    .Where(p => p.LopHoc != null)
                    .GroupBy(p => p.LopHoc!.LopHocId)
                    .Select(g => (Lop: g.First().LopHoc!, LaChuNhiem: g.Any(x => x.LaChuNhiem)))
                    .ToList();

                soLopChuNhiemCaNhan = danhSachLopQuanLyCaNhan.Count(x => x.LaChuNhiem);
            }
            return;
        }

        // Ngược lại: Tải dữ liệu tổng hợp cho Superadmin / Admin / Cán bộ / User tra cứu
        if (laSuperAdmin)
        {
            tenWorkspace = "Siêu quản trị";
            moTaWorkspace = "Toàn quyền quản trị hệ thống, tài khoản và dữ liệu gốc";
        }
        else if (laAdmin)
        {
            tenWorkspace = "Quản trị viên";
            moTaWorkspace = "Quản trị đào tạo, tổ chức nhân sự và cấp phát tài khoản Giáo viên / Cán bộ";
        }
        else if (laCanBo)
        {
            tenWorkspace = $"Quản lý · {VungQuanLy.LayNhan(vungQuanLy)}";
            moTaWorkspace = vungQuanLy == VungQuanLy.ToChuc
                ? "Quản lý khoa, bộ môn và hồ sơ cán bộ giảng viên trong phạm vi được giao"
                : "Quản lý lớp đào tạo, hồ sơ học viên, môn học và phân công giảng dạy trong phạm vi được giao";
        }
        else
        {
            tenWorkspace = "Người xem (chỉ tra cứu)";
            moTaWorkspace = "Tra cứu thông tin đơn vị, lớp và thống kê tổng hợp; thông tin cá nhân được che";
        }

        var khoas = await KhoaDichVu.LayDanhSachAsync();
        var bomons = await BoMonDichVu.LayDanhSachAsync();
        var lophocs = await LopHocDichVu.LayDanhSachAsync();
        var hocviens = await HocVienDichVu.LayDanhSachAsync();
        var monhocs = await MonHocDichVu.LayDanhSachAsync();

        // Đã bỏ nhật ký hệ thống ở không gian làm việc

        tongSoKhoa = khoas.Count;
        tongSoBoMon = bomons.Count;
        tongSoLop = lophocs.Count;
        tongSoHocVien = hocviens.Count;
        tongSoNhanSu = nhansus.Count;
        tongSoMonHoc = monhocs.Count;


        // Số liệu thật cho thẻ chỉ số và biểu đồ (sĩ số tính từ hồ sơ học viên, không dùng số mẫu).
        var siSoTheoLop = hocviens.GroupBy(h => h.LopHocId).ToDictionary(g => g.Key, g => g.Count());
        int SiSo(LopHoc l) => siSoTheoLop.GetValueOrDefault(l.LopHocId);
        var dangLam = nhansus.Where(n => n.CoHoatDong).ToList();
        soCanBoDangLam = dangLam.Count;
        var tongChiTieu = lophocs.Sum(l => l.SoLuongToiDa);
        var tiLeLapDay = tongChiTieu == 0 ? 0 : (int)Math.Round(hocviens.Count * 100.0 / tongChiTieu);
        var soLopVuot = lophocs.Count(l => SiSo(l) > l.SoLuongToiDa);
        var soLopDay = lophocs.Count(l => SiSo(l) == l.SoLuongToiDa);

        danhSachChiSo =
        [
            new("lblTongSoKhoa", "Khoa", tongSoKhoa.ToString("N0"), $"{khoas.Count(k => k.CoHoatDong)} đang hoạt động", "bi-bank", "dt-khoa", "Khoa"),
            new("lblTongSoBoMon", "Bộ môn", tongSoBoMon.ToString("N0"), tongSoKhoa == 0 ? "Chưa có khoa" : $"TB {tongSoBoMon / (double)tongSoKhoa:0.#} bộ môn / khoa", "bi-diagram-2", "dt-bo-mon", "BoMon"),
            new("lblTongSoNhanSu", "Cán bộ, giảng viên", tongSoNhanSu.ToString("N0"), $"{soCanBoDangLam} đang công tác", "bi-person-lines-fill", "dt-can-bo", "NhanSu"),
            new("lblTongSoLop", "Lớp đào tạo", tongSoLop.ToString("N0"), soLopVuot > 0 ? $"{soLopVuot} lớp vượt chỉ tiêu" : $"{soLopDay} lớp đã đủ chỉ tiêu", "bi-people", "dt-lop", "LopHoc", soLopVuot > 0 ? "nguy" : null),
            new("lblTongSoHocVien", "Học viên", tongSoHocVien.ToString("N0"), $"Lấp đầy {tiLeLapDay}% chỉ tiêu", "bi-person-badge", "dt-hoc-vien", "HocVien", tiLeLapDay > 100 ? "nguy" : null),
            new("lblTongSoMonHoc", "Môn học", tongSoMonHoc.ToString("N0"), $"{monhocs.Sum(m => m.SoTinChi)} tín chỉ", "bi-journal-bookmark", "dt-mon-hoc", "MonHoc")
        ];


    }

    private async Task BatDauTourHuongDan()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("batDauTourHuongDan", tenWorkspace);
        }
        catch (JSException)
        {
            // Trang chưa nạp script hướng dẫn.
        }
    }
}
