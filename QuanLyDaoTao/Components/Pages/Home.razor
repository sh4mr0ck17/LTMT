@page "/"
@page "/Home"
@page "/Home/Index"
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.DependencyInjection
@inject IKhoaDichVu KhoaDichVu
@inject IBoMonDichVu BoMonDichVu
@inject ILopHocDichVu LopHocDichVu
@inject IHocVienDichVu HocVienDichVu
@inject INhanSuDichVu NhanSuDichVu
@inject IMonHocDichVu MonHocDichVu
@inject IPhanCongGiangDayDichVu PhanCongDichVu
@inject INhatKyDichVu NhatKyDichVu
@inject IServiceScopeFactory ScopeFactory
@inject IJSRuntime JSRuntime

<PageTitle>Không Gian Làm Việc - Học Viện An Ninh Nhân Dân (C500)</PageTitle>

<div class="container-fluid px-4 py-3" id="pnlDashboard">
    <!-- Thanh Tiêu Đề Không Gian Làm Việc Cá Nhân Hóa -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white border rounded-3 px-4 py-3 mb-4 shadow-sm" id="pnlCaNhanHoaWorkspace">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary px-2 py-1" id="lblWorkspaceRoleBadge">@tenWorkspace</span>
                @if (hoSoGiangVien != null)
                {
                    <span class="badge bg-light text-primary border font-monospace">Mã GV: @hoSoGiangVien.MaNhanSu</span>
                    <span class="badge bg-light text-dark border">@(hoSoGiangVien.Khoa?.TenKhoa ?? "Học viện C500")</span>
                }
            </div>
            <h5 class="mb-0 fw-bold text-primary" id="lblTieuDeDashboard">
                Xin chào, @hoTenNguoiDung
            </h5>
            <span class="text-muted small">@moTaWorkspace</span>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-2 mt-md-0">
            <a href="HoSoCaNhan" class="btn btn-sm btn-outline-primary" id="btnXemProfileNhanh">
                <i class="bi bi-person-vcard me-1"></i>Hồ Sơ Cá Nhân
            </a>
            <a href="HuongDan" class="btn btn-sm btn-outline-secondary" id="btnXemHuongDanNhanh">
                <i class="bi bi-book-half me-1"></i>Hướng Dẫn Sử Dụng
            </a>
            @if (laSuperAdmin || laAdmin)
            {
                <a href="TaiKhoan/TaoMoi" class="btn btn-sm btn-outline-primary" id="btnCapTaiKhoanGv">
                    <i class="bi bi-person-plus me-1"></i>Tạo TK Giáo Viên / Cán Bộ
                </a>
            }
            @if (laSuperAdmin)
            {
                <a href="QuanTriDuLieu" class="btn btn-sm btn-primary" id="btnXemStudio">
                    <i class="bi bi-database-fill-gear me-1"></i>Live CRUD Studio
                </a>
            }
        </div>
    </div>

    @if (hienThiWorkspaceGiangVienRieng && hoSoGiangVien != null)
    {
        <!-- ==========================================================================
             WORKSPACE TỐI ƯU RIÊNG CHO GIẢNG VIÊN CÓ HỒ SƠ KHỚP TRONG HỆ THỐNG
             (Chỉ hiển thị Thông tin Giảng viên, Lớp quản lý, Môn giảng dạy — Không hiện thống kê dư thừa)
             ========================================================================== -->
        <div id="pnlWorkspaceGiangVien">
            <!-- Hàng 1: 4 Thẻ Chỉ Số Thực Tế Của Giảng Viên -->
            <div class="row g-3 mb-4">
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Đơn Vị Công Tác</span>
                            <i class="bi bi-building text-primary fs-5"></i>
                        </div>
                        <h6 class="fw-bold mb-1 text-primary">@(hoSoGiangVien.Khoa?.TenKhoa ?? "Chưa phân khoa")</h6>
                        <span class="small text-muted">@(hoSoGiangVien.BoMon?.TenBoMon ?? "Bộ môn chuyên ngành")</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Môn Đang Giảng Dạy</span>
                            <i class="bi bi-journal-bookmark-fill text-primary fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-primary" id="lblSoMonGiangDay">@soMonGiangDayCaNhan</h3>
                        <span class="small text-muted">Tổng số tín chỉ: @tongTinChiCaNhan TC</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Lớp Học Quản Lý</span>
                            <i class="bi bi-people-fill text-primary fs-5"></i>
                        </div>
                        <h3 class="fw-bold mb-0 text-primary" id="lblSoLopQuanLy">@danhSachLopQuanLyCaNhan.Count</h3>
                        <span class="small text-muted">Chủ nhiệm: @soLopChuNhiemCaNhan lớp</span>
                    </div>
                </div>
                <div class="col-md-3 col-sm-6">
                    <div class="stat-kpi-card h-100">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="text-muted small fw-semibold text-uppercase">Học Vị &amp; Chức Vụ</span>
                            <i class="bi bi-award-fill text-primary fs-5"></i>
                        </div>
                        <h6 class="fw-bold mb-1 text-primary">@(hoSoGiangVien.TrinhDoChuyenMon?.TenTrinhDo ?? "Giảng viên")</h6>
                        <span class="small text-muted">@(hoSoGiangVien.ChucVu?.TenChucVu ?? "Cán bộ giảng dạy")</span>
                    </div>
                </div>
            </div>

            <div class="row g-4">
                <!-- Bảng 1: Các Lớp Học Đang Quản Lý & Chủ Nhiệm -->
                <div class="col-lg-5">
                    <div class="card shadow-sm border-0 h-100" id="pnlLopQuanLyCaNhan">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 text-primary fw-bold">
                                <i class="bi bi-people-fill me-2"></i>Lớp Học Quản Lý &amp; Phụ Trách (@danhSachLopQuanLyCaNhan.Count)
                            </h6>
                            <a href="LopHoc" class="btn btn-sm btn-outline-primary">Chi tiết lớp</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="dgvLopQuanLyCuaGiangVien">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Mã Lớp</th>
                                            <th>Tên Lớp Đào Tạo</th>
                                            <th>Niên Khóa</th>
                                            <th class="text-center">Vai Trò</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (danhSachLopQuanLyCaNhan.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="4" class="text-center py-4 text-muted">Chưa có lớp học được phân công quản lý</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var item in danhSachLopQuanLyCaNhan)
                                            {
                                                <tr>
                                                    <td class="ps-3 font-monospace fw-bold text-primary">@item.Lop.MaLop</td>
                                                    <td>
                                                        <div class="fw-semibold">@item.Lop.TenLop</div>
                                                        <small class="text-muted">Sĩ số tối đa: @item.Lop.SoLuongToiDa HV</small>
                                                    </td>
                                                    <td><span class="badge bg-light text-dark border">@item.Lop.NienKhoa</span></td>
                                                    <td class="text-center">
                                                        @if (item.LaChuNhiem)
                                                        {
                                                            <span class="badge bg-primary">Chủ nhiệm (GVCN)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-light text-primary border">GV Bộ môn</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Bảng 2: Môn Học Giảng Dạy & Lịch Phân Công Học Kỳ -->
                <div class="col-lg-7">
                    <div class="card shadow-sm border-0 h-100" id="pnlLichGiangDayCaNhan">
                        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                            <h6 class="mb-0 text-primary fw-bold">
                                <i class="bi bi-journal-check me-2"></i>Môn Học Giảng Dạy &amp; Lịch Phân Công (@danhSachPhanCongCaNhan.Count)
                            </h6>
                            <a href="PhanCongGiangDay" class="btn btn-sm btn-outline-primary">Lịch toàn khoa</a>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0" id="dgvMonGiangDayCuaGiangVien">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Mã PC</th>
                                            <th>Môn Học Giảng Dạy</th>
                                            <th class="text-center">Tín Chỉ</th>
                                            <th>Lớp Học</th>
                                            <th>Học Kỳ</th>
                                            <th>Vai Trò</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (danhSachPhanCongCaNhan.Count == 0)
                                        {
                                            <tr>
                                                <td colspan="6" class="text-center py-4 text-muted">Chưa có lịch phân công môn học trong học kỳ này</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            @foreach (var pc in danhSachPhanCongCaNhan)
                                            {
                                                <tr>
                                                    <td class="ps-3 font-monospace fw-semibold text-primary">@pc.MaPhanCong</td>
                                                    <td>
                                                        <div class="fw-semibold">@(pc.MonHoc?.TenMonHoc ?? "-")</div>
                                                        <small class="text-muted">Mã MH: <code>@(pc.MonHoc?.MaMonHoc ?? "-")</code></small>
                                                    </td>
                                                    <td class="text-center">
                                                        <span class="badge bg-primary">@(pc.MonHoc?.SoTinChi ?? 3) TC</span>
                                                    </td>
                                                    <td><span class="badge bg-light text-dark border">@(pc.LopHoc?.TenLop ?? "-")</span></td>
                                                    <td><small class="fw-medium">@pc.HocKyNamHoc</small></td>
                                                    <td><span class="badge bg-light text-primary border">@pc.VaiTroGiangDay</span></td>
                                                </tr>
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ==========================================================================
             WORKSPACE TỔNG QUAN DÀNH CHO SUPERADMIN / ADMIN / CÁN BỘ / USER TRA CỨU
             ========================================================================== -->
        <div class="row g-3 mb-4">
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="stat-kpi-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Khoa Đào Tạo</span>
                        <i class="bi bi-bank text-primary fs-5"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-primary" id="lblTongSoKhoa">@tongSoKhoa</h3>
                    <a href="Khoa" class="text-decoration-none small text-muted">Xem danh sách &rarr;</a>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="stat-kpi-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Bộ Môn</span>
                        <i class="bi bi-diagram-2 text-primary fs-5"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-primary" id="lblTongSoBoMon">@tongSoBoMon</h3>
                    <a href="BoMon" class="text-decoration-none small text-muted">Xem danh sách &rarr;</a>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="stat-kpi-card stat-kpi-gold h-100">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Lớp Học</span>
                        <i class="bi bi-people text-primary fs-5"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-primary" id="lblTongSoLop">@tongSoLop</h3>
                    <a href="LopHoc" class="text-decoration-none small text-muted">Xem danh sách &rarr;</a>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="stat-kpi-card stat-kpi-red h-100">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Học Viên</span>
                        <i class="bi bi-person-badge text-primary fs-5"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-primary" id="lblTongSoHocVien">@tongSoHocVien</h3>
                    <a href="HocVien" class="text-decoration-none small text-muted">Xem danh sách &rarr;</a>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="stat-kpi-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Cán Bộ / GV</span>
                        <i class="bi bi-person-lines-fill text-primary fs-5"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-primary" id="lblTongSoNhanSu">@tongSoNhanSu</h3>
                    <a href="NhanSu" class="text-decoration-none small text-muted">Xem danh sách &rarr;</a>
                </div>
            </div>
            <div class="col-xl-2 col-md-4 col-sm-6">
                <div class="stat-kpi-card h-100">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small fw-semibold text-uppercase">Môn Học</span>
                        <i class="bi bi-journal-bookmark text-primary fs-5"></i>
                    </div>
                    <h3 class="fw-bold mb-0 text-primary" id="lblTongSoMonHoc">@tongSoMonHoc</h3>
                    <a href="MonHoc" class="text-decoration-none small text-muted">Xem danh sách &rarr;</a>
                </div>
            </div>
        </div>

        <!-- PANEL BIỂU ĐỒ THỐNG KÊ TRỰC QUAN -->
        <div class="card shadow-sm border-0 mb-4" id="pnlBieuDoThongKe">
            <div class="card-header bg-white py-3 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h6 class="mb-0 text-primary fw-bold">
                    <i class="bi bi-bar-chart-line me-2"></i>Biểu Đồ Phân Tích Quy Mô Đào Tạo &amp; Nhân Sự
                </h6>
                <span class="text-muted small">Dữ liệu thời gian thực</span>
            </div>
            <div class="card-body p-4 bg-white">
                <div class="row g-4">
                    <div class="col-lg-6">
                        <div class="diagram-panel-card h-100">
                            <div class="diagram-header">
                                <span class="diagram-header-title">
                                    <i class="bi bi-bar-chart text-primary"></i>Quy Mô Học Viên &amp; Lớp Theo Khoa
                                </span>
                            </div>
                            <div class="diagram-canvas-wrapper">
                                <canvas id="chartHocVienTheoKhoa"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="diagram-panel-card h-100">
                            <div class="diagram-header">
                                <span class="diagram-header-title">
                                    <i class="bi bi-pie-chart text-primary"></i>Cơ Cấu Trình Độ &amp; Học Vị Cán Bộ
                                </span>
                            </div>
                            <div class="diagram-canvas-wrapper d-flex align-items-center justify-content-center">
                                <canvas id="chartTrinhDoChuyenMon" style="max-height: 250px;"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="diagram-panel-card h-100">
                            <div class="diagram-header">
                                <span class="diagram-header-title">
                                    <i class="bi bi-award text-primary"></i>Phân Bổ Nhân Sự Theo Chức Vụ
                                </span>
                            </div>
                            <div class="diagram-canvas-wrapper">
                                <canvas id="chartChucVuNhanSu"></canvas>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-6">
                        <div class="diagram-panel-card h-100">
                            <div class="diagram-header">
                                <span class="diagram-header-title">
                                    <i class="bi bi-people text-primary"></i>Tỷ Lệ Sĩ Số / Chỉ Tiêu Các Lớp
                                </span>
                            </div>
                            <div class="diagram-canvas-wrapper">
                                <canvas id="chartSiSoLopHoc"></canvas>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (laSuperAdmin || laAdmin)
        {
            <div class="card shadow-sm border-0" id="pnlHoatDongGanDay">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="mb-0 text-primary fw-bold"><i class="bi bi-clock-history me-2"></i>Nhật Ký Kiểm Toán Hệ Thống Gần Đây</h6>
                    <a href="NhatKy" class="btn btn-sm btn-outline-primary" id="btnXemTatCaNhatKy">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="dgvHoatDongGanDay">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-3">Thời điểm</th>
                                    <th>Người thực hiện</th>
                                    <th>Hành động</th>
                                    <th>Bảng dữ liệu</th>
                                    <th>Khóa bản ghi</th>
                                    <th>Kết quả</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (hoatDongGanDay.Count == 0)
                                {
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Chưa có hoạt động nào được ghi nhận</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in hoatDongGanDay)
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small">@item.ThoiDiem.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                            <td class="fw-semibold">@item.NguoiThucHien</td>
                                            <td><span class="badge bg-primary">@item.HanhDong</span></td>
                                            <td><code>@item.BangDuLieu</code></td>
                                            <td><span class="badge bg-light text-dark border">@(item.KhoaBanGhi ?? "-")</span></td>
                                            <td>
                                                @if (item.KetQua == "Thành công")
                                                {
                                                    <span class="badge bg-success">Thành công</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">@item.KetQua</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private int tongSoKhoa;
    private int tongSoBoMon;
    private int tongSoLop;
    private int tongSoHocVien;
    private int tongSoNhanSu;
    private int tongSoMonHoc;

    private string hoTenNguoiDung = "Cán bộ / Học viên";
    private string tenWorkspace = "WORKSPACE NGHIỆP VỤ";
    private string moTaWorkspace = "Tổng quan dữ liệu đào tạo Học viện An ninh Nhân dân (C500)";
    private string? maNhanSuLienKet;
    private string? emailDangNhap;
    private bool laSuperAdmin;
    private bool laAdmin;
    private bool laGiaoVien;
    private bool laCanBo;
    private bool hienThiWorkspaceGiangVienRieng;

    private NhanSu? hoSoGiangVien;
    private int soMonGiangDayCaNhan;
    private int tongTinChiCaNhan;
    private int soLopChuNhiemCaNhan;
    private List<(LopHoc Lop, bool LaChuNhiem)> danhSachLopQuanLyCaNhan = new();

    private List<ThongKeKhoaItem> dsKhoa = new();
    private List<ThongKeLopItem> dsLop = new();
    private List<PhanCongGiangDay> danhSachPhanCongCaNhan = new();
    private List<NhatKyHeThong> hoatDongGanDay = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                emailDangNhap = user.Identity.Name ?? "";
                laSuperAdmin = user.IsInRole(VaiTroMacDinh.SuperAdmin);
                laAdmin = user.IsInRole(VaiTroMacDinh.QuanTriVien);
                laGiaoVien = user.IsInRole(VaiTroMacDinh.GiaoVien);
                laCanBo = user.IsInRole(VaiTroMacDinh.CanBo) || user.IsInRole(VaiTroMacDinh.QuanLyDaoTao);

                try
                {
                    using var scope = ScopeFactory.CreateScope();
                    var userManager = scope.ServiceProvider.GetRequiredService<UserManager<TaiKhoan>>();
                    var dbUser = await userManager.FindByEmailAsync(emailDangNhap);
                    if (dbUser != null)
                    {
                        hoTenNguoiDung = !string.IsNullOrWhiteSpace(dbUser.HoVaTen) ? dbUser.HoVaTen : emailDangNhap;
                        maNhanSuLienKet = dbUser.MaNhanSuLienKet;
                    }
                    else
                    {
                        hoTenNguoiDung = emailDangNhap;
                    }
                }
                catch
                {
                    hoTenNguoiDung = emailDangNhap;
                }
            }
        }

        var nhansus = await NhanSuDichVu.LayDanhSachAsync();
        var phancongs = await PhanCongDichVu.LayDanhSachAsync();

        // Tìm hồ sơ Nhân sự khớp theo MaNhanSuLienKet hoặc Email đăng nhập hoặc Họ tên
        if (!string.IsNullOrWhiteSpace(maNhanSuLienKet))
        {
            hoSoGiangVien = nhansus.FirstOrDefault(n => string.Equals(n.MaNhanSu, maNhanSuLienKet, StringComparison.OrdinalIgnoreCase));
        }
        if (hoSoGiangVien == null && !string.IsNullOrWhiteSpace(emailDangNhap))
        {
            hoSoGiangVien = nhansus.FirstOrDefault(n => string.Equals(n.Email, emailDangNhap, StringComparison.OrdinalIgnoreCase));
        }

        // Nếu là Giảng viên (hoặc tài khoản không phải Admin/Superadmin mà có hồ sơ Giảng viên khớp) -> Hiển thị Workspace Giảng viên gọn gàng
        if (!laSuperAdmin && !laAdmin && (laGiaoVien || hoSoGiangVien != null))
        {
            hienThiWorkspaceGiangVienRieng = true;
            hoSoGiangVien ??= nhansus.FirstOrDefault();

            if (hoSoGiangVien != null)
            {
                hoTenNguoiDung = hoSoGiangVien.HoVaTen;
                tenWorkspace = "GIẢNG VIÊN WORKSPACE";
                moTaWorkspace = $"Đơn vị: {hoSoGiangVien.Khoa?.TenKhoa ?? "Học viện C500"} • {hoSoGiangVien.BoMon?.TenBoMon ?? "Bộ môn chuyên ngành"} • Chức vụ: {hoSoGiangVien.ChucVu?.TenChucVu ?? "Giảng viên"}";

                danhSachPhanCongCaNhan = phancongs
                    .Where(p => p.NhanSuId == hoSoGiangVien.NhanSuId ||
                                (p.NhanSu != null && string.Equals(p.NhanSu.MaNhanSu, hoSoGiangVien.MaNhanSu, StringComparison.OrdinalIgnoreCase)))
                    .ToList();

                var cacMonUnique = danhSachPhanCongCaNhan
                    .Where(p => p.MonHoc != null)
                    .Select(p => p.MonHoc!)
                    .DistinctBy(m => m.MonHocId)
                    .ToList();

                soMonGiangDayCaNhan = cacMonUnique.Count;
                tongTinChiCaNhan = cacMonUnique.Sum(m => m.SoTinChi);

                danhSachLopQuanLyCaNhan = danhSachPhanCongCaNhan
                    .Where(p => p.LopHoc != null)
                    .GroupBy(p => p.LopHoc!.LopHocId)
                    .Select(g => (Lop: g.First().LopHoc!, LaChuNhiem: g.Any(x => x.LaChuNhiem)))
                    .ToList();

                soLopChuNhiemCaNhan = danhSachLopQuanLyCaNhan.Count(x => x.LaChuNhiem);
            }
            return;
        }

        // Ngược lại: Tải dữ liệu tổng hợp cho Superadmin / Admin / Cán bộ / User tra cứu
        if (laSuperAdmin)
        {
            tenWorkspace = "SUPERADMIN WORKSPACE";
            moTaWorkspace = "Toàn quyền quản trị hệ thống, xóa/cấp phát tài khoản và tùy biến trực tiếp cấu trúc Database (Live CRUD Studio)";
        }
        else if (laAdmin)
        {
            tenWorkspace = "ADMIN WORKSPACE";
            moTaWorkspace = "Quản trị đào tạo, tổ chức nhân sự và cấp phát tài khoản Giáo viên / Cán bộ";
        }
        else if (laCanBo)
        {
            tenWorkspace = "CÁN BỘ WORKSPACE";
            moTaWorkspace = "Quản lý lớp đào tạo, hồ sơ học viên và tiện ích nhập/xuất dữ liệu Excel";
        }
        else
        {
            tenWorkspace = "USER WORKSPACE (CHỈ XEM)";
            moTaWorkspace = "Không gian tra cứu thông tin đơn vị, chương trình đào tạo và thống kê tổng hợp";
        }

        var khoas = await KhoaDichVu.LayDanhSachAsync();
        var bomons = await BoMonDichVu.LayDanhSachAsync();
        var lophocs = await LopHocDichVu.LayDanhSachAsync();
        var hocviens = await HocVienDichVu.LayDanhSachAsync();
        var monhocs = await MonHocDichVu.LayDanhSachAsync();

        if (laSuperAdmin || laAdmin)
        {
            hoatDongGanDay = await NhatKyDichVu.LayDanhSachNhatKyAsync(null, null, 10);
        }

        tongSoKhoa = khoas.Count;
        tongSoBoMon = bomons.Count;
        tongSoLop = lophocs.Count;
        tongSoHocVien = hocviens.Count;
        tongSoNhanSu = nhansus.Count;
        tongSoMonHoc = monhocs.Count;

        foreach (var k in khoas)
        {
            dsKhoa.Add(new ThongKeKhoaItem
            {
                TenKhoa = k.TenKhoa,
                SoLop = k.LopHocs?.Count ?? 0,
                SoHocVien = k.LopHocs?.Sum(l => l.HocViens?.Count ?? 0) ?? 0,
                SoNhanSu = k.NhanSus?.Count ?? 0
            });
        }

        foreach (var l in lophocs.Take(10))
        {
            dsLop.Add(new ThongKeLopItem
            {
                TenLop = l.TenLop,
                SoHocVien = l.HocViens?.Count ?? 0,
                SoLuongToiDa = l.SoLuongToiDa
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !hienThiWorkspaceGiangVienRieng)
        {
            try
            {
                var khoasJson = System.Text.Json.JsonSerializer.Serialize(dsKhoa);
                var lopsJson = System.Text.Json.JsonSerializer.Serialize(dsLop);
                await JSRuntime.InvokeVoidAsync("khoiTaoBieuDoDashboard", khoasJson, lopsJson);
            }
            catch
            {
            }
        }
    }
}
