@page "/NhanSu"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject INhanSuDichVu NhanSuDichVu
@inject IKhoaDichVu KhoaDichVu
@inject IBoMonDichVu BoMonDichVu
@inject IChucVuDichVu ChucVuDichVu
@inject ITrinhDoChuyenMonDichVu TrinhDoDichVu
@inject ITruongTuyChinhDichVu TruongTuyChinhDichVu

<PageTitle>Cán bộ, giảng viên | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachNhanSu">
    <TieuDeTrang PhanHe="Tổ chức - Cán bộ" TieuDe="Cán bộ, giảng viên" BieuTuong="bi-person-vcard"
                 MoTa="Hồ sơ theo Khoa → Bộ môn. Cơ cấu lãnh đạo (Trưởng/Phó khoa, Trưởng bộ môn) được kiểm soát số lượng tự động.">
        <a href="Excel/XuatDuLieu?module=NhanSu" class="btn btn-outline-primary btn-sm" id="btnXuatExcel"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        @if (_coQuyenGhiVung)
        {
            <a href="QuanTriDuLieu?bang=NhanSu" class="btn btn-primary btn-sm" id="btnChinhSuaDuLieu" title="Thêm, sửa, xóa, nhập Excel tại trang Dữ liệu &amp; danh mục"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa dữ liệu</a>
        }
    </TieuDeTrang>

    <div class="the-thong-ke-nho">
        <div><span>Tổng cán bộ</span><strong>@_tatCa.Count</strong></div>
        <div><span>Đang làm việc</span><strong>@_tatCa.Count(n => n.CoHoatDong)</strong></div>
        <div><span>Tiến sĩ</span><strong>@_tatCa.Count(n => n.TrinhDoChuyenMon?.MaTrinhDo == "TD_TS")</strong></div>
        <div><span>GS / PGS</span><strong>@_tatCa.Count(n => !string.IsNullOrEmpty(n.HocHam))</strong></div>
        <div><span>Chưa gán bộ môn</span><strong class="text-warning">@_tatCa.Count(n => n.BoMonId == null)</strong></div>
    </div>

    <div class="khung-danh-sach">
        <div class="thanh-cong-cu" id="pnlBoLoc">
            <div class="o-tim-kiem">
                <i class="bi bi-search"></i>
                <input class="form-control" id="txtTimKiem" placeholder="Tìm mã, họ tên, chức vụ, cấp bậc, chuyên môn..." value="@_tuKhoa" @oninput="DoiTuKhoaAsync" />
            </div>
            <RadzenDropDown TValue="int?" Data="@_danhSachKhoa" TextProperty="TenKhoa" ValueProperty="KhoaId" @bind-Value="_khoaLoc" Change="@(_ => DoiKhoaAsync())" AllowClear="true" AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" Placeholder="Tất cả khoa" class="bo-loc" id="cboChonKhoa" />
            <RadzenDropDown TValue="int?" Data="@BoMonTheoKhoa" TextProperty="TenBoMon" ValueProperty="BoMonId" @bind-Value="_boMonLoc" Change="@(_ => VeTrangDauAsync())" AllowClear="true" AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" Placeholder="Tất cả bộ môn" class="bo-loc" id="cboChonBoMon" />
            <RadzenDropDown TValue="int?" Data="@_danhSachChucVu" TextProperty="TenChucVu" ValueProperty="ChucVuId" @bind-Value="_chucVuLoc" Change="@(_ => VeTrangDauAsync())" AllowClear="true" Placeholder="Tất cả chức vụ" class="bo-loc bo-loc-hep" id="cboChucVu" />
            <RadzenButton Text="Bỏ lọc" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="BoLocAsync" id="btnBoLoc" />
        </div>

        <p class="dem-ket-qua" role="status" id="lblKetQua">Kết quả phù hợp: <strong>@DanhSachHienThi.Count() / @_tatCa.Count</strong></p>

        <RadzenDataGrid @ref="_bang" TItem="NhanSu" Data="@DanhSachHienThi" IsLoading="@DangTai" AllowPaging="true" PageSize="20" ShowPagingSummary="true" PagingSummaryFormat="Trang {0}/{1} · {2} hồ sơ"
                        AllowSorting="true" AllowColumnResize="true" EmptyText="Không có cán bộ phù hợp." class="bang-du-lieu" id="dgvDanhSachNhanSu">
            <Columns>
                <RadzenDataGridColumn TItem="NhanSu" Title="STT" Width="60px" Sortable="false" TextAlign="TextAlign.Center"><Template Context="n">@((_bang?.View.ToList().IndexOf(n) ?? -1) + 1)</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="NhanSu" Property="MaNhanSu" Title="Mã CB" Width="100px"><Template Context="n"><span class="ma-ban-ghi">@n.MaNhanSu</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="NhanSu" Property="HoVaTen" Title="Họ và tên" Width="200px"><Template Context="n"><strong>@n.HoVaTen</strong> <NhanBanGhi NgayTao="n.NgayTao" NgayCapNhat="n.NgayCapNhat" /></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="NhanSu" Property="ChucVu.TenChucVu" Title="Chức vụ" Width="150px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="CapBacHam" Title="Cấp bậc hàm" Width="110px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="TrinhDoChuyenMon.TenTrinhDo" Title="Học vị" Width="95px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="HocHam" Title="Học hàm" Width="100px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="Khoa.TenKhoa" Title="Khoa" Width="190px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="BoMon.TenBoMon" Title="Bộ môn" Width="180px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="ChuyenMonDaoTao" Title="Chuyên môn" Width="170px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="SoDienThoai" Title="SĐT" Width="115px" />
                <RadzenDataGridColumn TItem="NhanSu" Property="QueQuan" Title="Quê quán" Width="110px" />
                @foreach (var truong in _truongTuyChinh)
                {
                    <RadzenDataGridColumn TItem="NhanSu" Title="@truong.TenHienThi" Width="120px" Sortable="false">
                        <Template Context="n">
                            @{ var giaTri = LayGiaTriTuyChinh(n, truong.MaTruong); }
                            @(string.IsNullOrEmpty(giaTri) ? "—" : giaTri)
                        </Template>
                    </RadzenDataGridColumn>
                }
                <RadzenDataGridColumn TItem="NhanSu" Property="TrangThai" Title="Trạng thái" Width="120px">
                    <Template Context="n"><span class="chip-trang-thai @(n.CoHoatDong ? "tot" : "tat")">@n.TrangThai</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="NhanSu" Title="Thao tác" Width="125px" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="n">
                        <div class="o-thao-tac">
                            <RadzenButton Icon="visibility" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => XemChiTietAsync(n))" title="Xem chi tiết" id="@($"btnXem_{n.NhanSuId}")" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private const string TenBang = "NhanSu";
    private RadzenDataGrid<NhanSu>? _bang;
    private List<NhanSu> _tatCa = [];
    private List<Khoa> _danhSachKhoa = [];
    private List<BoMon> _danhSachBoMon = [];
    private List<ChucVu> _danhSachChucVu = [];
    private List<TrinhDoChuyenMon> _danhSachTrinhDo = [];
    private List<TruongTuyChinh> _truongTuyChinh = [];
    private Dictionary<string, Dictionary<string, string>> _giaTriTuyChinh = new();
    private string _tuKhoa = string.Empty;
    private int? _khoaLoc;
    private int? _boMonLoc;
    private int? _chucVuLoc;
    private bool _coQuyenGhiVung;

    /// <summary>Lọc sẵn theo khoa (?khoa=ID).</summary>
    [SupplyParameterFromQuery(Name = "khoa")]
    public int? KhoaTuDuongDan { get; set; }

    /// <summary>Lọc sẵn theo bộ môn (?bomon=ID).</summary>
    [SupplyParameterFromQuery(Name = "bomon")]
    public int? BoMonTuDuongDan { get; set; }

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = [TenBang, "Khoa", "BoMon", "ChucVu"];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        _khoaLoc = KhoaTuDuongDan ?? _khoaLoc;
        _boMonLoc = BoMonTuDuongDan ?? _boMonLoc;
    }

    private IEnumerable<BoMon> BoMonTheoKhoa => _danhSachBoMon.Where(b => _khoaLoc is null || b.KhoaId == _khoaLoc);

    private IReadOnlyList<Khoa> KhoaDuocGhi => _danhSachKhoa.Where(k => NguoiDung.CoQuyenGhi(VungQuanLy.ToChuc, k.KhoaId)).ToList();

    private IEnumerable<NhanSu> DanhSachHienThi => _tatCa.Where(n =>
        (_khoaLoc is null || n.KhoaId == _khoaLoc) && (_boMonLoc is null || n.BoMonId == _boMonLoc) && (_chucVuLoc is null || n.ChucVuId == _chucVuLoc) &&
        (QuyTacNghiepVu.ChuaTuKhoa(n.MaNhanSu, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(n.HoVaTen, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(n.ChucVu?.TenChucVu, _tuKhoa) ||
         QuyTacNghiepVu.ChuaTuKhoa(n.CapBacHam, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(n.ChuyenMonDaoTao, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(n.QueQuan, _tuKhoa)));

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync()
    {
        _danhSachKhoa = await KhoaDichVu.LayDanhSachAsync();
        _danhSachBoMon = await BoMonDichVu.LayDanhSachAsync();
        _danhSachChucVu = await ChucVuDichVu.LayDanhSachAsync(coHoatDong: true);
        _danhSachTrinhDo = await TrinhDoDichVu.LayDanhSachAsync(coHoatDong: true);
        _truongTuyChinh = await TruongTuyChinhDichVu.LayDinhNghiaAsync(TenBang);
        _giaTriTuyChinh = await TruongTuyChinhDichVu.LayGiaTriAsync(TenBang);
        _tatCa = (await NhanSuDichVu.LayDanhSachAsync())
            .OrderBy(n => QuyTacNghiepVu.KhoaSapXepTen(n.HoVaTen), StringComparer.Ordinal)
            .ToList();
        _coQuyenGhiVung = NguoiDung.LaQuanTri || (NguoiDung.VaiTro == VaiTroMacDinh.QuanLy && NguoiDung.VungQuanLy == VungQuanLy.ToChuc);
    }

    private string LayGiaTriTuyChinh(NhanSu n, string maTruong) =>
        _giaTriTuyChinh.TryGetValue(n.NhanSuId.ToString(), out var dong) && dong.TryGetValue(maTruong, out var giaTri) ? giaTri : string.Empty;

    private async Task DoiTuKhoaAsync(ChangeEventArgs e)
    {
        _tuKhoa = e.Value?.ToString() ?? string.Empty;
        await VeTrangDauAsync();
    }

    private async Task DoiKhoaAsync()
    {
        if (_boMonLoc.HasValue && !BoMonTheoKhoa.Any(b => b.BoMonId == _boMonLoc))
        {
            _boMonLoc = null;
        }

        await VeTrangDauAsync();
    }

    private async Task BoLocAsync()
    {
        _tuKhoa = string.Empty;
        _khoaLoc = null;
        _boMonLoc = null;
        _chucVuLoc = null;
        await VeTrangDauAsync();
    }

    private async Task VeTrangDauAsync()
    {
        if (_bang is not null)
        {
            await _bang.FirstPage(true);
        }
    }





    private Task XemChiTietAsync(NhanSu n)
    {
        var cacTruong = new List<(string, string?)>
        {
            ("Mã cán bộ", n.MaNhanSu), ("Họ và tên", n.HoVaTen), ("Ngày sinh", n.NgaySinh.ToString("dd/MM/yyyy")), ("Giới tính", n.GioiTinh),
            ("Quê quán", n.QueQuan), ("Khoa", n.Khoa?.TenKhoa), ("Bộ môn", n.BoMon?.TenBoMon), ("Chức vụ", n.ChucVu?.TenChucVu),
            ("Cấp bậc hàm", n.CapBacHam), ("Học vị", n.TrinhDoChuyenMon?.TenTrinhDo), ("Học hàm", n.HocHam), ("Chuyên môn", n.ChuyenMonDaoTao),
            ("Email", n.Email), ("Số điện thoại", n.SoDienThoai), ("Số CCCD", n.SoCCCD), ("Địa chỉ", n.DiaChi),
            ("Ngày vào làm", n.NgayVaoLam?.ToString("dd/MM/yyyy")), ("Trạng thái", n.TrangThai),
            ("Phân công giảng dạy", $"{n.PhanCongGiangDays.Count} phân công"), ("Ghi chú", n.GhiChu),
            ("Cập nhật gần nhất", n.NgayCapNhat?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") + (n.NguoiCapNhat is null ? string.Empty : $" bởi {n.NguoiCapNhat}"))
        };
        cacTruong.AddRange(_truongTuyChinh.Select(t => (t.TenHienThi, (string?)LayGiaTriTuyChinh(n, t.MaTruong))));

        return HopThoai.OpenAsync<ChiTietHoSo>($"Hồ sơ cán bộ {n.MaNhanSu}",
            new Dictionary<string, object?>
            {
                [nameof(ChiTietHoSo.CacTruong)] = cacTruong,
                [nameof(ChiTietHoSo.GhiChuQuyen)] = NguoiDung.CoQuyenGhi(VungQuanLy.ToChuc, n.KhoaId) ? null : "CCCD, SĐT, địa chỉ và ngày sinh đầy đủ đã được che vì tài khoản không quản lý khoa của cán bộ này."
            },
            new DialogOptions { Width = "660px", CloseDialogOnOverlayClick = true });
    }
}
