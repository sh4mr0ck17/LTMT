@page "/CayToChuc"
@inject IKhoaDichVu KhoaDichVu

<PageTitle>Sơ Đồ Cây Tổ Chức Đa Nhánh - C500</PageTitle>

<div class="container-fluid px-3 px-md-4 py-3" id="pnlCayToChuc">
    <!-- Thanh tiêu đề Sơ đồ cây đa nhánh -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center bg-white border rounded-3 px-4 py-3 mb-4 shadow-sm">
        <div>
            <h5 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-diagram-3-fill me-2"></i>Sơ Đồ Cây Tổ Chức Học Viện (Multi-Branch Org Tree)
            </h5>
            <span class="text-muted small">Cấu trúc phân nhánh: Ban Giám Đốc &rarr; Các Khoa Đào Tạo &rarr; Tách 3 nhánh độc lập (Bộ Môn • Lớp Học • Đội Ngũ Giảng Viên)</span>
        </div>
        <div class="d-flex gap-2 mt-2 mt-md-0">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnMoRongTatCa" @onclick="() => SetAllExpand(true)">
                <i class="bi bi-arrows-expand me-1"></i>Mở Rộng Toàn Bộ Nhánh
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnThuGonTatCa" @onclick="() => SetAllExpand(false)">
                <i class="bi bi-arrows-collapse me-1"></i>Thu Gọn Các Nhánh
            </button>
        </div>
    </div>

    @if (danhSachKhoa == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang dựng sơ đồ cây tổ chức đa nhánh...</p>
        </div>
    }
    else
    {
        <!-- SƠ ĐỒ CÂY PHÂN CẤP ĐA NHÁNH (ROOT -> KHOA -> TÁCH 3 NHÁNH CON NGANG: BỘ MÔN | LỚP HỌC | GIẢNG VIÊN) -->
        <div class="org-tree-Workspace bg-white border rounded-3 shadow-sm">
            <div class="org-tree" id="treeSoDoToChuc">
                <!-- CẤP 1: NODE GỐC BAN GIÁM ĐỐC HỌC VIỆN -->
                <div class="org-root-node">
                    <div class="d-flex align-items-center justify-content-center gap-3">
                        <img src="images/logo_badge.png" alt="Logo C500" class="logo-cand-nav" />
                        <div class="text-start">
                            <div class="badge bg-light text-primary mb-1">CẤP CHỈ HUY CAO NHẤT</div>
                            <h6 class="mb-0 fw-bold text-white">BAN GIÁM ĐỐC HỌC VIỆN AN NINH NHÂN DÂN (C500)</h6>
                            <small class="text-white-50">@danhSachKhoa.Count Khoa đào tạo • @danhSachKhoa.Sum(k => k.BoMons?.Count ?? 0) Bộ môn • @danhSachKhoa.Sum(k => k.LopHocs?.Count ?? 0) Lớp học</small>
                        </div>
                    </div>
                </div>

                <!-- Trục dọc nối từ Ban Giám Đốc xuống hàng ngang các Khoa -->
                <div class="org-vertical-stem"></div>

                <!-- CẤP 2: HÀNG NHÁNH NGANG CÁC KHOA ĐÀO TẠO -->
                <div class="org-branches-row">
                    @foreach (var khoa in danhSachKhoa)
                    {
                        bool isExpanded = expandedMap.ContainsKey(khoa.KhoaId) && expandedMap[khoa.KhoaId];
                        int soBoMon = khoa.BoMons?.Count ?? 0;
                        int soLop = khoa.LopHocs?.Count ?? 0;
                        int soCanBo = khoa.NhanSus?.Count ?? 0;

                        <div class="org-branch-col">
                            <!-- NODE KHOA -->
                            <div class="org-khoa-card">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-primary font-monospace">@khoa.MaKhoa</span>
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 px-2"
                                            @onclick="() => ToggleKhoa(khoa.KhoaId)"
                                            title="Đóng / Mở 3 nhánh trực thuộc của @khoa.TenKhoa">
                                        <i class="bi @(isExpanded ? "bi-dash-lg" : "bi-plus-lg")"></i>
                                    </button>
                                </div>
                                <h6 class="fw-bold text-primary mb-1">@khoa.TenKhoa</h6>
                                <div class="text-muted small mb-2">
                                    <i class="bi bi-geo-alt me-1"></i>@(khoa.DiaDiem ?? "Học viện C500")
                                </div>
                                <div class="d-flex justify-content-between pt-2 border-top small">
                                    <span class="badge bg-light text-primary border">@soBoMon Bộ môn</span>
                                    <span class="badge bg-light text-primary border">@soLop Lớp học</span>
                                    <span class="badge bg-light text-primary border">@soCanBo Giảng viên</span>
                                </div>
                            </div>

                            <!-- CẤP 3: TÁCH THÀNH 3 NHÁNH CON SONG SONG DƯỚI MỖI KHOA (KHÔNG GỘP CHUNG 1 CỘT THẲNG) -->
                            @if (isExpanded)
                            {
                                <div class="org-khoa-fork-stem"></div>
                                <div class="org-khoa-children-fork">
                                    <!-- NHÁNH CON 1: KHỐI BỘ MÔN CHUYÊN NGÀNH -->
                                    <div class="org-sub-branch">
                                        <div class="org-sub-branch-header">
                                            <i class="bi bi-diagram-2-fill me-1"></i>Bộ Môn (@soBoMon)
                                        </div>
                                        <div class="org-sub-branch-stem"></div>
                                        <div class="org-sub-leaves">
                                            @if (khoa.BoMons == null || khoa.BoMons.Count == 0)
                                            {
                                                <div class="org-leaf-node text-muted text-center">Chưa có bộ môn</div>
                                            }
                                            else
                                            {
                                                @foreach (var bm in khoa.BoMons)
                                                {
                                                    <div class="org-leaf-node">
                                                        <div class="fw-semibold text-primary">@bm.TenBoMon</div>
                                                        <div class="text-muted" style="font-size: 0.7rem;">Mã: <code>@bm.MaBoMon</code></div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- NHÁNH CON 2: KHỐI LỚP ĐÀO TẠO -->
                                    <div class="org-sub-branch">
                                        <div class="org-sub-branch-header">
                                            <i class="bi bi-mortarboard-fill me-1"></i>Lớp Học (@soLop)
                                        </div>
                                        <div class="org-sub-branch-stem"></div>
                                        <div class="org-sub-leaves">
                                            @if (khoa.LopHocs == null || khoa.LopHocs.Count == 0)
                                            {
                                                <div class="org-leaf-node text-muted text-center">Chưa có lớp học</div>
                                            }
                                            else
                                            {
                                                @foreach (var lop in khoa.LopHocs)
                                                {
                                                    <div class="org-leaf-node">
                                                        <div class="fw-semibold text-dark">@lop.TenLop</div>
                                                        <div class="d-flex justify-content-between align-items-center mt-1" style="font-size: 0.7rem;">
                                                            <code>@lop.MaLop</code>
                                                            <span class="badge bg-primary">@lop.NienKhoa</span>
                                                        </div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <!-- NHÁNH CON 3: KHỐI GIẢNG VIÊN & CÁN BỘ -->
                                    <div class="org-sub-branch">
                                        <div class="org-sub-branch-header">
                                            <i class="bi bi-people-fill me-1"></i>Giảng Viên (@soCanBo)
                                        </div>
                                        <div class="org-sub-branch-stem"></div>
                                        <div class="org-sub-leaves">
                                            @if (khoa.NhanSus == null || khoa.NhanSus.Count == 0)
                                            {
                                                <div class="org-leaf-node text-muted text-center">Chưa có cán bộ</div>
                                            }
                                            else
                                            {
                                                @foreach (var ns in khoa.NhanSus.Take(5))
                                                {
                                                    <div class="org-leaf-node">
                                                        <a href="NhanSu/ChiTiet/@ns.NhanSuId" class="fw-semibold text-decoration-none text-primary d-block">@ns.HoVaTen</a>
                                                        <div class="text-muted" style="font-size: 0.7rem;">@(ns.ChucVu?.TenChucVu ?? "Giảng viên") • <code>@ns.MaNhanSu</code></div>
                                                    </div>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Khoa>? danhSachKhoa;
    private Dictionary<int, bool> expandedMap = new();

    protected override async Task OnInitializedAsync()
    {
        danhSachKhoa = await KhoaDichVu.LayDanhSachAsync();
        if (danhSachKhoa != null)
        {
            foreach (var k in danhSachKhoa)
            {
                expandedMap[k.KhoaId] = true;
            }
        }
    }

    private void ToggleKhoa(int khoaId)
    {
        if (expandedMap.ContainsKey(khoaId))
        {
            expandedMap[khoaId] = !expandedMap[khoaId];
        }
        else
        {
            expandedMap[khoaId] = true;
        }
    }

    private void SetAllExpand(bool expand)
    {
        if (danhSachKhoa == null) return;
        foreach (var k in danhSachKhoa)
        {
            expandedMap[k.KhoaId] = expand;
        }
    }
}
