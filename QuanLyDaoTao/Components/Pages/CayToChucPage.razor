@page "/CayToChuc"
@inject IKhoaDichVu KhoaDichVu

<PageTitle>Sơ Đồ Cây Tổ Chức Đào Tạo - C500</PageTitle>

<div class="container-fluid px-4 py-3" id="pnlCayToChuc">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-diagram-3-fill me-2"></i>Sơ Đồ Cây Tổ Chức Đào Tạo (C500)
            </h4>
            <span class="text-muted small">Cấu trúc phân cấp đơn vị: Ban Giám Đốc &rarr; Khoa &rarr; Bộ Môn / Lớp Học &rarr; Nhân Sự &amp; Học Viên</span>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-outline-primary btn-sm" id="btnMoRongTatCa" @onclick="() => SetAllExpand(true)">
                <i class="bi bi-arrows-expand me-1"></i>Mở Rộng Tất Cả
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnThuGonTatCa" @onclick="() => SetAllExpand(false)">
                <i class="bi bi-arrows-collapse me-1"></i>Thu Gọn Tất Cả
            </button>
        </div>
    </div>

    <!-- Node Cấp cao nhất: Ban Giám Đốc Học viện An ninh Nhân dân -->
    <div class="cand-banner-header mb-4 p-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center">
            <img src="images/logo_badge.png" alt="Logo Học viện An ninh Nhân dân" class="logo-cand-md me-3" />
            <div>
                <h5 class="mb-0 fw-bold text-white">BAN GIÁM ĐỐC HỌC VIỆN AN NINH NHÂN DÂN (C500)</h5>
                <small style="color: #F2F0A5;">Cơ quan chỉ huy, điều hành cao nhất quản lý các Khoa, Bộ môn và Đơn vị đào tạo</small>
            </div>
        </div>
        <div>
            <span class="badge badge-cand-gold fs-6 px-3 py-2">@(danhSachKhoa?.Count ?? 0) Khoa Trực Thuộc</span>
        </div>
    </div>

    @if (danhSachKhoa == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="text-muted mt-2">Đang tải sơ đồ cây tổ chức...</p>
        </div>
    }
    else
    {
        <div class="accordion" id="accordionCayToChuc">
            @foreach (var khoa in danhSachKhoa)
            {
                bool isExpanded = expandedMap.ContainsKey(khoa.KhoaId) && expandedMap[khoa.KhoaId];
                <div class="accordion-item shadow-sm border-0 mb-3 rounded overflow-hidden">
                    <h2 class="accordion-header">
                        <button class="accordion-button @(isExpanded ? "" : "collapsed") bg-white text-dark py-3" type="button"
                                @onclick="() => ToggleKhoa(khoa.KhoaId)">
                            <div class="d-flex align-items-center justify-content-between w-100 me-3">
                                <div class="d-flex align-items-center">
                                    <span class="badge bg-primary font-monospace fs-6 me-3">@khoa.MaKhoa</span>
                                    <span class="fw-bold fs-5 text-primary">@khoa.TenKhoa</span>
                                    @if (!khoa.CoHoatDong)
                                    {
                                        <span class="badge bg-secondary ms-2">Đã khóa</span>
                                    }
                                </div>
                                <div class="d-flex gap-2">
                                    <span class="badge bg-info text-dark"><i class="bi bi-diagram-2 me-1"></i>@(khoa.BoMons?.Count ?? 0) Bộ môn</span>
                                    <span class="badge bg-success"><i class="bi bi-people me-1"></i>@(khoa.LopHocs?.Count ?? 0) Lớp</span>
                                    <span class="badge bg-primary"><i class="bi bi-person-lines-fill me-1"></i>@(khoa.NhanSus?.Count ?? 0) Cán bộ</span>
                                </div>
                            </div>
                        </button>
                    </h2>
                    <div class="accordion-collapse collapse @(isExpanded ? "show" : "")">
                        <div class="accordion-body bg-light p-4">
                            <div class="row g-4">
                                <!-- Bộ môn -->
                                <div class="col-lg-6">
                                    <div class="card shadow-sm border-0 h-100">
                                        <div class="card-header bg-white py-2 border-bottom d-flex justify-content-between align-items-center">
                                            <h6 class="mb-0 text-primary fw-bold">
                                                <i class="bi bi-diagram-2-fill me-2"></i>Bộ Môn Trực Thuộc (@(khoa.BoMons?.Count ?? 0))
                                            </h6>
                                            <a href="BoMon" class="btn btn-sm btn-outline-primary py-0">Xem tất cả</a>
                                        </div>
                                        <div class="card-body p-0">
                                            @if (khoa.BoMons == null || khoa.BoMons.Count == 0)
                                            {
                                                <div class="p-3 text-center text-muted small">Chưa có bộ môn trực thuộc</div>
                                            }
                                            else
                                            {
                                                <ul class="list-group list-group-flush">
                                                    @foreach (var bm in khoa.BoMons)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <span class="fw-semibold text-dark">@bm.TenBoMon</span>
                                                                <span class="badge bg-light text-dark border font-monospace ms-1">@bm.MaBoMon</span>
                                                            </div>
                                                            <a href="BoMon" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Lớp học -->
                                <div class="col-lg-6">
                                    <div class="card shadow-sm border-0 h-100">
                                        <div class="card-header bg-white py-2 border-bottom d-flex justify-content-between align-items-center">
                                            <h6 class="mb-0 text-success fw-bold">
                                                <i class="bi bi-people-fill me-2"></i>Lớp Học Đào Tạo (@(khoa.LopHocs?.Count ?? 0))
                                            </h6>
                                            <a href="LopHoc" class="btn btn-sm btn-outline-success py-0">Xem tất cả</a>
                                        </div>
                                        <div class="card-body p-0">
                                            @if (khoa.LopHocs == null || khoa.LopHocs.Count == 0)
                                            {
                                                <div class="p-3 text-center text-muted small">Chưa có lớp học trực thuộc</div>
                                            }
                                            else
                                            {
                                                <ul class="list-group list-group-flush">
                                                    @foreach (var l in khoa.LopHocs)
                                                    {
                                                        <li class="list-group-item d-flex justify-content-between align-items-center">
                                                            <div>
                                                                <span class="fw-semibold text-dark">@l.TenLop</span>
                                                                <span class="badge bg-light text-dark border font-monospace ms-1">@l.MaLop</span>
                                                                <div class="text-muted small">Niên khóa: @l.NienKhoa</div>
                                                            </div>
                                                            <a href="LopHoc" class="btn btn-sm btn-outline-info"><i class="bi bi-eye"></i></a>
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Khoa>? danhSachKhoa;
    private Dictionary<int, bool> expandedMap = new();

    protected override async Task OnInitializedAsync()
    {
        danhSachKhoa = await KhoaDichVu.LayDanhSachAsync();
        if (danhSachKhoa != null && danhSachKhoa.Count > 0)
        {
            expandedMap[danhSachKhoa[0].KhoaId] = true;
        }
    }

    private void ToggleKhoa(int id)
    {
        if (expandedMap.ContainsKey(id))
        {
            expandedMap[id] = !expandedMap[id];
        }
        else
        {
            expandedMap[id] = true;
        }
    }

    private void SetAllExpand(bool open)
    {
        if (danhSachKhoa == null) return;
        foreach (var k in danhSachKhoa)
        {
            expandedMap[k.KhoaId] = open;
        }
    }
}
