@page "/CayToChuc"
@using QuanLyDaoTao.Models.ToChuc

<PageTitle>Cây tổ chức - C500</PageTitle>
<HeadContent><link rel="stylesheet" href="css/cay-to-chuc.css?v=3" /></HeadContent>

<div class="to-chuc container-fluid px-4 py-3" id="pnlCayToChuc" aria-busy="@_coDangTai.ToString().ToLowerInvariant()">
    <header class="tc-header">
        <div><h1 id="lblTieuDe">Cây tổ chức</h1><p>Nắm cơ cấu đơn vị, theo dõi nhân sự và các lớp trong cùng một nơi.</p></div>
        <div class="tc-cap-nhat">
            @if (_lanCapNhat.HasValue) { <small>Cập nhật @_lanCapNhat.Value.ToString("HH:mm:ss dd/MM/yyyy") (GMT+7)</small> }
            <button class="btn btn-outline-primary btn-sm" id="btnTaiLaiToChuc" disabled="@_coDangTai" @onclick="TaiDuLieuAsync"><i class="bi bi-arrow-clockwise" aria-hidden="true"></i> Làm mới</button>
        </div>
    </header>
    @if (_loiTaiDuLieu != null) { <div class="alert alert-danger" role="alert">@_loiTaiDuLieu Bấm “Làm mới” để thử lại.</div> }
    @if (_goc == null)
    {
        <div class="tc-trong" role="status">@(_coDangTai ? "Đang tải cơ cấu tổ chức…" : "Chưa tải được cơ cấu tổ chức.")</div>
    }
    else
    {
        <div class="tc-tong-quan" aria-label="Tổng quan toàn học viện">
            <div><i class="bi bi-building" aria-hidden="true"></i><strong>@_goc.SoKhoa</strong><span>Khoa</span></div>
            <div><i class="bi bi-diagram-2" aria-hidden="true"></i><strong>@_goc.SoBoMon</strong><span>Bộ môn</span></div>
            <div><i class="bi bi-mortarboard" aria-hidden="true"></i><strong>@_goc.SoLop</strong><span>Lớp học</span></div>
            <div><i class="bi bi-people" aria-hidden="true"></i><strong>@_goc.SoNhanSu</strong><span>Nhân sự</span></div>
            <div><i class="bi bi-person-badge" aria-hidden="true"></i><strong>@_goc.SoHocVien</strong><span>Học viên đang học</span></div>
        </div>
        <section class="tc-bo-loc" aria-label="Tìm kiếm và lọc cây tổ chức">
            <div class="tc-tim-kiem">
                <label for="txtTimKiemToChuc">Tìm trong cơ cấu</label>
                <div class="tc-o-tim"><i class="bi bi-search" aria-hidden="true"></i><input id="txtTimKiemToChuc" type="search" class="form-control" placeholder="Tên hoặc mã khoa, bộ môn, lớp, nhân sự…" @bind="_tuKhoa" @bind:event="oninput" @bind:after="ApDungBoLoc" /></div>
            </div>
            <div><label for="cboLoaiToChuc">Loại bản ghi</label><select id="cboLoaiToChuc" class="form-select" @bind="_loai" @bind:after="ApDungBoLoc"><option value="">Tất cả loại</option><option>Khoa</option><option>Bộ môn</option><option>Lớp học</option><option>Nhân sự</option></select></div>
            <div><label for="cboTrangThaiToChuc">Trạng thái</label><select id="cboTrangThaiToChuc" class="form-select" @bind="_trangThai" @bind:after="ApDungBoLoc"><option value="">Tất cả trạng thái</option><option value="hoat-dong">Đang hoạt động / công tác</option><option value="ngung">Ngừng hoạt động / đã nghỉ</option><option value="ra-soat">Cần rà soát phân đơn vị, sĩ số</option></select></div>
            <button id="btnXoaBoLocToChuc" class="btn btn-outline-secondary" disabled="@(!CoBoLoc)" @onclick="XoaBoLoc">Xóa lọc</button>
        </section>
        <div class="tc-ket-qua" role="status" aria-live="polite">
            @if (CoBoLoc) { <span><strong>@_nutKhop.Count</strong> bản ghi phù hợp. Giữ lại cấp trên để bạn thấy vị trí trong cơ cấu.</span> }
            else { <span>Kéo và thu phóng canvas để xem cơ cấu. Chọn một thẻ để theo dõi chi tiết.</span> }
            @if (_goc.SoCanRaSoat > 0) { <button class="tc-nut-ra-soat" id="btnLocCanRaSoat" @onclick="LocCanRaSoat"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @_goc.SoCanRaSoat bản ghi cần rà soát</button> }
        </div>
        <div class="tc-khong-gian tc-khong-gian-canvas @(_coHienChiTiet ? "tc-co-chi-tiet" : null)">
            <CanvasToChuc Goc="_goc" NutHienThi="_nutHienThi" NutMo="_nutMo" NutKhop="_nutKhop" DuongDanChon="_duongDanChon" KhoaNutChon="@_nutChon?.KhoaNut" CoBoLoc="CoBoLoc" LanCanKhung="_lanCanKhung" KhiChon="ChonNut" KhiDoiTrangThai="DoiTrangThaiNhanh" KhiMoTatCa="MoTatCa" KhiThuGon="ThuGon" />
            @if (_coHienChiTiet)
            {
            <section class="tc-chi-tiet" id="pnlChiTietToChuc" aria-labelledby="lblDonViDangChon">
                <div class="tc-dong-chi-tiet"><span>Thông tin đang chọn</span><button id="btnDongChiTietToChuc" type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => _coHienChiTiet = false" aria-label="Đóng chi tiết, mở rộng canvas"><i class="bi bi-x-lg" aria-hidden="true"></i></button></div>
                @if (_nutChon is { } nut)
                {
                    <nav class="tc-duong-dan" aria-label="Vị trí trong tổ chức"><ol>
                        @foreach (var cha in LayDuongDan(nut))
                        {
                            <li>@if (cha.KhoaNut == nut.KhoaNut) { <span aria-current="location">@cha.Ten</span> } else { <button type="button" @onclick="() => ChonNut(cha)">@cha.Ten</button> }</li>
                        }
                    </ol></nav>
                    <div class="tc-tieu-de-chi-tiet">
                        <div class="tc-bieu-tuong"><i class="bi @nut.BieuTuong" aria-hidden="true"></i></div>
                        <div class="tc-ten-chi-tiet">
                            <span class="tc-loai">@nut.Loai @if (!string.IsNullOrEmpty(nut.Ma)) { <span>/ @nut.Ma</span> }</span><h2 id="lblDonViDangChon">@nut.Ten</h2>
                            @if (!string.IsNullOrEmpty(nut.TrangThai)) { <span class="tc-trang-thai @(nut.CoHoatDong == true ? "tc-hoat-dong" : "tc-ngung")">@nut.TrangThai</span> }
                        </div>
                        @if (nut.DuongDan != null) { <a href="@nut.DuongDan" id="btnXemHoSoToChuc" class="btn btn-outline-primary btn-sm">Mở hồ sơ <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a> }
                    </div>
                    @if (!string.IsNullOrEmpty(nut.MoTa)) { <p class="tc-mo-ta">@nut.MoTa</p> }
                    @if (nut.CanhBao != null) { <div class="tc-canh-bao" role="note"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @nut.CanhBao</div> }
                    @if (nut.Loai != "Nhân sự")
                    {
                        <dl class="tc-thong-ke-nhanh">
                            @if (nut.Loai == "Học viện") { <div><dt>Khoa</dt><dd>@nut.SoKhoa</dd></div> }
                            @if (nut.Loai == "Học viện" || nut.Loai == "Khoa") { <div><dt>Bộ môn</dt><dd>@nut.SoBoMon</dd></div><div><dt>Lớp học</dt><dd>@nut.SoLop</dd></div> }
                            @if (nut.Loai == "Nhóm") { <div><dt>Mục trực thuộc</dt><dd>@nut.Con.Count</dd></div> }
                            @if (nut.Loai == "Học viện" || nut.Loai == "Khoa" || nut.Loai == "Bộ môn" || nut.SoNhanSu > 0) { <div><dt>Nhân sự</dt><dd>@nut.SoNhanSu</dd></div> }
                            @if (nut.Loai == "Học viện" || nut.Loai == "Khoa" || nut.Loai == "Lớp học" || nut.SoHocVien > 0) { <div><dt>Học viên đang học</dt><dd>@nut.SoHocVien</dd></div> }
                        </dl>
                        <p class="tc-pham-vi">Số liệu toàn nhánh, không đổi theo bộ lọc. Đơn vị và nhân sự tính mọi trạng thái; học viên chỉ tính đang học.</p>
                    }
                    @if (nut.SucChua.HasValue)
                    {
                        <div class="tc-si-so"><div><strong>Sĩ số lớp</strong><span>@nut.SiSo / @nut.SucChua học viên</span></div><progress max="@Math.Max(nut.SucChua.Value, nut.SiSo)" value="@nut.SiSo" aria-label="Sĩ số lớp"></progress><small>@(nut.SiSo > nut.SucChua ? $"Vượt {nut.SiSo - nut.SucChua} học viên" : $"Còn {nut.SucChua - nut.SiSo} chỗ")</small></div>
                    }
                    @if (nut.Con.Count > 0)
                    {
                        var cacCon = nut.Con.Where(n => _nutHienThi.Contains(n.KhoaNut)).ToList();
                        <div class="tc-danh-sach-header"><h3>Trực thuộc nhánh đang chọn</h3><span>@cacCon.Count / @nut.Con.Count mục</span></div>
                        @if (cacCon.Count == 0) { <p class="tc-trong">Không có mục trực thuộc phù hợp với bộ lọc hiện tại.</p> }
                        else
                        {
                            <div class="tc-bang-cuon"><table class="table tc-bang" id="dgvTrucThuocToChuc">
                                <thead><tr><th scope="col">Đơn vị / hồ sơ</th><th scope="col">Thông tin</th><th scope="col">Trạng thái</th></tr></thead>
                                <tbody>@foreach (var con in cacCon)
                                {
                                    <tr @key="con.KhoaNut">
                                        <td><button type="button" class="tc-lien-ket" @onclick="() => ChonNut(con)"><i class="bi @con.BieuTuong" aria-hidden="true"></i> @con.Ten</button><small>@con.Loai @con.Ma</small></td>
                                        <td>
                                            @if (con.Loai == "Lớp học") { <span>@con.SiSo / @con.SucChua học viên</span><small>@con.MoTa</small> }
                                            else if (con.Loai == "Nhân sự") { <span>@con.MoTa</span> }
                                            else if (con.Loai == "Khoa") { <span>@con.SoBoMon bộ môn, @con.SoLop lớp</span><small>@con.SoNhanSu nhân sự</small> }
                                            else if (con.Loai == "Bộ môn") { <span>@con.SoNhanSu nhân sự</span> }
                                            else { <span>@con.Con.Count mục trực thuộc</span> }
                                        </td>
                                        <td>@if (con.CanhBao != null) { <span class="tc-can-ra-soat">Cần rà soát</span> } else if (con.CoHoatDong.HasValue) { <span class="tc-trang-thai @(con.CoHoatDong == true ? "tc-hoat-dong" : "tc-ngung")">@con.TrangThai</span> } else { <span class="text-muted">Nhóm điều hướng</span> }</td>
                                    </tr>
                                }</tbody>
                            </table></div>
                        }
                    }
                    else if (nut.Loai != "Nhân sự" && nut.Loai != "Lớp học") { <div class="tc-trong"><i class="bi bi-folder2-open" aria-hidden="true"></i><strong>Chưa có dữ liệu trực thuộc</strong><span>Nhánh này hiện chưa có đơn vị hoặc nhân sự.</span></div> }
                }
                else { <div class="tc-trong"><strong id="lblDonViDangChon">Chọn một đơn vị hoặc hồ sơ</strong><span>Chi tiết và vị trí trong cơ cấu sẽ xuất hiện tại đây.</span></div> }
            </section>
            }
        </div>
    }
</div>
