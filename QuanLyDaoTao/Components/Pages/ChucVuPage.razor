@page "/ChucVu"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject IChucVuDichVu ChucVuDichVu
@inject NavigationManager DieuHuong

<PageTitle>Chức vụ | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachChucVu">
    <TieuDeTrang PhanHe="Tổ chức - Cán bộ" TieuDe="Danh mục chức vụ" BieuTuong="bi-award"
                 MoTa="Trang tra cứu (chỉ xem). Danh mục được chỉnh sửa tập trung tại “Dữ liệu & danh mục”. Chức vụ cán bộ. Mã CV_TK, CV_PK, CV_TBM, CV_PBM được hệ thống dùng để kiểm soát số lượng lãnh đạo khoa và bộ môn.">
        @if (NguoiDung.LaQuanTri)
        {
            <a href="QuanTriDuLieu?bang=ChucVu" class="btn btn-sm btn-outline-primary" id="btnSuaDanhMuc"><i class="bi bi-pencil-square me-1"></i>Sửa trong “Dữ liệu &amp; danh mục”</a>
        }
    </TieuDeTrang>

    <div class="khung-danh-sach">
        <div class="thanh-cong-cu">
            <div class="o-tim-kiem">
                <i class="bi bi-search"></i>
                <input class="form-control" id="txtTimKiem" placeholder="Tìm mã, tên chức vụ..." value="@_tuKhoa" @oninput="@(e => _tuKhoa = e.Value?.ToString() ?? string.Empty)" />
            </div>
        </div>
        <RadzenDataGrid TItem="ChucVu" Data="@DanhSachHienThi" IsLoading="@DangTai" AllowSorting="true" EmptyText="Không có chức vụ phù hợp." class="bang-du-lieu" id="dgvDanhSachChucVu">
            <Columns>
                <RadzenDataGridColumn TItem="ChucVu" Property="MaChucVu" Title="Mã" Width="120px"><Template Context="c"><span class="ma-ban-ghi">@c.MaChucVu</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChucVu" Property="TenChucVu" Title="Tên chức vụ" Width="200px"><Template Context="c"><strong>@c.TenChucVu</strong></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChucVu" Title="Giới hạn" Width="150px" Sortable="false">
                    <Template Context="c">
                        @if (NhanSuDichVu.ChiTieuLanhDao.TryGetValue(c.MaChucVu, out var chiTieu))
                        {
                            <span class="chip-pham-vi">Tối đa @chiTieu.ToiDa / @(chiTieu.PhamVi == "Khoa" ? "khoa" : "bộ môn")</span>
                        }
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChucVu" Title="Cán bộ" Width="90px" SortProperty="NhanSus.Count" TextAlign="TextAlign.Center"><Template Context="c">@c.NhanSus.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChucVu" Property="MoTa" Title="Mô tả" />
                <RadzenDataGridColumn TItem="ChucVu" Property="CoHoatDong" Title="Trạng thái" Width="110px">
                    <Template Context="c"><span class="chip-trang-thai @(c.CoHoatDong ? "tot" : "tat")">@(c.CoHoatDong ? "Đang dùng" : "Ngừng")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="ChucVu" Title="" Width="60px" Sortable="false" TextAlign="TextAlign.Center">
                    <Template Context="c">
                        <div class="o-thao-tac">
                            <RadzenButton Icon="badge" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => DieuHuong.NavigateTo("NhanSu"))" title="Xem cán bộ" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private List<ChucVu> _tatCa = [];
    private string _tuKhoa = string.Empty;

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = ["ChucVu"];

    private IEnumerable<ChucVu> DanhSachHienThi => _tatCa.Where(c => QuyTacNghiepVu.ChuaTuKhoa(c.MaChucVu, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(c.TenChucVu, _tuKhoa));

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync() => _tatCa = await ChucVuDichVu.LayDanhSachAsync();
}
