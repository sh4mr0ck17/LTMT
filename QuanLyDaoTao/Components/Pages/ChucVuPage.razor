@page "/ChucVu"
@inject IChucVuDichVu ChucVuDichVu

<PageTitle>Danh mục Chức vụ - C500</PageTitle>

<div class="container py-3" id="pnlDanhSachChucVu">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-award me-2"></i>Danh Mục Chức Vụ Công Tác (C500)
            </h4>
            <span class="text-muted small">Quản lý danh sách chức danh và vị trí lãnh đạo</span>
        </div>
        <a href="ChucVu/ThemMoi" class="btn btn-primary" id="btnThemChucVu">
            <i class="bi bi-plus-circle-fill me-1"></i>Thêm Mới Chức Vụ
        </a>
    </div>

    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="dgvDanhSachChucVu">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th style="width: 140px;">Mã Chức Vụ</th>
                            <th>Tên Chức Vụ</th>
                            <th>Mô Tả Nhiệm Vụ</th>
                            <th class="text-center" style="width: 110px;">Nhân Sự</th>
                            <th class="text-center" style="width: 120px;">Trạng Thái</th>
                            <th class="text-center" style="width: 140px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (danhSachChucVu == null || danhSachChucVu.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">Không tìm thấy chức vụ nào</td></tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var cv in danhSachChucVu)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td><span class="badge bg-primary bg-opacity-10 text-primary font-monospace fs-6">@cv.MaChucVu</span></td>
                                    <td class="fw-semibold">@cv.TenChucVu</td>
                                    <td class="text-muted small">@(cv.MoTa ?? "-")</td>
                                    <td class="text-center"><span class="badge bg-info text-dark">@(cv.NhanSus?.Count ?? 0)</span></td>
                                    <td class="text-center">
                                        <span class="badge @(cv.CoHoatDong ? "bg-success" : "bg-secondary")">
                                            @(cv.CoHoatDong ? "Hoạt động" : "Khóa")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="ChucVu/ChinhSua/@cv.ChucVuId" class="btn btn-outline-primary" id="btnSua_@cv.ChucVuId">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" id="btnXoa_@cv.ChucVuId" @onclick="() => XoaChucVu(cv.ChucVuId)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<ChucVu>? danhSachChucVu;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        danhSachChucVu = await ChucVuDichVu.LayDanhSachAsync();
    }

    private async Task XoaChucVu(int id)
    {
        try
        {
            await ChucVuDichVu.XoaChucVuAsync(id);
            await LoadData();
        }
        catch
        {
        }
    }
}
