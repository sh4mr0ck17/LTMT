@page "/MonHoc"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject IMonHocDichVu MonHocDichVu
@inject IBoMonDichVu BoMonDichVu
@inject NavigationManager DieuHuong

<PageTitle>Môn học | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachMonHoc">
    <TieuDeTrang PhanHe="Đào tạo" TieuDe="Môn học" BieuTuong="bi-journal-bookmark"
                 MoTa="Danh mục môn học, tín chỉ và số tiết; mỗi môn do một bộ môn phụ trách. Không xóa môn đang có phân công.">
        <a href="Excel/XuatDuLieu?module=MonHoc" class="btn btn-outline-primary btn-sm" id="btnXuatExcel"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        @if (_coQuyenGhi)
        {
            <a href="QuanTriDuLieu?bang=MonHoc" class="btn btn-primary btn-sm" id="btnChinhSuaDuLieu" title="Thêm, sửa, xóa, nhập Excel tại trang Dữ liệu &amp; danh mục"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa dữ liệu</a>
        }
    </TieuDeTrang>

    <div class="khung-danh-sach">
        <div class="thanh-cong-cu" id="pnlBoLoc">
            <div class="o-tim-kiem">
                <i class="bi bi-search"></i>
                <input class="form-control" id="txtTimKiem" placeholder="Tìm mã, tên môn học..." value="@_tuKhoa" @oninput="@(e => _tuKhoa = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <RadzenDropDown TValue="int?" Data="@_danhSachBoMon" TextProperty="TenBoMon" ValueProperty="BoMonId" @bind-Value="_boMonLoc" AllowClear="true" AllowFiltering="true"
                            FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" Placeholder="Tất cả bộ môn" class="bo-loc" id="cboChonBoMon" />
            <RadzenButton Text="Bỏ lọc" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => { _tuKhoa = string.Empty; _boMonLoc = null; })" id="btnBoLoc" />
        </div>

        <div class="the-thong-ke-nho">
            <div><span>môn</span><strong>@DanhSachHienThi.Count() / @_tatCa.Count</strong></div>
            <div><span>tín chỉ</span><strong>@DanhSachHienThi.Sum(m => m.SoTinChi)</strong></div>
            <div><span>tiết</span><strong>@DanhSachHienThi.Sum(m => m.SoTietLyThuyet + m.SoTietThucHanh)</strong></div>
            <div><span>chưa phân công</span><strong class="text-warning">@DanhSachHienThi.Count(m => m.PhanCongGiangDays.Count == 0)</strong></div>
        </div>

        <RadzenDataGrid TItem="MonHoc" Data="@DanhSachHienThi" IsLoading="@DangTai" AllowPaging="true" PageSize="20" AllowSorting="true" AllowColumnResize="true"
                        EmptyText="Không có môn học phù hợp." class="bang-du-lieu" id="dgvDanhSachMonHoc">
            <Columns>
                <RadzenDataGridColumn TItem="MonHoc" Property="MaMonHoc" Title="Mã môn" Width="110px"><Template Context="m"><span class="ma-ban-ghi">@m.MaMonHoc</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="MonHoc" Property="TenMonHoc" Title="Tên môn học" Width="260px"><Template Context="m"><strong>@m.TenMonHoc</strong></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="MonHoc" Property="SoTinChi" Title="Tín chỉ" Width="80px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="MonHoc" Property="SoTietLyThuyet" Title="LT" Width="70px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="MonHoc" Property="SoTietThucHanh" Title="TH" Width="70px" TextAlign="TextAlign.Center" />
                <RadzenDataGridColumn TItem="MonHoc" Property="BoMon.TenBoMon" Title="Bộ môn" Width="220px" />
                <RadzenDataGridColumn TItem="MonHoc" Title="Phân công" Width="95px" SortProperty="PhanCongGiangDays.Count" TextAlign="TextAlign.Center"><Template Context="m">@m.PhanCongGiangDays.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="MonHoc" Property="CoHoatDong" Title="Trạng thái" Width="110px">
                    <Template Context="m"><span class="chip-trang-thai @(m.CoHoatDong ? "tot" : "tat")">@(m.CoHoatDong ? "Đang dạy" : "Ngừng")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="MonHoc" Title="Thao tác" Width="125px" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="m">
                        <div class="o-thao-tac">
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private List<MonHoc> _tatCa = [];
    private List<BoMon> _danhSachBoMon = [];
    private string _tuKhoa = string.Empty;
    private int? _boMonLoc;
    private bool _coQuyenGhi;

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = ["MonHoc", "BoMon", "PhanCongGiangDay"];

    private IEnumerable<MonHoc> DanhSachHienThi => _tatCa.Where(m =>
        (_boMonLoc is null || m.BoMonId == _boMonLoc) &&
        (QuyTacNghiepVu.ChuaTuKhoa(m.MaMonHoc, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(m.TenMonHoc, _tuKhoa)));

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync()
    {
        _danhSachBoMon = await BoMonDichVu.LayDanhSachAsync();
        _tatCa = await MonHocDichVu.LayDanhSachAsync();
        _coQuyenGhi = NguoiDung.CoQuyenGhi(VungQuanLy.DaoTao, null);
    }



}
