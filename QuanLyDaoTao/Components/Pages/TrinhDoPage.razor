@page "/TrinhDoChuyenMon"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject ITrinhDoChuyenMonDichVu TrinhDoDichVu

<PageTitle>Trình độ chuyên môn | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachTrinhDo">
    <TieuDeTrang PhanHe="Tổ chức - Cán bộ" TieuDe="Trình độ chuyên môn" BieuTuong="bi-patch-check"
                 MoTa="Trang tra cứu (chỉ xem); chỉnh sửa tại “Dữ liệu & danh mục”. Danh mục học vị (Tiến sĩ, Thạc sĩ, Cử nhân...) dùng cho hồ sơ cán bộ.">
        @if (NguoiDung.LaQuanTri)
        {
            <a href="QuanTriDuLieu?bang=TrinhDoChuyenMon" class="btn btn-sm btn-outline-primary" id="btnSuaDanhMuc"><i class="bi bi-pencil-square me-1"></i>Sửa trong “Dữ liệu &amp; danh mục”</a>
        }
    </TieuDeTrang>

    <div class="khung-danh-sach">
        <RadzenDataGrid TItem="TrinhDoChuyenMon" Data="@_tatCa" IsLoading="@DangTai" AllowSorting="true" EmptyText="Chưa có trình độ." class="bang-du-lieu" id="dgvDanhSachTrinhDo">
            <Columns>
                <RadzenDataGridColumn TItem="TrinhDoChuyenMon" Property="MaTrinhDo" Title="Mã" Width="120px"><Template Context="t"><span class="ma-ban-ghi">@t.MaTrinhDo</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TrinhDoChuyenMon" Property="TenTrinhDo" Title="Tên trình độ" Width="200px"><Template Context="t"><strong>@t.TenTrinhDo</strong></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TrinhDoChuyenMon" Title="Cán bộ" Width="90px" SortProperty="NhanSus.Count" TextAlign="TextAlign.Center"><Template Context="t">@t.NhanSus.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="TrinhDoChuyenMon" Property="MoTa" Title="Mô tả" />
                <RadzenDataGridColumn TItem="TrinhDoChuyenMon" Property="CoHoatDong" Title="Trạng thái" Width="110px">
                    <Template Context="t"><span class="chip-trang-thai @(t.CoHoatDong ? "tot" : "tat")">@(t.CoHoatDong ? "Đang dùng" : "Ngừng")</span></Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private List<TrinhDoChuyenMon> _tatCa = [];

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = ["TrinhDoChuyenMon"];

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync() => _tatCa = await TrinhDoDichVu.LayDanhSachAsync();
}
