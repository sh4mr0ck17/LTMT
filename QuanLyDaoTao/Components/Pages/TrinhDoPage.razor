@page "/TrinhDoChuyenMon"
@inject ITrinhDoChuyenMonDichVu TrinhDoDichVu

<PageTitle>Trình độ chuyên môn - C500</PageTitle>

<div class="container py-3" id="pnlDanhSachTrinhDo">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-mortarboard me-2"></i>Danh Mục Trình Độ Chuyên Môn (C500)
            </h4>
            <span class="text-muted small">Quản lý danh sách trình độ học vấn, học vị và văn bằng</span>
        </div>
        <a href="TrinhDoChuyenMon/ThemMoi" class="btn btn-primary" id="btnThemTrinhDo">
            <i class="bi bi-plus-circle-fill me-1"></i>Thêm Mới Trình Độ
        </a>
    </div>

    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="dgvDanhSachTrinhDo">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th style="width: 140px;">Mã Trình Độ</th>
                            <th>Tên Trình Độ</th>
                            <th>Mô Tả Tiêu Chuẩn</th>
                            <th class="text-center" style="width: 110px;">Nhân Sự</th>
                            <th class="text-center" style="width: 120px;">Trạng Thái</th>
                            <th class="text-center" style="width: 140px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (danhSachTrinhDo == null || danhSachTrinhDo.Count == 0)
                        {
                            <tr><td colspan="7" class="text-center py-4 text-muted">Không tìm thấy trình độ nào</td></tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var td in danhSachTrinhDo)
                            {
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td><span class="badge bg-primary bg-opacity-10 text-primary font-monospace fs-6">@td.MaTrinhDo</span></td>
                                    <td class="fw-semibold">@td.TenTrinhDo</td>
                                    <td class="text-muted small">@(td.MoTa ?? "-")</td>
                                    <td class="text-center"><span class="badge bg-info text-dark">@(td.NhanSus?.Count ?? 0)</span></td>
                                    <td class="text-center">
                                        <span class="badge @(td.CoHoatDong ? "bg-success" : "bg-secondary")">
                                            @(td.CoHoatDong ? "Hoạt động" : "Khóa")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm">
                                            <a href="TrinhDoChuyenMon/ChinhSua/@td.TrinhDoChuyenMonId" class="btn btn-outline-primary" id="btnSua_@td.TrinhDoChuyenMonId">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button type="button" class="btn btn-outline-danger" id="btnXoa_@td.TrinhDoChuyenMonId" @onclick="() => XoaTrinhDo(td.TrinhDoChuyenMonId)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<TrinhDoChuyenMon>? danhSachTrinhDo;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        danhSachTrinhDo = await TrinhDoDichVu.LayDanhSachAsync();
    }

    private async Task XoaTrinhDo(int id)
    {
        try
        {
            await TrinhDoDichVu.XoaTrinhDoAsync(id);
            await LoadData();
        }
        catch
        {
        }
    }
}
