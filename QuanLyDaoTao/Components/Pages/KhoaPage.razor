@page "/Khoa"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject IKhoaDichVu KhoaDichVu
@inject INhanSuDichVu NhanSuDichVu
@inject NavigationManager DieuHuong

<PageTitle>Khoa | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachKhoa">
    <TieuDeTrang PhanHe="Tổ chức - Cán bộ" TieuDe="Khoa" BieuTuong="bi-bank"
                 MoTa="Khoa quản lý hai nhánh: Bộ môn → Cán bộ giảng viên (tổ chức) và Lớp → Học viên (đào tạo). Lãnh đạo khoa lấy từ chức vụ cán bộ.">
        <a href="Excel/XuatDuLieu?module=Khoa" class="btn btn-outline-primary btn-sm" id="btnXuatExcel"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        @if (NguoiDung.LaQuanTri)
        {
            <a href="QuanTriDuLieu?bang=Khoa" class="btn btn-primary btn-sm" id="btnChinhSuaDuLieu" title="Thêm, sửa, xóa, nhập Excel tại trang Dữ liệu &amp; danh mục"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa dữ liệu</a>
        }
    </TieuDeTrang>

    <div class="the-thong-ke-nho">
        <div><span>Số khoa</span><strong>@_tatCa.Count</strong></div>
        <div><span>Bộ môn</span><strong>@_tatCa.Sum(k => k.BoMons.Count)</strong></div>
        <div><span>Cán bộ</span><strong>@_tatCa.Sum(k => k.NhanSus.Count)</strong></div>
        <div><span>Lớp đào tạo</span><strong>@_tatCa.Sum(k => k.LopHocs.Count)</strong></div>
        <div><span>Khoa thiếu Trưởng khoa</span><strong class="text-warning">@_tatCa.Count(k => LayLanhDao(k.KhoaId, "CV_TK").Count == 0)</strong></div>
    </div>

    <div class="khung-danh-sach">
        <div class="thanh-cong-cu" id="pnlBoLoc">
            <div class="o-tim-kiem">
                <i class="bi bi-search"></i>
                <input class="form-control" id="txtTimKiem" placeholder="Tìm mã, tên khoa, lãnh đạo..." value="@_tuKhoa" @oninput="@(e => _tuKhoa = e.Value?.ToString() ?? string.Empty)" />
            </div>
            <RadzenButton Text="Bỏ lọc" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="@(() => _tuKhoa = string.Empty)" id="btnBoLoc" />
        </div>

        <p class="dem-ket-qua" role="status" id="lblKetQua">Kết quả phù hợp: <strong>@DanhSachHienThi.Count() / @_tatCa.Count</strong></p>

        <RadzenDataGrid TItem="Khoa" Data="@DanhSachHienThi" IsLoading="@DangTai" AllowPaging="true" PageSize="20" AllowSorting="true" AllowColumnResize="true"
                        EmptyText="Không có khoa phù hợp." class="bang-du-lieu" id="dgvDanhSachKhoa">
            <Columns>
                <RadzenDataGridColumn TItem="Khoa" Property="MaKhoa" Title="Mã khoa" Width="120px"><Template Context="k"><span class="ma-ban-ghi">@k.MaKhoa</span></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Property="TenKhoa" Title="Tên khoa" Width="240px"><Template Context="k"><strong>@k.TenKhoa</strong> <NhanBanGhi NgayTao="k.NgayTao" /></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Title="Trưởng khoa" Width="180px" Sortable="false"><Template Context="k">@TenLanhDao(k.KhoaId, "CV_TK")</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Title="Phó trưởng khoa" Width="220px" Sortable="false"><Template Context="k">@TenLanhDao(k.KhoaId, "CV_PK")</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Title="Bộ môn" Width="85px" SortProperty="BoMons.Count" TextAlign="TextAlign.Center"><Template Context="k">@k.BoMons.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Title="Cán bộ" Width="85px" SortProperty="NhanSus.Count" TextAlign="TextAlign.Center"><Template Context="k">@k.NhanSus.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Title="Lớp" Width="70px" SortProperty="LopHocs.Count" TextAlign="TextAlign.Center"><Template Context="k">@k.LopHocs.Count</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Property="Email" Title="Email" Width="180px" />
                <RadzenDataGridColumn TItem="Khoa" Property="CoHoatDong" Title="Trạng thái" Width="105px">
                    <Template Context="k"><span class="chip-trang-thai @(k.CoHoatDong ? "tot" : "tat")">@(k.CoHoatDong ? "Hoạt động" : "Ngừng")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="Khoa" Title="Thao tác" Width="150px" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="k">
                        <div class="o-thao-tac">
                            <RadzenButton Icon="badge" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => DieuHuong.NavigateTo($"NhanSu?khoa={k.KhoaId}"))" title="Cán bộ của khoa" id="@($"btnCanBo_{k.KhoaId}")" />
                            <RadzenButton Icon="groups" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => DieuHuong.NavigateTo($"LopHoc?khoa={k.KhoaId}"))" title="Lớp của khoa" id="@($"btnLop_{k.KhoaId}")" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    </div>
</div>

@code {
    private List<Khoa> _tatCa = [];
    private List<NhanSu> _canBo = [];
    private string _tuKhoa = string.Empty;

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = ["Khoa", "BoMon", "NhanSu", "LopHoc"];

    private IEnumerable<Khoa> DanhSachHienThi => _tatCa.Where(k =>
        QuyTacNghiepVu.ChuaTuKhoa(k.MaKhoa, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(k.TenKhoa, _tuKhoa) ||
        QuyTacNghiepVu.ChuaTuKhoa(TenLanhDao(k.KhoaId, "CV_TK") + " " + TenLanhDao(k.KhoaId, "CV_PK"), _tuKhoa));

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync()
    {
        _tatCa = await KhoaDichVu.LayDanhSachAsync();
        _canBo = await NhanSuDichVu.LayDanhSachAsync(coHoatDong: true);
    }

    private List<NhanSu> LayLanhDao(int khoaId, string maChucVu) =>
        _canBo.Where(ns => ns.KhoaId == khoaId && ns.ChucVu?.MaChucVu == maChucVu).ToList();

    private string TenLanhDao(int khoaId, string maChucVu)
    {
        var danhSach = LayLanhDao(khoaId, maChucVu);
        return danhSach.Count == 0 ? "Chưa phân công" : string.Join(", ", danhSach.Select(ns => ns.HoVaTen));
    }



}
