@page "/Khoa"
@inject IKhoaDichVu KhoaDichVu
@inject IQuanTriDuLieuDichVu QuanTriDuLieuDichVu
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Quản lý Khoa Đào Tạo - Học Viện An Ninh Nhân Dân</PageTitle>

<div class="container-fluid px-4 py-3" id="pnlDanhSachKhoa">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-bank me-2"></i>Quản Lý Khoa Đào Tạo
            </h4>
            <span class="text-muted small">Danh sách các khoa, bộ môn và chỉ tiêu đào tạo trực thuộc C500</span>
        </div>
        <div class="d-flex gap-2">
            <a href="Excel/XuatDuLieu?module=Khoa" class="btn btn-outline-primary" id="btnXuatExcel">
                <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
            </a>
            <AuthorizeView Roles="Superadmin,Admin,DataManager,CanBo">
                <Authorized>
                    <a href="Excel/TaiTepMau?module=Khoa" class="btn btn-outline-secondary" id="btnTaiMauExcel">
                        <i class="bi bi-download me-1"></i>Tải Mẫu Excel
                    </a>
                    <a href="Excel/NhapExcel?module=Khoa" class="btn btn-success" id="btnNhapExcel">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i>Nhập Excel
                    </a>
                    <button type="button" class="btn btn-primary" id="btnThemKhoa" @onclick="ThemKhoaMoi">
                        <i class="bi bi-plus-circle-fill me-1"></i>Thêm Mới Khoa
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4" id="pnlBoLoc">
        <div class="card-body">
            <div class="row g-3 align-items-center" id="frmTimKiem">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="txtTimKiem" 
                               placeholder="Tìm kiếm theo mã khoa, tên khoa..." 
                               @bind="tuKhoa" @bind:event="oninput" @onkeyup="LocDuLieu" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="cboLocTrangThai" @onchange="OnTrangThaiChanged">
                        <option value="">-- Tất cả trạng thái --</option>
                        <option value="true">Đang hoạt động</option>
                        <option value="false">Đã khóa</option>
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button type="button" class="btn btn-primary" id="btnTimKiem" @onclick="LocDuLieu">
                        <i class="bi bi-funnel me-1"></i>Tìm Kiếm
                    </button>
                    <button type="button" class="btn btn-outline-secondary" id="btnLamMoi" @onclick="LamMoi">
                        <i class="bi bi-arrow-clockwise me-1"></i>Làm Mới
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách Khoa -->
    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="dgvDanhSachKhoa">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th style="width: 130px;">Mã Khoa</th>
                            <th>Tên Khoa</th>
                            <th>Số Điện Thoại</th>
                            <th>Email</th>
                            <th>Địa Điểm</th>
                            <th class="text-center" style="width: 90px;">Bộ Môn</th>
                            <th class="text-center" style="width: 90px;">Lớp Học</th>
                            <th class="text-center" style="width: 90px;">Nhân Sự</th>
                            <th class="text-center" style="width: 120px;">Trạng Thái</th>

                            <!-- CÁC CỘT TÙY CHỈNH ĐỘNG TỪ LIVE CRUD STUDIO -->
                            @if (dsTruongTuyChinh != null)
                            {
                                @foreach (var cot in dsTruongTuyChinh)
                                {
                                    <th style="min-width: 120px;">
                                        <span class="text-primary fw-bold"><i class="bi bi-stars text-warning me-1"></i>@cot.TenHienThi</span>
                                    </th>
                                }
                            }

                            <th class="text-center" style="width: 170px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (danhSachHienThi == null || danhSachHienThi.Count == 0)
                        {
                            <tr>
                                <td colspan="@(11 + (dsTruongTuyChinh?.Count ?? 0))" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy khoa nào trong hệ thống
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var khoa in danhSachHienThi)
                            {
                                string pk = khoa.KhoaId.ToString();
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td>
                                        <span class="badge bg-primary bg-opacity-10 text-primary fw-bold font-monospace fs-6">@khoa.MaKhoa</span>
                                    </td>
                                    <td>
                                        <a href="Khoa/ChiTiet/@khoa.KhoaId" class="fw-semibold text-decoration-none text-dark">
                                            @khoa.TenKhoa
                                        </a>
                                        @if (!string.IsNullOrEmpty(khoa.MoTa))
                                        {
                                            <div class="text-muted small text-truncate" style="max-width: 320px;">@khoa.MoTa</div>
                                        }
                                    </td>
                                    <td>@(khoa.SoDienThoai ?? "-")</td>
                                    <td>@(khoa.Email ?? "-")</td>
                                    <td>@(khoa.DiaDiem ?? "-")</td>
                                    <td class="text-center"><span class="badge bg-secondary">@(khoa.BoMons?.Count ?? 0)</span></td>
                                    <td class="text-center"><span class="badge bg-info text-dark">@(khoa.LopHocs?.Count ?? 0)</span></td>
                                    <td class="text-center"><span class="badge bg-success">@(khoa.NhanSus?.Count ?? 0)</span></td>
                                    <td class="text-center">
                                        @if (khoa.CoHoatDong)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-lock me-1"></i>Đã khóa</span>
                                        }
                                    </td>

                                    <!-- HIỂN THỊ VÀ SỬA NHANH CỘT TÙY CHỈNH ĐỘNG -->
                                    @if (dsTruongTuyChinh != null)
                                    {
                                        @foreach (var cot in dsTruongTuyChinh)
                                        {
                                            string val = LayGiaTriCustom(pk, cot.MaTruong);
                                            string fieldKey = "Custom_" + cot.MaTruong;
                                            <td>
                                                @if (editingPk == pk && editingField == fieldKey)
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control form-control-sm"
                                                               value="@val"
                                                               @onchange="(e) => LuuNhanhCustom(pk, cot.MaTruong, e.Value?.ToString())"
                                                               @onblur="() => { editingPk = null; editingField = null; }" autofocus />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <AuthorizeView Roles="Superadmin,Admin,DataManager,CanBo">
                                                        <Authorized>
                                                            <span class="badge bg-light text-dark border p-1 cursor-pointer"
                                                                  @onclick="() => { editingPk = pk; editingField = fieldKey; }"
                                                                  title="Bấm để sửa nhanh trực tiếp">
                                                                @(string.IsNullOrEmpty(val) ? "(Trống)" : val)
                                                                <i class="bi bi-pencil-fill ms-1 text-primary small"></i>
                                                            </span>
                                                        </Authorized>
                                                        <NotAuthorized>
                                                            <span class="badge bg-light text-dark border p-1">@(string.IsNullOrEmpty(val) ? "-" : val)</span>
                                                        </NotAuthorized>
                                                    </AuthorizeView>
                                                }
                                            </td>
                                        }
                                    }

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="Khoa/ChiTiet/@khoa.KhoaId" class="btn btn-outline-primary" title="Xem chi tiết" id="btnXem_@khoa.KhoaId">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <AuthorizeView Roles="Superadmin,Admin,DataManager,CanBo">
                                                <Authorized>
                                                    <a href="Khoa/ChinhSua/@khoa.KhoaId" class="btn btn-outline-primary" title="Chỉnh sửa" id="btnSua_@khoa.KhoaId">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-outline-danger" title="Xóa khoa" id="btnXoa_@khoa.KhoaId"
                                                            @onclick="() => XoaKhoa(khoa.KhoaId, khoa.TenKhoa)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Khoa>? danhSachGoc;
    private List<Khoa>? danhSachHienThi;
    private string tuKhoa = "";
    private bool? coHoatDongLoc = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private List<TruongTuyChinh>? dsTruongTuyChinh;
    private Dictionary<string, Dictionary<string, string>> mapCustomValues = new(StringComparer.OrdinalIgnoreCase);
    private string? editingPk;
    private string? editingField;

    private async Task LoadData()
    {
        danhSachGoc = await KhoaDichVu.LayDanhSachAsync();
        try
        {
            dsTruongTuyChinh = await QuanTriDuLieuDichVu.LayDanhSachTruongTuyChinhAsync("Khoa");
            var duLieuBang = await QuanTriDuLieuDichVu.LayDuLieuBangTrucTuyenAsync("Khoa");
            if (duLieuBang?.DanhSachDong != null)
            {
                foreach (var dong in duLieuBang.DanhSachDong)
                {
                    var pk = dong.TryGetValue("KhoaId", out var pVal) ? pVal ?? "" : "";
                    if (string.IsNullOrEmpty(pk)) continue;
                    if (!mapCustomValues.ContainsKey(pk)) mapCustomValues[pk] = new(StringComparer.OrdinalIgnoreCase);
                    if (dsTruongTuyChinh != null)
                    {
                        foreach (var c in dsTruongTuyChinh)
                        {
                            var keyCustom = "Custom_" + c.MaTruong;
                            var val = dong.TryGetValue(keyCustom, out var v) ? v ?? "" : "";
                            mapCustomValues[pk][c.MaTruong] = val;
                        }
                    }
                }
            }
        }
        catch
        {
        }
        LocDuLieu();
    }

    private string LayGiaTriCustom(string pk, string maTruong)
    {
        if (mapCustomValues.TryGetValue(pk, out var dict) && dict.TryGetValue(maTruong, out var val))
        {
            return val ?? "";
        }
        return "";
    }

    private async Task LuuNhanhCustom(string pk, string maTruong, string? giaTriMoi)
    {
        if (string.IsNullOrWhiteSpace(pk)) return;
        try
        {
            await QuanTriDuLieuDichVu.CapNhatNhanhBanGhiAsync(
                "Khoa",
                pk,
                new Dictionary<string, string?> { ["Custom_" + maTruong] = giaTriMoi },
                "Superadmin Live"
            );
            if (mapCustomValues.TryGetValue(pk, out var dict))
            {
                dict[maTruong] = giaTriMoi ?? "";
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            editingPk = null;
            editingField = null;
        }
    }

    private void LocDuLieu()
    {
        if (danhSachGoc == null) return;
        danhSachHienThi = danhSachGoc.Where(k =>
            (string.IsNullOrWhiteSpace(tuKhoa) ||
             k.MaKhoa.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ||
             k.TenKhoa.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ||
             (mapCustomValues.TryGetValue(k.KhoaId.ToString(), out var cDict) && cDict.Values.Any(v => v != null && v.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase)))) &&
            (!coHoatDongLoc.HasValue || k.CoHoatDong == coHoatDongLoc.Value)
        ).ToList();
    }

    private void OnTrangThaiChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (bool.TryParse(val, out bool b))
        {
            coHoatDongLoc = b;
        }
        else
        {
            coHoatDongLoc = null;
        }
        LocDuLieu();
    }

    private void LamMoi()
    {
        tuKhoa = "";
        coHoatDongLoc = null;
        LocDuLieu();
    }

    private void ThemKhoaMoi()
    {
        Navigation.NavigateTo("Khoa/ThemMoi");
    }

    private async Task XoaKhoa(int id, string ten)
    {
        try
        {
            await KhoaDichVu.XoaKhoaAsync(id);
            await LoadData();
        }
        catch
        {
            // Báo lỗi ràng buộc
        }
    }
}
