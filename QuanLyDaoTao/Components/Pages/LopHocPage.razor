@page "/LopHoc"
@inject ILopHocDichVu LopHocDichVu
@inject IKhoaDichVu KhoaDichVu
@inject IQuanTriDuLieuDichVu QuanTriDuLieuDichVu
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation

<PageTitle>Quản lý Lớp học - Học Viện An Ninh Nhân Dân</PageTitle>

<div class="container-fluid px-4 py-3" id="pnlDanhSachLop">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-1 text-primary fw-bold" id="lblTieuDe">
                <i class="bi bi-people me-2"></i>Quản Lý Lớp Học Đào Tạo
            </h4>
            <span class="text-muted small">Danh sách các lớp học, niên khóa và tỷ lệ lấp đầy sĩ số đào tạo</span>
        </div>
        <div class="d-flex gap-2">
            <a href="Excel/XuatDuLieu?module=LopHoc" class="btn btn-outline-primary" id="btnXuatExcel">
                <i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel
            </a>
            <AuthorizeView Roles="Superadmin,GiaoVien,Admin,DataManager,CanBo">
                <Authorized>
                    <a href="Excel/TaiTepMau?module=LopHoc" class="btn btn-outline-secondary" id="btnTaiMauExcel">
                        <i class="bi bi-download me-1"></i>Tải Mẫu Excel
                    </a>
                    <a href="Excel/NhapExcel?module=LopHoc" class="btn btn-success" id="btnNhapExcel">
                        <i class="bi bi-file-earmark-arrow-up me-1"></i>Nhập Excel
                    </a>
                    <a href="LopHoc/ThemMoi" class="btn btn-primary" id="btnThemLop">
                        <i class="bi bi-plus-circle-fill me-1"></i>Thêm Mới Lớp Học
                    </a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="card shadow-sm border-0 mb-4" id="pnlBoLoc">
        <div class="card-body">
            <div class="row g-3 align-items-center" id="frmTimKiem">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" id="txtTimKiem" 
                               placeholder="Tìm mã hoặc tên lớp..." 
                               value="@tuKhoa" @oninput="OnTimKiemChanged" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="cboChonKhoa" @onchange="OnKhoaChanged">
                        <option value="">-- Tất cả Khoa --</option>
                        @if (danhSachKhoa != null)
                        {
                            @foreach (var k in danhSachKhoa)
                            {
                                <option value="@k.KhoaId">@k.TenKhoa</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" id="cboNienKhoa" @onchange="OnNienKhoaChanged">
                        <option value="">-- Tất cả Niên khóa --</option>
                        @if (danhSachNienKhoa != null)
                        {
                            @foreach (var nk in danhSachNienKhoa)
                            {
                                <option value="@nk">@nk</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="button" class="btn btn-primary w-100" id="btnTimKiem" @onclick="LocDuLieu">Lọc</button>
                    <button type="button" class="btn btn-outline-secondary" id="btnLamMoi" @onclick="LamMoi"><i class="bi bi-arrow-clockwise"></i></button>
                </div>
            </div>
        </div>
    </div>

    <!-- Bảng danh sách Lớp học -->
    <div class="card shadow-sm border-0" id="pnlBangDuLieu">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="dgvDanhSachLop">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3" style="width: 50px;">#</th>
                            <th style="width: 140px;">Mã Lớp</th>
                            <th>Tên Lớp</th>
                            <th>Niên Khóa</th>
                            <th>Khoa Quản Lý</th>
                            <th class="text-center" style="width: 130px;">Học Viên / Sĩ Số</th>
                            <th class="text-center" style="width: 120px;">Trạng Thái</th>

                            <!-- CÁC CỘT TÙY CHỈNH ĐỘNG TỪ LIVE CRUD STUDIO -->
                            @if (dsTruongTuyChinh != null)
                            {
                                @foreach (var cot in dsTruongTuyChinh)
                                {
                                    <th style="min-width: 120px;">
                                        <span class="text-primary fw-bold"><i class="bi bi-stars text-warning me-1"></i>@cot.TenHienThi</span>
                                    </th>
                                }
                            }

                            <th class="text-center" style="width: 160px;">Thao Tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (danhSachHienThi == null || danhSachHienThi.Count == 0)
                        {
                            <tr>
                                <td colspan="@(8 + (dsTruongTuyChinh?.Count ?? 0))" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>Không tìm thấy lớp học nào trong hệ thống
                                </td>
                            </tr>
                        }
                        else
                        {
                            int stt = 1;
                            foreach (var lop in danhSachHienThi)
                            {
                                string pk = lop.LopHocId.ToString();
                                int soHocVien = lop.HocViens?.Count ?? 0;
                                <tr>
                                    <td class="ps-3 fw-bold text-muted">@(stt++)</td>
                                    <td><span class="badge bg-primary bg-opacity-10 text-primary fw-bold font-monospace fs-6">@lop.MaLop</span></td>
                                    <td>
                                        <a href="LopHoc/ChiTiet/@lop.LopHocId" class="fw-semibold text-decoration-none text-dark">@lop.TenLop</a>
                                    </td>
                                    <td><span class="badge bg-light text-dark border">@lop.NienKhoa</span></td>
                                    <td><span class="badge bg-light text-dark border">@(lop.Khoa?.TenKhoa ?? "-")</span></td>
                                    <td class="text-center">
                                        <span class="badge @(soHocVien >= lop.SoLuongToiDa ? "bg-danger" : "bg-success")">
                                            @soHocVien / @lop.SoLuongToiDa
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(lop.CoHoatDong ? "bg-success" : "bg-secondary")">
                                            @(lop.CoHoatDong ? "Hoạt động" : "Đã khóa")
                                        </span>
                                    </td>

                                    <!-- HIỂN THỊ VÀ SỬA NHANH CỘT TÙY CHỈNH ĐỘNG -->
                                    @if (dsTruongTuyChinh != null)
                                    {
                                        @foreach (var cot in dsTruongTuyChinh)
                                        {
                                            string val = LayGiaTriCustom(pk, cot.MaTruong);
                                            string fieldKey = "Custom_" + cot.MaTruong;
                                            <td>
                                                @if (editingPk == pk && editingField == fieldKey)
                                                {
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control form-control-sm"
                                                               value="@val"
                                                               @onchange="(e) => LuuNhanhCustom(pk, cot.MaTruong, e.Value?.ToString())"
                                                               @onblur="() => { editingPk = null; editingField = null; }" autofocus />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <AuthorizeView Roles="Superadmin,GiaoVien,Admin,DataManager,CanBo">
                                                        <Authorized>
                                                            <span class="badge bg-light text-dark border p-1 cursor-pointer"
                                                                  @onclick="() => { editingPk = pk; editingField = fieldKey; }"
                                                                  title="Bấm để sửa nhanh trực tiếp">
                                                                @(string.IsNullOrEmpty(val) ? "(Trống)" : val)
                                                                <i class="bi bi-pencil-fill ms-1 text-primary small"></i>
                                                            </span>
                                                        </Authorized>
                                                        <NotAuthorized>
                                                            <span class="badge bg-light text-dark border p-1">@(string.IsNullOrEmpty(val) ? "-" : val)</span>
                                                        </NotAuthorized>
                                                    </AuthorizeView>
                                                }
                                            </td>
                                        }
                                    }

                                    <td class="text-center">
                                        <div class="btn-group btn-group-sm" role="group">
                                            <a href="LopHoc/ChiTiet/@lop.LopHocId" class="btn btn-outline-primary" title="Xem chi tiết" id="btnXem_@lop.LopHocId">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <AuthorizeView Roles="Superadmin,GiaoVien,Admin,DataManager,CanBo">
                                                <Authorized>
                                                    <a href="LopHoc/ChinhSua/@lop.LopHocId" class="btn btn-outline-primary" title="Chỉnh sửa" id="btnSua_@lop.LopHocId">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-outline-danger" title="Xóa lớp học" id="btnXoa_@lop.LopHocId"
                                                            @onclick="() => XoaLop(lop.LopHocId)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </Authorized>
                                            </AuthorizeView>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    private List<LopHoc>? danhSachGoc;
    private List<LopHoc>? danhSachHienThi;
    private List<Khoa>? danhSachKhoa;
    private List<string>? danhSachNienKhoa;
    private string tuKhoa = "";
    private int? khoaIdLoc = null;
    private string? nienKhoaLoc = null;
    private System.Threading.Timer? _debounceTimer;

    private void OnTimKiemChanged(ChangeEventArgs e)
    {
        tuKhoa = e.Value?.ToString() ?? "";
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                LocDuLieu();
                StateHasChanged();
            });
        }, null, 350, Timeout.Infinite);
    }

    protected override async Task OnInitializedAsync()
    {
        danhSachKhoa = await KhoaDichVu.LayDanhSachAsync();
        danhSachNienKhoa = await LopHocDichVu.LayDanhSachNienKhoaAsync();
        await LoadData();
    }

    private List<TruongTuyChinh>? dsTruongTuyChinh;
    private Dictionary<string, Dictionary<string, string>> mapCustomValues = new(StringComparer.OrdinalIgnoreCase);
    private string? editingPk;
    private string? editingField;

    private async Task LoadData()
    {
        danhSachGoc = await LopHocDichVu.LayDanhSachAsync();
        try
        {
            dsTruongTuyChinh = await QuanTriDuLieuDichVu.LayDanhSachTruongTuyChinhAsync("LopHoc");
            var duLieuBang = await QuanTriDuLieuDichVu.LayDuLieuBangTrucTuyenAsync("LopHoc");
            if (duLieuBang?.DanhSachDong != null)
            {
                foreach (var dong in duLieuBang.DanhSachDong)
                {
                    var pk = dong.TryGetValue("LopHocId", out var pVal) ? pVal ?? "" : "";
                    if (string.IsNullOrEmpty(pk)) continue;
                    if (!mapCustomValues.ContainsKey(pk)) mapCustomValues[pk] = new(StringComparer.OrdinalIgnoreCase);
                    if (dsTruongTuyChinh != null)
                    {
                        foreach (var c in dsTruongTuyChinh)
                        {
                            var keyCustom = "Custom_" + c.MaTruong;
                            var val = dong.TryGetValue(keyCustom, out var v) ? v ?? "" : "";
                            mapCustomValues[pk][c.MaTruong] = val;
                        }
                    }
                }
            }
        }
        catch
        {
        }
        LocDuLieu();
    }

    private string LayGiaTriCustom(string pk, string maTruong)
    {
        if (mapCustomValues.TryGetValue(pk, out var dict) && dict.TryGetValue(maTruong, out var val))
        {
            return val ?? "";
        }
        return "";
    }

    private async Task LuuNhanhCustom(string pk, string maTruong, string? giaTriMoi)
    {
        if (string.IsNullOrWhiteSpace(pk)) return;
        try
        {
            await QuanTriDuLieuDichVu.CapNhatNhanhBanGhiAsync(
                "LopHoc",
                pk,
                new Dictionary<string, string?> { ["Custom_" + maTruong] = giaTriMoi },
                "Superadmin Live"
            );
            if (mapCustomValues.TryGetValue(pk, out var dict))
            {
                dict[maTruong] = giaTriMoi ?? "";
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", ex.Message);
        }
        finally
        {
            editingPk = null;
            editingField = null;
        }
    }

    private void LocDuLieu()
    {
        if (danhSachGoc == null) return;
        danhSachHienThi = danhSachGoc.Where(l =>
            (string.IsNullOrWhiteSpace(tuKhoa) ||
             l.MaLop.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ||
             l.TenLop.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase) ||
             (mapCustomValues.TryGetValue(l.LopHocId.ToString(), out var cDict) && cDict.Values.Any(v => v != null && v.Contains(tuKhoa, StringComparison.OrdinalIgnoreCase)))) &&
            (!khoaIdLoc.HasValue || l.KhoaId == khoaIdLoc.Value) &&
            (string.IsNullOrWhiteSpace(nienKhoaLoc) || l.NienKhoa == nienKhoaLoc)
        ).ToList();
    }

    private void OnKhoaChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (int.TryParse(val, out int kid) && kid > 0)
        {
            khoaIdLoc = kid;
        }
        else
        {
            khoaIdLoc = null;
        }
        LocDuLieu();
    }

    private void OnNienKhoaChanged(ChangeEventArgs e)
    {
        nienKhoaLoc = e.Value?.ToString();
        LocDuLieu();
    }

    private void LamMoi()
    {
        tuKhoa = "";
        khoaIdLoc = null;
        nienKhoaLoc = null;
        LocDuLieu();
    }

    private async Task XoaLop(int id)
    {
        try
        {
            await LopHocDichVu.XoaLopHocAsync(id);
            await LoadData();
        }
        catch
        {
        }
    }
}
