@page "/LopHoc"
@attribute [Authorize]
@inherits TrangNghiepVuCoSo
@inject ILopHocDichVu LopHocDichVu
@inject IKhoaDichVu KhoaDichVu
@inject NavigationManager DieuHuong

<PageTitle>Lớp đào tạo | Quản lý đào tạo C500</PageTitle>

<div class="trang-nghiep-vu" id="pnlDanhSachLop">
    <TieuDeTrang PhanHe="Đào tạo" TieuDe="Lớp đào tạo" BieuTuong="bi-people"
                 MoTa="Lớp thuộc Khoa quản lý, phân loại theo Hệ → Khóa → Chuyên ngành. Sĩ số tính trực tiếp từ hồ sơ học viên.">
        <a href="Excel/XuatDuLieu?module=LopHoc" class="btn btn-outline-primary btn-sm" id="btnXuatExcel"><i class="bi bi-file-earmark-excel me-1"></i>Xuất Excel</a>
        @if (_coQuyenGhiVung)
        {
            <a href="QuanTriDuLieu?bang=LopHoc" class="btn btn-primary btn-sm" id="btnChinhSuaDuLieu" title="Thêm, sửa, xóa, nhập Excel tại trang Dữ liệu &amp; danh mục"><i class="bi bi-pencil-square me-1"></i>Chỉnh sửa dữ liệu</a>
        }
    </TieuDeTrang>

    <div class="the-thong-ke-nho">
        <div><span>Số lớp</span><strong>@_tatCa.Count</strong></div>
        <div><span>Tổng học viên</span><strong>@_tatCa.Sum(l => l.HocViens.Count).ToString("N0")</strong></div>
        <div><span>Lớp đã đầy</span><strong class="text-warning">@_tatCa.Count(l => l.HocViens.Count >= l.SoLuongToiDa)</strong></div>
        <div><span>Số khóa đang quản lý</span><strong>@_tatCa.Select(l => l.KhoaHoc).Where(k => k != null).Distinct().Count()</strong></div>
    </div>

    @* Duyệt từ ngoài vào trong: Niên khóa → Hệ → Lớp → Học viên. Chế độ "Dạng bảng" giữ đủ bộ lọc cho người dùng quen. *@
    <div class="phan-cap-dau">
        <nav class="phan-cap-duong" aria-label="Vị trí đang xem" id="pnlDuongDanDaoTao">
            <button type="button" class="@(_khoaHocLoc is null ? "dang-o" : null)" @onclick="() => DiToiAsync(null, null)" id="btnVeTatCaKhoa">
                <i class="bi bi-calendar3" aria-hidden="true"></i> Tất cả niên khóa
            </button>
            @if (_khoaHocLoc is not null)
            {
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <button type="button" class="dt-nien-khoa @(_heLoc is null ? "dang-o" : null)" @onclick="() => DiToiAsync(_khoaHocLoc, null)">@NhanKhoaHoc(_khoaHocLoc)</button>
            }
            @if (_heLoc is not null)
            {
                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                <span class="dt-he dang-o">Hệ @_heLoc</span>
            }
        </nav>
        <div class="phan-cap-che-do" role="group" aria-label="Kiểu hiển thị">
            <button type="button" class="@(_cheDoBang ? null : "dang-chon")" aria-pressed="@((!_cheDoBang).ToString().ToLowerInvariant())" @onclick="() => _cheDoBang = false" id="btnCheDoPhanCap"><i class="bi bi-diagram-3"></i> Theo cấp</button>
            <button type="button" class="@(_cheDoBang ? "dang-chon" : null)" aria-pressed="@(_cheDoBang.ToString().ToLowerInvariant())" @onclick="() => _cheDoBang = true" id="btnCheDoBang"><i class="bi bi-table"></i> Dạng bảng</button>
        </div>
    </div>


    <div class="khung-danh-sach">
        <div class="thanh-cong-cu" id="pnlBoLoc">
            <div class="o-tim-kiem">
                <i class="bi bi-search"></i>
                <input class="form-control" id="txtTimKiem" placeholder="Tìm mã lớp, tên lớp, hệ, khóa, chuyên ngành..." value="@_tuKhoa" @oninput="DoiTuKhoaAsync" />
            </div>
            <RadzenDropDown TValue="int?" Data="@_danhSachKhoa" TextProperty="TenKhoa" ValueProperty="KhoaId" @bind-Value="_khoaLoc" Change="@(_ => VeTrangDauAsync())"
                            AllowClear="true" AllowFiltering="true" FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive" FilterOperator="StringFilterOperator.Contains" Placeholder="Tất cả khoa" class="bo-loc" id="cboChonKhoa" />
            @if (_cheDoBang)
            {
            <RadzenDropDown TValue="string" Data="@_tatCa.Select(l => l.HeDaoTao).Distinct().Order()" @bind-Value="_heLoc" Change="@(_ => VeTrangDauAsync())" AllowClear="true" Placeholder="Tất cả hệ" class="bo-loc bo-loc-hep" id="cboHeDaoTao" />
            <RadzenDropDown TValue="string" Data="@_tatCa.Where(l => l.KhoaHoc != null).Select(l => l.KhoaHoc!).Distinct().OrderByDescending(k => k)" @bind-Value="_khoaHocLoc" Change="@(_ => VeTrangDauAsync())" AllowClear="true" Placeholder="Tất cả khóa" class="bo-loc bo-loc-hep" id="cboKhoaHoc" />
            }
            <RadzenButton Text="Bỏ lọc" Icon="filter_alt_off" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small" Click="BoLocAsync" id="btnBoLoc" />
        </div>

        @if (!HienBang)
        {
            var cacNhom = _khoaHocLoc is null
                ? NguonPhanCap.GroupBy(TenKhoaHoc).OrderBy(g => g.Key == KhoaHocChuaXacDinh ? 1 : 0).ThenByDescending(g => g.Key, StringComparer.Ordinal).Select(g => (Khoa: g.Key, He: (string?)null, Lop: g.ToList()))
                : NguonPhanCap.Where(l => TenKhoaHoc(l) == _khoaHocLoc).GroupBy(l => l.HeDaoTao).OrderBy(g => g.Key).Select(g => (Khoa: _khoaHocLoc, He: (string?)g.Key, Lop: g.ToList()));
            <div class="luoi-phan-cap" id="pnlPhanCapDaoTao">
                @if (DangTai)
                {
                    <p class="text-muted small">Đang tải…</p>
                }
                @foreach (var nhom in cacNhom)
                {
                    var siSo = nhom.Lop.Sum(l => l.HocViens.Count);
                    var chiTieu = nhom.Lop.Sum(l => l.SoLuongToiDa);
                    var phanTram = chiTieu == 0 ? 0 : (int)Math.Round(siSo * 100.0 / chiTieu);
                    var soVuot = nhom.Lop.Count(l => l.HocViens.Count > l.SoLuongToiDa);
                    var laKhoa = nhom.He is null;
                    var nienKhoa = nhom.Lop.Select(l => l.NienKhoa).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().FirstOrDefault();
                    <button type="button" class="the-phan-cap @(laKhoa ? "dt-nien-khoa" : "dt-he")" @onclick="() => DiToiAsync(nhom.Khoa, nhom.He)"
                            id="@($"btnPhanCap_{(laKhoa ? nhom.Khoa : nhom.He)}")">
                        <span class="the-phan-cap-dau">
                            <span class="dt-o-bieu-tuong"><i class="bi @(laKhoa ? "bi-calendar3" : "bi-mortarboard")" aria-hidden="true"></i></span>
                            <span>
                                <span class="the-phan-cap-loai">@(laKhoa ? "Niên khóa" : "Hệ đào tạo")</span>
                                <strong>@(laKhoa ? NhanKhoaHoc(nhom.Khoa!) : nhom.He)</strong>
                                @if (laKhoa && nienKhoa is not null) { <span class="the-phan-cap-phu">@nienKhoa</span> }
                            </span>
                            <i class="bi bi-chevron-right ms-auto" aria-hidden="true"></i>
                        </span>
                        <span class="the-phan-cap-so">
                            @if (laKhoa) { <span><strong>@nhom.Lop.Select(l => l.HeDaoTao).Distinct().Count()</strong> hệ</span> }
                            <span class="dt-lop"><strong class="dt-chu">@nhom.Lop.Count</strong> lớp</span>
                            <span class="dt-hoc-vien"><strong class="dt-chu">@siSo.ToString("N0")</strong> học viên</span>
                        </span>
                        <span class="the-phan-cap-thanh @(phanTram > 100 ? "tt-nguy" : phanTram >= 90 ? "tt-canh-bao" : "tt-tot")" title="@($"{siSo}/{chiTieu} chỉ tiêu")">
                            <span style="width: @(Math.Min(100, phanTram))%"></span>
                        </span>
                        <span class="the-phan-cap-chan">
                            <span>Lấp đầy @phanTram% chỉ tiêu</span>
                            @if (soVuot > 0) { <span class="dt-chip tt-nguy">@soVuot lớp vượt</span> }
                            @if (nhom.Khoa == KhoaHocChuaXacDinh) { <span class="dt-chip tt-canh-bao">Cần khai báo khóa</span> }
                        </span>
                    </button>
                }
                @if (!DangTai && !cacNhom.Any())
                {
                    <p class="text-muted small">Chưa có lớp nào.</p>
                }
            </div>
        }
        <div class="@(HienBang ? null : "d-none")">
        <p class="dem-ket-qua" role="status" id="lblKetQua">Kết quả phù hợp: <strong>@DanhSachHienThi.Count() / @_tatCa.Count</strong></p>

        <RadzenDataGrid @ref="_bang" TItem="LopHoc" Data="@DanhSachHienThi" IsLoading="@DangTai" AllowPaging="true" PageSize="20" ShowPagingSummary="true"
                        PagingSummaryFormat="Trang {0}/{1} · {2} lớp" AllowSorting="true" AllowColumnResize="true" EmptyText="Không có lớp phù hợp." class="bang-du-lieu" id="dgvDanhSachLop">
            <Columns>
                <RadzenDataGridColumn TItem="LopHoc" Title="STT" Width="60px" Sortable="false" TextAlign="TextAlign.Center"><Template Context="l">@((_bang?.View.ToList().IndexOf(l) ?? -1) + 1)</Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LopHoc" Property="MaLop" Title="Mã lớp" Width="110px"><Template Context="l"><span class="ma-ban-ghi">@l.MaLop</span> <NhanBanGhi NgayTao="l.NgayTao" NgayCapNhat="l.NgayCapNhat" /></Template></RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LopHoc" Property="TenLop" Title="Tên lớp" Width="210px" />
                <RadzenDataGridColumn TItem="LopHoc" Property="HeDaoTao" Title="Hệ" Width="100px" />
                <RadzenDataGridColumn TItem="LopHoc" Property="KhoaHoc" Title="Khóa" Width="75px" />
                <RadzenDataGridColumn TItem="LopHoc" Property="ChuyenNganh" Title="Chuyên ngành" Width="210px" />
                <RadzenDataGridColumn TItem="LopHoc" Property="Khoa.TenKhoa" Title="Khoa quản lý" Width="190px" />
                <RadzenDataGridColumn TItem="LopHoc" Property="NienKhoa" Title="Niên khóa" Width="100px" />
                <RadzenDataGridColumn TItem="LopHoc" Title="Sĩ số" Width="150px" SortProperty="HocViens.Count">
                    <Template Context="l">
                        @{ var tiLe = l.SoLuongToiDa == 0 ? 0 : Math.Min(100, l.HocViens.Count * 100 / l.SoLuongToiDa); }
                        <div class="d-flex align-items-center gap-2">
                            <RadzenProgressBar Value="@tiLe" ShowValue="false" Style="height:6px;flex:1" ProgressBarStyle="@(tiLe >= 100 ? ProgressBarStyle.Warning : ProgressBarStyle.Success)" />
                            <span class="small" style="font-variant-numeric:tabular-nums">@l.HocViens.Count/@l.SoLuongToiDa</span>
                        </div>
                    </Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LopHoc" Property="CoHoatDong" Title="Trạng thái" Width="105px">
                    <Template Context="l"><span class="chip-trang-thai @(l.CoHoatDong ? "tot" : "tat")">@(l.CoHoatDong ? "Hoạt động" : "Đã khóa")</span></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="LopHoc" Title="Thao tác" Width="125px" Sortable="false" TextAlign="TextAlign.Center" Frozen="true" FrozenPosition="FrozenColumnPosition.Right">
                    <Template Context="l">
                        <div class="o-thao-tac">
                            <RadzenButton Icon="groups" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.ExtraSmall" Click="@(() => DieuHuong.NavigateTo($"HocVien?lop={l.LopHocId}"))" title="Danh sách học viên" id="@($"btnHocVien_{l.LopHocId}")" />
                        </div>
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
        </div>
    </div>
</div>

@code {
    private RadzenDataGrid<LopHoc>? _bang;
    private List<LopHoc> _tatCa = [];
    private List<Khoa> _danhSachKhoa = [];
    private string _tuKhoa = string.Empty;
    private int? _khoaLoc;
    private string? _heLoc;
    private string? _khoaHocLoc;
    private bool _coQuyenGhiVung;
    private bool _cheDoBang;

    /// <summary>Khóa ảo cho các lớp chưa khai báo khóa học.</summary>
    private const string KhoaHocChuaXacDinh = "(chưa xác định)";

    private static string TenKhoaHoc(LopHoc l) => string.IsNullOrWhiteSpace(l.KhoaHoc) ? KhoaHocChuaXacDinh : l.KhoaHoc;

    private static string NhanKhoaHoc(string khoaHoc) => khoaHoc == KhoaHocChuaXacDinh ? "Chưa xác định khóa" : $"Khóa {khoaHoc}";

    /// <summary>Bảng lớp hiện khi đã chọn tới cấp Hệ, khi đang tìm kiếm, hoặc khi chọn chế độ "Dạng bảng".</summary>
    private bool HienBang => _cheDoBang || (_khoaHocLoc is not null && _heLoc is not null) || !string.IsNullOrWhiteSpace(_tuKhoa);

    /// <summary>Nguồn cho thẻ phân cấp: tôn trọng bộ lọc khoa quản lý.</summary>
    private IEnumerable<LopHoc> NguonPhanCap => _tatCa.Where(l => _khoaLoc is null || l.KhoaId == _khoaLoc);

    /// <summary>Lọc sẵn theo khoa khi mở từ trang Khoa (?khoa=ID).</summary>
    [SupplyParameterFromQuery(Name = "khoa")]
    public int? KhoaTuDuongDan { get; set; }

    /// <inheritdoc />
    protected override IReadOnlyCollection<string> BangTheoDoi { get; } = ["LopHoc", "HocVien", "Khoa"];

    /// <inheritdoc />
    protected override void OnParametersSet()
    {
        if (KhoaTuDuongDan.HasValue)
        {
            _khoaLoc = KhoaTuDuongDan;
        }
    }

    private IEnumerable<LopHoc> DanhSachHienThi => _tatCa.Where(l =>
        (_khoaLoc is null || l.KhoaId == _khoaLoc) && (_heLoc is null || l.HeDaoTao == _heLoc) && (_khoaHocLoc is null || TenKhoaHoc(l) == _khoaHocLoc) &&
        (QuyTacNghiepVu.ChuaTuKhoa(l.MaLop, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(l.TenLop, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(l.HeDaoTao, _tuKhoa) ||
         QuyTacNghiepVu.ChuaTuKhoa(l.KhoaHoc, _tuKhoa) || QuyTacNghiepVu.ChuaTuKhoa(l.ChuyenNganh, _tuKhoa)));

    /// <inheritdoc />
    protected override async Task TaiDuLieuAsync()
    {
        _danhSachKhoa = await KhoaDichVu.LayDanhSachAsync();
        // Sắp theo khóa mới nhất, rồi số thứ tự lớp tự nhiên (B2 trước B10).
        _tatCa = (await LopHocDichVu.LayDanhSachAsync())
            .OrderByDescending(l => l.KhoaHoc)
            .ThenBy(l => l.MaLop.Length)
            .ThenBy(l => l.MaLop, StringComparer.Ordinal)
            .ToList();
        _coQuyenGhiVung = NguoiDung.LaQuanTri || (NguoiDung.VaiTro == VaiTroMacDinh.QuanLy && NguoiDung.VungQuanLy == VungQuanLy.DaoTao);
    }

    private IReadOnlyList<Khoa> KhoaDuocGhi => _danhSachKhoa.Where(k => NguoiDung.CoQuyenGhi(VungQuanLy.DaoTao, k.KhoaId)).ToList();

    private IReadOnlyList<string> ChuyenNganhGoiY => _tatCa.Where(l => l.ChuyenNganh != null).Select(l => l.ChuyenNganh!).Distinct().Order().ToList();

    private async Task DoiTuKhoaAsync(ChangeEventArgs e)
    {
        _tuKhoa = e.Value?.ToString() ?? string.Empty;
        await VeTrangDauAsync();
    }

    private async Task BoLocAsync()
    {
        _tuKhoa = string.Empty;
        _khoaLoc = null;
        _heLoc = null;
        _khoaHocLoc = null;
        await VeTrangDauAsync();
    }

    private async Task DiToiAsync(string? khoaHoc, string? he)
    {
        _khoaHocLoc = khoaHoc;
        _heLoc = he;
        _tuKhoa = string.Empty;
        await VeTrangDauAsync();
    }

    private async Task VeTrangDauAsync()
    {
        if (_bang is not null)
        {
            await _bang.FirstPage(true);
        }
    }



}
